<template>
	<view class="status-bar-container w-full">
		<view
			v-for="(item, index) in items"
			:key="index"
			class="flex flex-row items-center justify-between mb-0.5"
		>
			<view class="flex-1">
				<view class="relative w-full">
					<cl-text
						:size="12"
						color="white"
						:class="'absolute z-20'"
						:style="{ left: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
						>{{ item.name }}</cl-text
					>
					<cl-text
						:size="12"
						color="#666666"
						:class="'absolute z-20'"
						:style="{ right: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
						>{{ item.rightText ?? item.percentage + "%" }}</cl-text
					>
					<cl-progress
						:value="100"
						:color="item.color ?? defaultColors[index % defaultColors.length]"
						:show-text="false"
						:stroke-width="20"
						:pt="{
							className: 'opacity-15'
						}"
					></cl-progress>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="ts" setup>
type StatusItem = {
	name: string;
	color?: string;
	percentage: number;
	rightText?: string;
};

const defaultColors = ["#FF0040", "#00D9FF", "#0066FF", "#B700FF", "#FFE100", "#00FF80"];

defineProps<{
	items: StatusItem[];
}>();
</script>
