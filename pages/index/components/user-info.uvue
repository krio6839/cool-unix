<template>
	<view class="relative mb-4 mr--3 w-full h-60 rounded-xl p-4">
		<image src="/static/icon/arrow-bg.svg" class="absolute right-0 top-16 w-60 h-24"></image>
		<image src="/static/icon/user-avatar.svg" class="absolute right-6 top-0 w-40"></image>
		<view class="absolute left-1 top-12">
			<view class="flex flex-col justify-center items-start">
				<text class="text-lg font-bold text-white" @tap="handleNameClick">{{
					currentTrainingState.userInfo.name
				}}</text>
				<text class="text-xs opacity-80 mr-4 my-3 text-white">
					上次登录时间:
					{{ currentTrainingState.userInfo.lastLoginTime }}
				</text>
				<cl-switch></cl-switch>
			</view>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { computed } from "vue";
import { useStore } from "@/.cool";

const { user } = useStore();

// 获取当前训练状态
const currentTrainingState = computed(() => user.getCurrentTrainingState());

// 切换训练状态
function handleNameClick() {
	user.switchTrainingState();
}
</script>

<style lang="scss"></style>
