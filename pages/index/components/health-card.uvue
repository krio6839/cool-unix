<template>
	<cl-row :gutter="12">
		<cl-col :span="12" v-for="(item, index) in healthData" :key="index">
			<view
				class="health-card h-[105px] rounded-2xl border border-[#25261f] p-[15px] flex flex-col justify-between relative mb-3"
				@tap="goToMetrics(item.title)"
			>
				<text class="text-sm text-[#6b7280] opacity-60">{{ item.title }}</text>
				<view class="flex flex-row items-center">
					<text class="mr-1 text-2xl font-bold text-white">{{ item.value }}</text>
					<text class="text-sm text-[#9ca3af]">{{ item.unit }}</text>
				</view>
				<text class="text-xs text-[#6b7280]">{{
					getChangeText(item.title, item.change)
				}}</text>
				<cl-svg
					class="absolute w-[30px] h-[30px] bottom-5 right-[15px]"
					:src="item.icon"
				></cl-svg>
			</view>
		</cl-col>
	</cl-row>
</template>

<script lang="ts" setup>
import { bluetoothDataManager, router, useStore } from "@/.cool";
import { computed, onMounted, ref, watch } from "vue";
import type { HealthCardItem, HealthCardValues } from "@/.cool";

const { realtime } = useStore();

const values = computed<HealthCardValues>(() => {
	return realtime.healthCardValues.value as HealthCardValues;
});

async function refreshRealtimeFromDb(): Promise<void> {
	const record = await bluetoothDataManager.getLatestRealtimeBroadcastRecord();
	if (record == null) {
		return;
	}
	realtime.setBroadcastRecord(record);
}

const lastHealthData = ref<HealthCardValues>({
	heartRate: null,
	restingHeartRate: null,
	oxygen: null,
	hrv: null
});
const previousValues = ref<HealthCardValues | null>(null);

watch(
	values,
	(newData: HealthCardValues) => {
		if (newData != null && previousValues.value != null) {
			if (newData.heartRate !== previousValues.value.heartRate) {
				lastHealthData.value.heartRate = previousValues.value.heartRate;
			}
			if (newData.restingHeartRate !== previousValues.value.restingHeartRate) {
				lastHealthData.value.restingHeartRate = previousValues.value.restingHeartRate;
			}
			if (newData.oxygen !== previousValues.value.oxygen) {
				lastHealthData.value.oxygen = previousValues.value.oxygen;
			}
			if (newData.hrv !== previousValues.value.hrv) {
				lastHealthData.value.hrv = previousValues.value.hrv;
			}
		}
		previousValues.value = {
			heartRate: newData.heartRate,
			restingHeartRate: newData.restingHeartRate,
			oxygen: newData.oxygen,
			hrv: newData.hrv
		} as HealthCardValues;
	},
	{ immediate: true }
);

onMounted(() => {
	refreshRealtimeFromDb();
});

const healthData = computed<HealthCardItem[]>(() => {
	const current = values.value as HealthCardValues;
	const last = lastHealthData.value;

	const items: HealthCardItem[] = [];

	const heartRate = current.heartRate;
	const lastHeartRate = (last.heartRate ?? heartRate ?? 0) as number;
	items.push({
		title: "心率",
		value: heartRate == null ? "-" : heartRate,
		unit: "bpm",
		change: heartRate == null ? 0 : heartRate - lastHeartRate,
		icon: "/static/icon/health/heart-rate.svg"
	});

	const restingHeartRateVal = current.restingHeartRate;
	const lastRestingHeartRateVal = (last.restingHeartRate ?? restingHeartRateVal ?? 0) as number;
	items.push({
		title: "静息心率",
		value: restingHeartRateVal == null ? "-" : restingHeartRateVal,
		unit: "bpm",
		change: restingHeartRateVal == null ? 0 : restingHeartRateVal - lastRestingHeartRateVal,
		icon: "/static/icon/health/heart-rate.svg"
	});

	const oxygen = current.oxygen;
	const lastOxygen = (last.oxygen ?? oxygen ?? 0) as number;
	items.push({
		title: "血氧",
		value: oxygen == null ? "-" : oxygen,
		unit: "%",
		change: oxygen == null ? 0 : oxygen - lastOxygen,
		icon: "/static/icon/health/spo2.svg"
	});

	const hrv = current.hrv;
	const lastHrv = (last.hrv ?? hrv ?? 0) as number;
	items.push({
		title: "心率变异性",
		value: hrv == null ? "-" : hrv,
		unit: "ms",
		change: hrv == null ? 0 : hrv - lastHrv,
		icon: "/static/icon/health/hrv.svg"
	});

	return items;
});

const getChangeText = (title: string, change: number) => {
	if (change === 0) {
		return "";
	}
	const prefix = change > 0 ? "+" : "";
	const valueText = title == "血氧" ? change.toFixed(1) : change.toString();
	return `较上次 ${prefix}${valueText}`;
};

function goToMetrics(title: string) {
	let metric = "heartRate";
	switch (title) {
		case "心率":
			metric = "heartRate";
			break;
		case "静息心率":
			metric = "restingHeartRate";
			break;
		case "血氧":
			metric = "bloodOxygen";
			break;
		case "心率变异性":
			metric = "hrv";
			break;
	}
	router.push({
		path: `/pages/health/metrics?metric=${metric}`
	});
}
</script>

<style lang="scss" scoped>
.health-card {
	background-image: linear-gradient(to left, #1a1a16, #060702);
}
</style>
