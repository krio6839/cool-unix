<template>
	<view class="health-status w-full h-20 mb-4 p-4 shadow-md">
		<view class="flex flex-row items-center justify-around h-full">
			<template v-for="(item, index) in healthItems" :key="index">
				<view v-if="index != 0" class="divider"></view>
				<view
					class="p-2 flex flex-col items-center flex-1"
					@tap="handleItemClick(item.label)"
				>
					<cl-text :size="13" :pt="{ className: 'label-text' }">{{ item.label }}</cl-text>
					<view class="flex flex-row items-center mt-1">
						<cl-text :size="17" :pt="{ className: 'value-text' }">
							{{ item.value }}
						</cl-text>
						<cl-icon
							v-if="item.trend"
							:name="getTrendIcon(item.trend)"
							:color="getTrendColor(item.trend)"
							:size="12"
						></cl-icon>
					</view>
				</view>
			</template>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { router } from "@/.cool";
import { computed } from "vue";
import type { HealthItem, HealthStatus } from "@/.cool";

type Props = {
	data: HealthStatus;
};

const props = defineProps<Props>();

// 计算健康项目列表
const healthItems = computed(() => {
	const data = props.data as HealthStatus;
	const item1: HealthItem = {
		label: "状态",
		value: data.status
	};
	const item2: HealthItem = {
		label: "睡眠",
		value: data.sleep
	};
	const item3: HealthItem = {
		label: "负荷",
		value: data.load
	};
	if (data.statusTrend != null) {
		item1.trend = data.statusTrend;
	}
	if (data.sleepTrend != null) {
		item2.trend = data.sleepTrend;
	}
	if (data.loadTrend != null) {
		item3.trend = data.loadTrend;
	}
	return [item1, item2, item3];
});

// 辅助函数：获取趋势图标
function getTrendIcon(trend?: "up" | "down"): string {
	return trend === "up" ? "arrow-up-line" : "arrow-down-line";
}

// 辅助函数：获取趋势颜色
function getTrendColor(trend?: "up" | "down"): string {
	return trend === "up" ? "#4CAF50" : "#FF5252";
}

// 处理点击事件
function handleItemClick(label: string) {
	if (label === "负荷") {
		router.push({
			path: "/pages/health/load"
		});
	} else if (label === "睡眠") {
		router.push({
			path: "/pages/health/sleep"
		});
	} else if (label === "状态") {
		router.push({
			path: "/pages/health/status"
		});
	}
}
</script>

<style lang="scss" scoped>
.health-status {
	background-image: linear-gradient(to right, rgba(50, 57, 65, 0.85), rgba(73, 77, 88, 0.85));
	border-radius: 16px;
	/* #ifndef APP-ANDROID */
	backdrop-filter: blur(30px);
	/* #endif */
	/* #ifdef APP-ANDROID */
	overflow: hidden;
	position: relative;
	/* #endif */
}

.label-text {
	font-family:
		PingFang SC,
		PingFang SC;
	font-weight: bold;
	color: #ffffff;
	text-align: left;
	font-style: normal;
	opacity: 0.6;
}

.value-text {
	font-family: Manrope, Manrope;
	font-weight: bold;
	color: #ffffff;
	line-height: 22px;
	text-align: right;
	font-style: normal;
}

.divider {
	width: 1px;
	height: 50px;
	border-radius: 0px;
	border: 1px solid #ffffff;
	opacity: 0.1;
}
</style>
