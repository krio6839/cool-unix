<template>
	<view class="health-status w-full h-20 mb-4 p-4 shadow-md">
		<view class="flex flex-row items-center justify-around h-full">
			<template v-for="(item, index) in healthItems" :key="index">
				<view
					v-if="index != 0"
					class="w-[1px] h-[50px] rounded-none opacity-10 border border-white/10"
				></view>
				<view
					class="p-2 flex flex-col items-center flex-1"
					@tap="handleItemClick(item.label)"
				>
					<cl-text :size="13" :pt="{ className: 'font-bold text-white opacity-60' }">{{
						item.label
					}}</cl-text>
					<view class="flex flex-row items-center mt-1">
						<cl-text :size="17" :pt="{ className: 'font-bold text-white' }">
							{{ item.value }}
						</cl-text>
						<cl-icon
							v-if="item.trend"
							:name="getTrendIcon(item.trend)"
							:color="getTrendColor(item.trend)"
							:size="12"
						></cl-icon>
					</view>
				</view>
			</template>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { router, useStore } from "@/.cool";
import { computed, ref, watch, type PropType } from "vue";
import type { HealthItem, HealthStatus } from "@/.cool";

const { home } = useStore();

const lastData = ref<HealthStatus | null>(null);
const previousData = ref<HealthStatus | null>(null);

const data = computed<HealthStatus | null>(() => {
	return home.healthStatus.value as HealthStatus | null;
});

const update = () => {
	const currentData = data.value;
	if (currentData != null && previousData.value != null) {
		const currentLastData = lastData.value;
		const currentDataStatus = currentData.status;
		const currentDataSleep = currentData.sleep;
		const currentDataLoad = currentData.load;
		if (currentDataStatus !== previousData.value.status) {
			lastData.value = {
				status: previousData.value.status,
				sleep: currentLastData?.sleep ?? currentDataSleep,
				load: currentLastData?.load ?? currentDataLoad
			} as HealthStatus;
		}
		if (currentDataSleep !== previousData.value.sleep) {
			lastData.value = {
				status: currentLastData?.status ?? currentDataStatus,
				sleep: previousData.value.sleep,
				load: currentLastData?.load ?? currentDataLoad
			} as HealthStatus;
		}
		if (currentDataLoad !== previousData.value.load) {
			lastData.value = {
				status: currentLastData?.status ?? currentDataStatus,
				sleep: currentLastData?.sleep ?? currentDataSleep,
				load: previousData.value.load
			} as HealthStatus;
		}
	}
	if (currentData != null) {
		previousData.value = {
			status: currentData.status,
			sleep: currentData.sleep,
			load: currentData.load
		} as HealthStatus;
	}
};

// 计算健康项目列表
const healthItems = computed(() => {
	const last = lastData.value;

	const item1: HealthItem = {
		label: "状态",
		value: data.value?.status ?? 0
	};
	const item2: HealthItem = {
		label: "睡眠",
		value: data.value?.sleep ?? 0
	};
	const item3: HealthItem = {
		label: "负荷",
		value: data.value?.load ?? 0
	};

	if (last != null && data.value != null) {
		const lastStatus = last.status ?? data.value.status ?? 0;
		const currentStatus = data.value?.status;
		if (currentStatus != null && currentStatus > lastStatus) {
			item1.trend = "up";
		} else if (currentStatus != null && currentStatus < lastStatus) {
			item1.trend = "down";
		}

		const lastSleep = last.sleep ?? data.value.sleep ?? 0;
		if (data.value.sleep > lastSleep) {
			item2.trend = "up";
		} else if (data.value.sleep < lastSleep) {
			item2.trend = "down";
		}

		const lastLoad = last.load ?? data.value.load ?? 0;
		if (data.value.load > lastLoad) {
			item3.trend = "up";
		} else if (data.value.load < lastLoad) {
			item3.trend = "down";
		}
	}

	return [item1, item2, item3];
});

// 辅助函数：获取趋势图标
function getTrendIcon(trend?: "up" | "down"): string {
	return trend === "up" ? "arrow-up-line" : "arrow-down-line";
}

// 辅助函数：获取趋势颜色
function getTrendColor(trend?: "up" | "down"): string {
	return trend === "up" ? "#4CAF50" : "#FF5252";
}

// 处理点击事件
function handleItemClick(label: string) {
	if (label === "负荷") {
		router.push({
			path: "/pages/health/load"
		});
	} else if (label === "睡眠") {
		router.push({
			path: "/pages/health/sleep"
		});
	} else if (label === "状态") {
		router.push({
			path: "/pages/health/status"
		});
	}
}

watch(data, () => update(), { immediate: true });
</script>

<style lang="scss" scoped>
.health-status {
	background-image: linear-gradient(to right, rgba(50, 57, 65, 0.85), rgba(73, 77, 88, 0.85));
	border-radius: 16px;
	/* #ifndef APP-ANDROID */
	backdrop-filter: blur(30px);
	/* #endif */
	/* #ifdef APP-ANDROID */
	overflow: hidden;
	position: relative;
	/* #endif */
}
</style>
