<template>
	<cl-popup v-model="show" :title="t('数据诊断')" direction="bottom" :size="680">
		<scroll-view class="p-4 db-popup" scroll-y="true" style="height: 100%">
			<view class="diagnostic-tabs">
				<cl-button type="light" size="small" @tap="tab = 'database'">数据库</cl-button>
				<cl-button type="light" size="small" @tap="tab = 'protocol'">协议日志</cl-button>
				<cl-button type="light" size="small" @tap="tab = 'diagnostic'">诊断日志</cl-button>
			</view>
			<view v-if="tab != 'database'" class="log-card">
				<view class="log-toolbar">
					<cl-button
						v-if="tab == 'diagnostic'"
						type="light"
						size="small"
						@tap="loadDiagnosticLogs"
						>刷新诊断日志</cl-button
					>
					<cl-button type="primary" color="#2563eb" size="small" @tap="copyVisibleLogs">
						复制当前日志
					</cl-button>
					<cl-button type="primary" color="#0f766e" size="small" @tap="exportVisibleLogs">
						导出当前日志
					</cl-button>
				</view>
				<text
					v-for="(line, i) in tab == 'protocol' ? protocolLogs : diagnosticRows"
					:key="i"
					>{{ line }}</text
				>
				<text v-if="(tab == 'protocol' ? protocolLogs : diagnosticRows).length == 0"
					>暂无日志</text
				>
			</view>
			<view v-if="tab == 'database'">
				<view class="mb-4 p-3 bg-gray-800 rounded">
					<view class="flex flex-row flex-wrap">
						<cl-button
							type="primary"
							color="#256"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadOverview"
						>
							{{ t("总览") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#256"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadBroadcastRows"
						>
							{{ t("最近广播") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#265"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadPpiRows"
						>
							{{ t("最近PPI") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#526"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadUploadQueues"
						>
							{{ t("待上传") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#725"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadUploadAudit"
						>
							{{ t("上传核验") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#275"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadUploadedRows"
						>
							{{ t("最近已上传") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#742"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadUnuploadedRows"
						>
							{{ t("最近未上传") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#347"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="loadSleepRows"
						>
							{{ t("最近睡眠") }}
						</cl-button>
						<cl-button
							type="light"
							rounded
							size="small"
							class="mr-2 mb-2"
							@tap="clearRows"
						>
							{{ t("清空") }}
						</cl-button>
					</view>
					<cl-text color="gray-400" :size="12">
						{{ t("只查询，不清库不上传。列表最多显示 10 条，uploaded=1 表示已上传。") }}
					</cl-text>
				</view>

				<view class="mb-4 p-3 bg-gray-800 rounded">
					<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
						{{ t("重新上传睡眠") }}
					</cl-text>
					<view class="flex flex-row flex-wrap">
						<cl-button
							v-for="count in [1, 2, 3]"
							:key="count"
							type="primary"
							color="#526"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="reuploadSleep(count)"
						>
							{{ t("上传") }} {{ count }} {{ t("条") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#526"
							rounded
							size="small"
							class="mr-2 mb-2"
							:disabled="loading"
							@tap="reuploadSleepCustom"
						>
							{{ t("自定义") }}
						</cl-button>
					</view>
					<cl-text color="gray-400" :size="12">
						{{ t("按最近的已上传睡眠记录重新发送，不修改上传状态。") }}
					</cl-text>
				</view>

				<view class="mb-3 p-3 bg-gray-800 rounded">
					<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
						{{ titleText }}
					</cl-text>
					<view v-if="rows.length == 0" class="py-4">
						<cl-text color="gray-400" :size="13">{{ t("暂无查询结果") }}</cl-text>
					</view>
					<view v-for="(row, index) in rows" :key="index" class="db-row">
						<text class="db-row-index">#{{ index + 1 }}</text>
						<text class="db-row-text">{{ row }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</cl-popup>
</template>

<script lang="ts" setup>
//#ifndef H5
import { computed, ref, watch } from "vue";
import { bluetoothDataManager, diagnostics, t } from "@/.cool";
import type {
	PpiData,
	RealtimeBroadcastRecord,
	SleepData,
	UploadTableStats,
	HistorySessionDiagnostics
} from "@/.cool";
import type { DataDiagnosticsPopupProps } from "./types";
import { saveCsvToDownloads } from "@/uni_modules/boom-csv-saver";

const show = defineModel("show", {
	default: false
});
const props = defineProps<DataDiagnosticsPopupProps>();
const protocolLogs = computed<string[]>((): string[] => {
	const value = props.protocolLogs;
	if (value == null) return [];
	return value;
});
const diagnosticLogs = computed<string[]>((): string[] => {
	const value = props.diagnosticLogs;
	if (value == null) return [];
	return value;
});
const diagnosticRows = ref<string[]>(diagnosticLogs.value);
const tab = ref<"database" | "protocol" | "diagnostic">("database");

function visibleLogLines(): string[] {
	return tab.value == "protocol" ? protocolLogs.value : diagnosticRows.value;
}

function visibleLogText(): string {
	return visibleLogLines().join("\n");
}

function copyVisibleLogs(): void {
	const text = visibleLogText();
	if (text.length == 0) {
		uni.showToast({ title: t("暂无日志"), icon: "none" });
		return;
	}
	uni.setClipboardData({
		data: text,
		success: () => {
			uni.showToast({ title: t("已复制当前日志"), icon: "success" });
		}
	});
}

function exportVisibleLogs(): void {
	const text = visibleLogText();
	if (text.length == 0) {
		uni.showToast({ title: t("暂无日志"), icon: "none" });
		return;
	}
	const prefix = tab.value == "protocol" ? "protocol-log" : "diagnostic-log";
	const stamp = new Date().toISOString().replace(/[:.]/g, "-");
	try {
		const path = saveCsvToDownloads(`${prefix}-${stamp}.txt`, text);
		uni.showToast({ title: `${t("已导出")}: ${path}`, icon: "success" });
	} catch (e) {
		uni.showToast({ title: `${t("导出失败")}: ${e}`, icon: "none" });
	}
}

async function loadDiagnosticLogs(): Promise<void> {
	diagnosticRows.value = await diagnostics.getLogsAsync(200);
}
watch(show, (visible: boolean) => {
	if (visible) void loadDiagnosticLogs();
});

const loading = ref<boolean>(false);
const titleText = ref<string>("-");
const rows = ref<string[]>([]);

function formatSecTime(sec: number): string {
	if (sec <= 0) return "0";
	return `${sec} ${new Date(sec * 1000).toLocaleString()}`;
}

function formatMsTime(ms: number): string {
	if (ms <= 0) return "0";
	return `${ms} ${new Date(ms).toLocaleString()}`;
}

function setLoading(title: string): boolean {
	if (loading.value == true) return false;
	loading.value = true;
	titleText.value = `${new Date().toLocaleTimeString()} ${title}`;
	rows.value = [t("查询中...")];
	return true;
}

function finishLoading(): void {
	loading.value = false;
}

function clearRows(): void {
	titleText.value = "-";
	rows.value = [];
}

async function reuploadSleep(count: number): Promise<void> {
	if (setLoading(`${t("重新上传睡眠")} ${count} ${t("条")}`) == false) return;
	try {
		const uploadedCount = await bluetoothDataManager.reuploadSleepData(count);
		rows.value = [
			uploadedCount > 0
				? `${t("重新上传成功")}: ${uploadedCount} ${t("条")}`
				: t("重新上传失败，可能没有已上传记录或设备未连接")
		];
	} catch (e) {
		rows.value = [`${t("重新上传失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

function reuploadSleepCustom(): void {
	uni.showModal({
		title: t("重新上传睡眠"),
		content: t("请输入条数"),
		editable: true,
		placeholderText: "1",
		confirmText: t("上传"),
		cancelText: t("取消"),
		success: (res) => {
			if (res.confirm == false) return;
			const count = parseInt((res.content ?? "").trim());
			if (count <= 0 || isNaN(count)) {
				uni.showToast({ title: t("请输入有效条数"), icon: "none" });
				return;
			}
			reuploadSleep(count);
		}
	});
}

function getBatteryStatusLabel(value: number): string {
	if (value == 1) return t("充电中");
	if (value == 2) return t("充电完成");
	if (value == 3) return t("电池异常");
	return t("正常");
}

function formatBroadcast(item: RealtimeBroadcastRecord): string {
	const spo2Pct = (item.spo2 / 10).toFixed(1);
	const voltage = (item.voltageMv / 1000).toFixed(3);
	const calories = (item.calorieEveryday / 100).toFixed(1);
	return `received=${formatMsTime(item.receivedAt)}, utc=${formatSecTime(item.utc)}, hr=${item.hr}, bhr=${item.bhr}, spo2=${spo2Pct}%, ppi=${item.ppi}, rmssd=${item.rmssd}ms, steps=${item.stepsEveryday}, calories=${calories}kcal, v=${voltage}V, eventSeq=${item.eventSeq}, newEvent=${item.hasNewEvent}, battery=${getBatteryStatusLabel(item.batteryStatus)}, ppg=${item.ppgAttached}, behavior=${item.behavior}, activity=${item.activity}, device=${item.deviceId}, raw=${item.rawHex}`;
}

function formatPpi(item: PpiData): string {
	return `time=${formatSecTime(item.timestamp)}, hr=${item.hr}, spo2=${item.spo2}, ppi=${item.ppi}, uploaded=${item.uploaded}, id=${item.id}`;
}

function formatSleep(item: SleepData): string {
	const detailLength = item.detail == null ? 0 : item.detail.length;
	return `report=${formatSecTime(item.reportTimestamp)}, uploaded=${item.uploaded}, bedtime=${formatSecTime(item.bedtime)}, sleep=${formatSecTime(item.sleepTime)}, wake=${formatSecTime(item.wakeTime)}, getup=${formatSecTime(item.getupTime)}, detailLen=${detailLength}, id=${item.id}`;
}

function formatStats(item: UploadTableStats): string {
	return `${item.tableName}: total=${item.total}, uploaded=${item.uploaded}, unuploaded=${item.unuploaded}, range=${formatSecTime(item.earliestTimestamp)} -> ${formatSecTime(item.latestTimestamp)}, latestUploaded=${formatSecTime(item.latestUploadedTimestamp)}, latestUnuploaded=${formatSecTime(item.latestUnuploadedTimestamp)}`;
}

function formatHistorySession(item: HistorySessionDiagnostics): string {
	return `history session: pending=${item.pendingTasks}, pendingRange=${formatSecTime(item.firstPendingFromSec)} -> ${formatSecTime(item.lastPendingToSec)}, confirmedRanges=${item.confirmedRanges}, unuploaded=${item.unuploadedCount}, unuploadedRange=${formatSecTime(item.earliestUnuploadedSec)} -> ${formatSecTime(item.latestUnuploadedSec)}`;
}

async function loadOverview(): Promise<void> {
	if (setLoading(t("数据库总览")) == false) return;
	try {
		const broadcastCount = await bluetoothDataManager.getRealtimeBroadcastDataCount();
		const latestBroadcast = await bluetoothDataManager.getLatestRealtimeBroadcastRecord();
		const ppiCount = await bluetoothDataManager.getPpiDataCount();
		const sleepCount = await bluetoothDataManager.getSleepDataCount();
		const latestPpi = await bluetoothDataManager.getLatestPpiData();
		const unuploadedPpi = await bluetoothDataManager.getUnuploadedPpiData();
		const unuploadedSleep = await bluetoothDataManager.getUnuploadedSleepData();
		const historySession = await bluetoothDataManager.getHistorySessionDiagnostics();
		const result: string[] = [];
		result.push(`realtime_broadcast_data count=${broadcastCount}`);
		result.push(
			latestBroadcast == null
				? "latest broadcast=无"
				: `latest broadcast: ${formatBroadcast(latestBroadcast)}`
		);
		result.push(`ppi_data count=${ppiCount}, unuploaded=${unuploadedPpi.length}`);
		result.push(latestPpi == null ? "latest ppi=无" : `latest ppi: ${formatPpi(latestPpi)}`);
		result.push(`sleep_data count=${sleepCount}, unuploaded=${unuploadedSleep.length}`);
		result.push(formatHistorySession(historySession));
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadUploadAudit(): Promise<void> {
	if (setLoading(t("上传核验")) == false) return;
	try {
		const stats = await bluetoothDataManager.getUploadTableStats();
		const result: string[] = [];
		let totalUnuploaded = 0;
		for (let i = 0; i < stats.length; i++) {
			const item = stats[i];
			totalUnuploaded += item.unuploaded;
			result.push(formatStats(item));
		}
		result.unshift(
			totalUnuploaded == 0
				? t("结论：本地待上传队列为空，已有数据都已标记 uploaded=1。")
				: `${t("结论：仍有未上传数据")} ${totalUnuploaded} ${t("条，请看 latestUnuploaded 或“最近未上传”。")}`
		);
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadBroadcastRows(): Promise<void> {
	if (setLoading(t("最近 10 条广播")) == false) return;
	try {
		const data = await bluetoothDataManager.getRecentRealtimeBroadcastRecords(10);
		const result: string[] = [];
		for (let i = 0; i < data.length; i++) {
			const item = data[i];
			result.push(formatBroadcast(item));
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadPpiRows(): Promise<void> {
	if (setLoading(t("最近 10 条 PPI")) == false) return;
	try {
		const data = await bluetoothDataManager.getRecentPpiData(10);
		const result: string[] = [];
		for (let i = 0; i < data.length; i++) {
			const item = data[i];
			result.push(formatPpi(item));
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadUploadedRows(): Promise<void> {
	if (setLoading(t("最近 10 条已上传")) == false) return;
	try {
		const ppi = await bluetoothDataManager.getRecentPpiDataByUploadStatus(10, true);
		const sleep = await bluetoothDataManager.getRecentSleepData(10, true);
		const result: string[] = [];
		result.push(`ppi_data uploaded recent=${ppi.length}`);
		for (let i = 0; i < ppi.length; i++) {
			result.push(`ppi ${formatPpi(ppi[i])}`);
		}
		result.push(`sleep_data uploaded recent=${sleep.length}`);
		for (let j = 0; j < sleep.length; j++) {
			result.push(`sleep ${formatSleep(sleep[j])}`);
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadUnuploadedRows(): Promise<void> {
	if (setLoading(t("最近 10 条未上传")) == false) return;
	try {
		const ppi = await bluetoothDataManager.getRecentPpiDataByUploadStatus(10, false);
		const sleep = await bluetoothDataManager.getRecentSleepData(10, false);
		const result: string[] = [];
		result.push(`ppi_data unuploaded recent=${ppi.length}`);
		for (let i = 0; i < ppi.length; i++) {
			result.push(`ppi ${formatPpi(ppi[i])}`);
		}
		result.push(`sleep_data unuploaded recent=${sleep.length}`);
		for (let j = 0; j < sleep.length; j++) {
			result.push(`sleep ${formatSleep(sleep[j])}`);
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadSleepRows(): Promise<void> {
	if (setLoading(t("最近 10 条睡眠")) == false) return;
	try {
		const data = await bluetoothDataManager.getRecentSleepData(10, null);
		const result: string[] = [];
		for (let i = 0; i < data.length; i++) {
			result.push(formatSleep(data[i]));
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}

async function loadUploadQueues(): Promise<void> {
	if (setLoading(t("待上传队列")) == false) return;
	try {
		const ppi = await bluetoothDataManager.getUnuploadedPpiData();
		const sleep = await bluetoothDataManager.getUnuploadedSleepData();
		const result: string[] = [];
		result.push(`ppi_data unuploaded=${ppi.length}`);
		for (let i = 0; i < ppi.length && i < 10; i++) {
			const item = ppi[i];
			result.push(`ppi ${formatPpi(item)}`);
		}
		result.push(`sleep_data unuploaded=${sleep.length}`);
		for (let k = 0; k < sleep.length && k < 10; k++) {
			const item = sleep[k];
			result.push(`sleep ${formatSleep(item)}`);
		}
		rows.value = result;
	} catch (e) {
		rows.value = [`${t("查询失败")}: ${e}`];
	} finally {
		finishLoading();
	}
}
//#endif
</script>

<style lang="scss" scoped>
.db-popup {
	background-color: #2b2c28;
}

.diagnostic-tabs {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 12px;
}

.diagnostic-tabs .cl-button {
	margin-right: 8px;
	margin-bottom: 8px;
}

.log-toolbar {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 12px;
}

.log-toolbar .cl-button {
	margin-right: 8px;
	margin-bottom: 8px;
}

.log-card {
	padding: 12px;
	margin-bottom: 12px;
	border-radius: 8px;
	background-color: #111827;
	display: flex;
	flex-direction: column;
	color: #f8fafc;
	font-size: 12px;
	line-height: 18px;
}

.db-row {
	padding: 10px;
	margin-bottom: 8px;
	border-radius: 6px;
	background-color: #111827;
}

.db-row-index {
	margin-bottom: 4px;
	color: #94a3b8;
	font-size: 11px;
}

.db-row-text {
	color: #f8fafc;
	font-size: 12px;
	line-height: 18px;
}
</style>
