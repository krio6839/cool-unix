<template>
	<cl-popup v-model="show" :title="t('生命体征协议 0x3A/0x3B')" direction="bottom" :size="680">
		<scroll-view class="popup-body" scroll-y="true">
			<view class="form-card">
				<text class="title">{{ t("手动读取") }}</text>
				<cl-select-date
					v-model="startTime"
					type="second"
					:value-format="timeFormat"
					:label-format="timeFormat"
					:placeholder="t('选择起始时间')"
					class="form-field"
				/>
				<text class="protocol-seconds">{{ t("协议秒") }}：{{ startSecText }}</text>
				<cl-select class="form-field" v-model="direction" :options="directionOptions" />
				<cl-select class="form-field" v-model="minutes" :options="minutesOptions" />
				<text class="protocol-hint">{{
					t("向前 (0)：从起点往回读到基准 B，只落库不记账；向后 (1)：从起点读到记账上限，并推进基准。")
				}}</text>
				<cl-button
					class="form-field"
					type="primary"
					color="#047857"
					rounded
					size="small"
					:disabled="props.busy"
					@tap="submitVital"
					>{{ t("从该时间开始（0x3A 连续读 0x3B）") }}</cl-button
				>
				<cl-button
					class="form-field"
					type="primary"
					color="#b45309"
					rounded
					size="small"
					:disabled="props.busy == false"
					@tap="emit('stop')"
					>{{ t("停止读取") }}</cl-button
				>
				<text v-if="formError != ''" class="form-error">{{ formError }}</text>
			</view>
			<view v-if="props.hasData" class="result-card">
				<text class="title">{{ t("读取结果") }}</text>
				<text>{{ props.vitalText.start }}</text>
				<text>{{ props.vitalText.directionMinutes }}</text>
				<text
					>{{ t("有效秒") }}：{{ props.vitalText.valid }} · PPI：{{
						props.vitalText.ppi
					}}</text
				>
				<text>{{ props.vitalText.status }}</text>
				<text>{{ props.vitalText.rmssdSdnn }}</text>
				<text>{{ props.vitalText.vital }}</text>
				<text>{{ props.autoDetail }}</text></view
			>
		</scroll-view>
	</cl-popup>
</template>
<script lang="ts" setup>
import { computed, ref } from "vue";
import { dayUts, t } from "@/.cool";
import type { ClSelectOption } from "@/uni_modules/cool-ui";
// `VitalPopupText` 本文件从不直呼其名（只在模板里读 `props.vitalText.*`），所以静态扫「未使用导入」会
// 把它当成死代码——但 UTS 生成的 props 字段是 `vitalText: VitalPopupText`，需要这里显式引入这个类型，
// 删了就会报 `Unresolved reference 'VitalPopupText'` 并级联到模板里的每个 `.vitalText.xxx`。
import type { VitalPopupPayload, VitalPopupText, VitalProtocolPopupProps } from "./types";
const show = defineModel("show", { default: false });
const props = defineProps<VitalProtocolPopupProps>();
// 声明载荷类型：对象字面量直传 emit 会被编组成 UTSJSONObject，父页面强类型入参会抛 IllegalArgumentException。
const emit = defineEmits<{
	(e: "submit", payload: VitalPopupPayload): void;
	(e: "stop"): void;
}>();
const timeFormat = "YYYY-MM-DD HH:mm:ss";
function formatPickerTime(sec: number): string {
	return dayUts(new Date(sec * 1000)).format(timeFormat);
}
function toUnixSec(value: string): number {
	if (value == "") return 0;
	const ms = dayUts(value).valueOf();
	return Number.isNaN(ms) ? 0 : Math.floor(ms / 1000);
}
const startTime = ref(formatPickerTime(Math.floor(Date.now() / 1000) - 5 * 60));
const formError = ref("");
const startSecText = computed<string>(() => {
	const sec = toUnixSec(startTime.value);
	return sec > 0 ? sec.toString() : "-";
});
/**
 * 0x3A 的两个协议参数，与设备协议一致：`0`=向更早（从起点往回翻页）、`1`=向更新。
 *
 * 默认 `1`：正式补录就是向更新读，测试页默认跟上，免得每次手动再选一遍。`0` 翻的是基准
 * 已经确认过的那一段，只落库不记账。
 */
const direction = ref(1);
const minutes = ref(2);
const directionOptions: ClSelectOption[] = [
	{ label: t("向前 (0，更早)"), value: 0 },
	{ label: t("向后 (1，更新)"), value: 1 }
];
const minutesOptions: ClSelectOption[] = [
	{ label: t("2 分钟"), value: 2 },
	{ label: t("5 分钟"), value: 5 }
];
function submitVital(): void {
	const startSec = toUnixSec(startTime.value);
	if (startSec <= 0) {
		formError.value = t("请选择有效的起始时间");
		return;
	}
	formError.value = "";
	const payload: VitalPopupPayload = {
		startSec: startSec.toString(),
		direction: direction.value,
		minutes: minutes.value
	};
	emit("submit", payload);
}
</script>
<style lang="scss" scoped>
.popup-body {
	height: 100%;
	padding: 16px;
	background-color: #111827;
}
.form-card,
.result-card {
	padding: 12px;
	margin-bottom: 12px;
	border-radius: 8px;
	background-color: #1f2937;
	display: flex;
	flex-direction: column;
	color: #e5e7eb;
	font-size: 12px;
	line-height: 18px;
}

.title {
	color: #fff;
	font-size: 14px;
	font-weight: 700;
}
.form-field,
.protocol-seconds,
.form-error {
	margin-top: 9px;
}
.protocol-seconds {
	color: #93c5fd;
}
.protocol-hint {
	margin-top: 6px;
	color: #94a3b8;
	line-height: 16px;
}
.form-error {
	color: #fecaca;
}
</style>
