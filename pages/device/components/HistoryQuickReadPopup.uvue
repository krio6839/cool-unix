<template>
	<cl-popup v-model="show" :title="t('快速历史读取')" direction="bottom" :size="680">
		<scroll-view class="popup-body" scroll-y="true">
			<text class="help">{{
				t(
					"逐页读取、逐页落库供查看导出，读到的页可用「保存到下载」导出 CSV 核对。挂钩 B 时按落库探测进 B；关掉则纯只读观测、一步都不推进 B。"
				)
			}}</text>
			<cl-list border :pt="{ className: 'mt-5' }">
				<cl-list-item :label="t('挂钩基准 B')">
					<cl-switch v-model="linkBaseline"></cl-switch>
				</cl-list-item>
				<cl-list-item :label="t('向后读取（关=向前/更早）')">
					<cl-switch v-model="forward"></cl-switch>
				</cl-list-item>
			</cl-list>
			<text class="switch-hint">{{
				linkBaseline
					? t("挂钩：右端取记账上限，读到的数据会推进 B")
					: t("不挂钩：窗口只按当前时间算，与 B 无关，纯只读")
			}}</text>
			<text class="baseline-info">{{ props.baselineInfo }}</text>
			<view class="range-grid">
				<cl-button
					v-for="days in [1, 3, 7]"
					:key="days"
					type="primary"
					color="#0369a1"
					rounded
					size="small"
					:disabled="props.busy"
					@tap="emit('read-range', makePayload(days))"
					>{{ t("读取近") }} {{ days == 7 ? t("一周") : days + t("天") }}</cl-button
				>
				<cl-button
					type="primary"
					color="#7c3aed"
					rounded
					size="small"
					:disabled="props.busy"
					@tap="emit('read-from-baseline', makePayload(0))"
					>{{ t("从基准 B 读到上限") }}</cl-button
				>
			</view>
			<view class="status-card">
				<view v-if="props.busy" class="reading-banner">
					<cl-loading></cl-loading>
					<text class="reading-text">{{ t("正在读取设备历史，逐页落库中…") }}</text>
				</view>
				<text>{{ props.status }}</text>
				<text>{{ t("目标范围") }}：{{ props.days > 0 ? props.days + t("天") : "-" }}</text>
				<text
					>{{ t("页数") }}：{{ props.pages }} · {{ t("解析秒数") }}：{{
						props.seconds
					}}</text
				>
			</view>
			<view class="range-grid"
				><cl-button
					type="primary"
					color="#b45309"
					rounded
					size="small"
					:disabled="props.busy == false"
					@tap="emit('stop')"
					>{{ t("停止当前读取") }}</cl-button
				><cl-button
					type="primary"
					color="#047857"
					rounded
					size="small"
					:disabled="props.busy || props.exportCount == 0"
					@tap="emit('export')"
					>{{ t("保存到下载") }}
				</cl-button>
			</view>
		</scroll-view>
	</cl-popup>
</template>
<script lang="ts" setup>
import { ref } from "vue";
import { t } from "@/.cool";
import type { HistoryQuickReadPayload, HistoryQuickReadPopupProps } from "./types";
const show = defineModel("show", { default: false });
const props = defineProps<HistoryQuickReadPopupProps>();
const emit = defineEmits(["read-range", "read-from-baseline", "stop", "export"]);
// 两个开关默认挂钩基准、向后读；窗口怎么定由页面按这两个值算。
const linkBaseline = ref<boolean>(true);
const forward = ref<boolean>(true);
function makePayload(days: number): HistoryQuickReadPayload {
	return { days: days, linkBaseline: linkBaseline.value, forward: forward.value };
}
</script>
<style lang="scss" scoped>
.popup-body {
	height: 100%;
	padding: 16px;
	background-color: #111827;
}
.help {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
}
.switch-hint {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
	margin-top: 8px;
}
.baseline-info {
	color: #a7f3d0;
	font-size: 12px;
	line-height: 18px;
	margin-top: 8px;
}
.range-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin: 12px 0;
}

.status-card {
	padding: 12px;
	border-radius: 8px;
	background-color: #1f2937;
	color: #dbeafe;
	display: flex;
	flex-direction: column;
	font-size: 12px;
	line-height: 18px;
}
.reading-banner {
	flex-direction: row;
	align-items: center;
	padding: 6px 8px;
	margin-bottom: 8px;
	border-radius: 6px;
	background-color: #1e40af;
}
.reading-text {
	margin-left: 8px;
	color: #ffffff;
	font-size: 12px;
	line-height: 18px;
}
</style>
