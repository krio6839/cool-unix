<template>
	<cl-popup v-model="show" :title="t('补录参数')" direction="bottom" :size="720">
		<scroll-view class="p-4 tune-popup" scroll-y="true" style="height: 100%">
			<view class="tune-head">
				<text class="tune-head-title">{{ t("运行时可调参数") }}</text>
				<text v-if="loading" class="tune-loading">{{ t("正在读取...") }}</text>
				<text v-else class="tune-head-count">{{ overriddenCount }} {{ t("项已覆盖") }}</text>
			</view>
			<view v-if="errorText != ''" class="tune-error"
				><text class="tune-error-text">{{ errorText }}</text></view
			>
			<text class="tune-help">{{ props.commandMessage }}</text>

			<view v-for="item in items" :key="item.key" class="tune-card">
				<view class="tune-card-head">
					<text class="tune-label">{{ item.label }}</text>
					<text class="tune-badge" :class="{ 'tune-badge-on': item.overridden }">{{
						item.overridden ? t("已覆盖") : t("默认")
					}}</text>
				</view>
				<text class="tune-desc">{{ item.description }}</text>
				<view class="tune-line">
					<text class="tune-line-label">{{ t("当前生效") }}</text>
					<text class="tune-line-value">{{ item.value }} {{ item.unit }}</text>
				</view>
				<view class="tune-line">
					<text class="tune-line-label">{{ t("默认值") }}</text>
					<text class="tune-line-value">{{ item.defaultValue }} {{ item.unit }}</text>
				</view>
				<view class="tune-edit">
					<input
						v-model="drafts[item.key]"
						class="tune-input"
						type="number"
						:placeholder="`${item.defaultValue}`"
					/>
					<cl-button
						type="primary"
						color="#047857"
						rounded
						size="small"
						class="tune-button"
						@tap="apply(item.key)"
						>{{ t("保存") }}</cl-button
					>
					<cl-button
						type="primary"
						color="#475569"
						rounded
						size="small"
						class="tune-button"
						:disabled="item.overridden == false"
						@tap="reset(item.key)"
						>{{ t("重置") }}</cl-button
					>
				</view>
			</view>

			<cl-button
				type="primary"
				color="#7f1d1d"
				rounded
				size="large"
				class="tune-reset-all"
				@tap="resetAll"
				>{{ t("全部重置为默认值") }}</cl-button
			>
		</scroll-view>
	</cl-popup>
</template>
<script lang="ts" setup>
// #ifndef H5
import { computed, ref, watch } from "vue";
import { t } from "@/.cool";
import {
	getHistoryTunable,
	getHistoryTunableDefault,
	getHistoryTunableKeys,
	isHistoryTunableOverridden,
	resetHistoryTunables,
	setHistoryTunable
} from "@/.cool/bluetooth/history/tunables";
import type { HistoryTuneItem, HistoryTunePopupProps } from "./types";
const show = defineModel("show", { default: false });
const props = defineProps<HistoryTunePopupProps>();
const items = ref<HistoryTuneItem[]>([]);
const drafts = ref<Record<string, string>>({});
const loading = ref<boolean>(false);
const errorText = ref<string>("");
const overriddenCount = computed<number>(() => {
	let total = 0;
	for (let i = 0; i < items.value.length; i++) {
		if (items.value[i].overridden == true) total++;
	}
	return total;
});

const LABELS: Record<string, string> = {
	minuteSettleSec: "记账余量",
	broadcastResumeGraceSec: "广播接续宽限",
	bridgeSec: "缺口桥接距离",
	urgentGapIntervalMs: "加急连接最小间隔"
};
const UNITS: Record<string, string> = {
	minuteSettleSec: "秒",
	broadcastResumeGraceSec: "秒",
	bridgeSec: "秒",
	urgentGapIntervalMs: "毫秒"
};
const DESCRIPTIONS: Record<string, string> = {
	minuteSettleSec:
		"记账右端 = now - 该值，缺口右端与分类右端共用。这是唯一会影响数据正确性的参数：调小会让尚未稳定的秒被记为「确认无数据」，调大只是让基准时间落后一些。",
	broadcastResumeGraceSec:
		"连接留下的空洞超过它就值得多读一次设备；不超过则整段按「确认无数据」推进基准时间。注意它不是容差：容差只覆盖 8 秒以内的连续空洞，9 秒到该值之间是有意放弃的真数据。",
	bridgeSec:
		"相距这么近的缺口合并成一条读取链路，跨过的秒本地已有、不重复入库。调大能减少连接次数，代价是每轮多读一些已有的秒。",
	urgentGapIntervalMs:
		"8.4 加急缺口连接的最小间隔。完全放开会让「广播质量差 → 频繁连接 → 广播更长时间停摆」形成恶性循环；复用常规的 10 分钟又让加急失去意义。"
};

function loadItems(): void {
	try {
		const keys = getHistoryTunableKeys();
		const next: HistoryTuneItem[] = [];
		const nextDrafts: Record<string, string> = {};
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i];
			const value = getHistoryTunable(key);
			next.push({
				key,
				label: t(LABELS[key] ?? key),
				unit: t(UNITS[key] ?? ""),
				description: t(DESCRIPTIONS[key] ?? ""),
				value,
				defaultValue: getHistoryTunableDefault(key),
				overridden: isHistoryTunableOverridden(key)
			});
			// 输入框留空表示「不改」，避免把当前生效值当成待保存值反复写回去。
			nextDrafts[key] = "";
		}
		items.value = next;
		drafts.value = nextDrafts;
		errorText.value = "";
	} catch (error) {
		items.value = [];
		errorText.value = "读取失败: " + error;
	} finally {
		loading.value = false;
	}
}

function parseDraft(key: string): number {
	const raw = drafts.value[key];
	if (raw == null || raw == "") return -1;
	const value = parseInt(raw);
	if (isNaN(value) == true || value <= 0) return -1;
	return value;
}

function apply(key: string): void {
	const value = parseDraft(key);
	if (value <= 0) {
		errorText.value = t("请输入大于 0 的整数，留空表示不修改");
		return;
	}
	setHistoryTunable(key, value);
	loadItems();
}

function reset(key: string): void {
	setHistoryTunable(key, 0);
	loadItems();
}

function resetAll(): void {
	resetHistoryTunables();
	loadItems();
}

function scheduleOpenRefresh(): void {
	if (loading.value) return;
	loading.value = true;
	setTimeout(() => {
		loadItems();
	}, 16);
}

watch(show, (visible: boolean) => {
	if (visible) scheduleOpenRefresh();
});
// #endif
</script>
<style lang="scss" scoped>
.tune-popup {
	background-color: #111827;
}
.tune-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 10px;
}
.tune-head-title {
	color: #fff;
	font-size: 16px;
	font-weight: 700;
	flex: 1;
}
.tune-head-count {
	color: #a7f3d0;
	font-size: 13px;
}
.tune-loading {
	color: #93c5fd;
	font-size: 12px;
}
.tune-help {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 12px;
}
.tune-error {
	padding: 10px;
	margin-bottom: 10px;
	border-radius: 8px;
	background-color: rgba(127, 29, 29, 0.35);
}
.tune-error-text {
	color: #fecaca;
	font-size: 12px;
	line-height: 18px;
}
.tune-card {
	background-color: #1f2937;
	border-radius: 10px;
	padding: 12px;
	margin-bottom: 10px;
}
.tune-card-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 6px;
}
.tune-label {
	color: #fef3c7;
	font-size: 14px;
	font-weight: 700;
	flex: 1;
}
.tune-badge {
	color: #94a3b8;
	font-size: 12px;
}
.tune-badge-on {
	color: #fcd34d;
}
.tune-desc {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 8px;
}
.tune-line {
	display: flex;
	flex-direction: row;
	margin-bottom: 6px;
}
.tune-line-label {
	color: #9ca3af;
	font-size: 12px;
	width: 66px;
}
.tune-line-value {
	color: #e5e7eb;
	font-size: 12px;
	flex: 1;
}
.tune-edit {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 4px;
}
.tune-input {
	flex: 1;
	height: 34px;
	padding: 0 10px;
	margin-right: 8px;
	border-radius: 6px;
	background-color: #0f172a;
	color: #e5e7eb;
	font-size: 13px;
}
.tune-button {
	margin-left: 6px;
}
.tune-reset-all {
	margin-top: 6px;
}
</style>
