<template>
	<cl-popup v-model="show" :title="t('历史缺口与补录')" direction="bottom" :size="680">
		<scroll-view class="p-4 gap-popup" scroll-y="true" style="height: 100%">
			<view class="gap-summary">
				<text class="gap-summary-title">{{ t("当前缺口") }}</text>
				<text class="gap-summary-count">{{ groups.length }} {{ t("组") }}</text>
				<text v-if="loading" class="gap-loading">{{ t("正在读取...") }}</text>
				<text v-if="props.busy" class="gap-running">{{ props.commandMessage }}</text>
				<cl-button
					type="primary"
					color="#725"
					rounded
					size="small"
					:disabled="loading || props.busy"
					@tap="refresh"
					>{{ t("刷新") }}</cl-button
				>
			</view>
			<view class="gap-baseline">
				<view class="gap-line"
					><text class="gap-label">{{ t("基准时间 B") }}</text
					><text class="gap-value">{{ formatSec(baseline) }}</text></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("记账上限") }}</text
					><text class="gap-value">{{ formatSec(ceiling) }}</text></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("已记账区间") }}</text
					><text class="gap-value">{{ readyRanges }} {{ t("条") }}</text></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("待补总计") }}</text
					><text class="gap-value">{{ totalRepairSeconds }} {{ t("秒") }}</text></view
				>
			</view>
			<text v-if="batchHint != ''" class="gap-batch">{{ batchHint }}</text>
			<view v-if="errorText != ''" class="gap-error"
				><text class="gap-error-text">{{ errorText }}</text></view
			>
			<view v-if="props.busy" class="gap-progress"
				><text class="gap-progress-text">{{ props.commandMessage }}</text></view
			>
			<text class="gap-help">{{
				t(
					"缺口不落库，由基准时间与已记账区间相减得出。补录从缺口末端发送 0x3A，再用 0x3B 向更早时间继续读取。"
				)
			}}</text>
			<view v-if="groups.length == 0" class="gap-empty"
				><text class="gap-empty-text">{{ t("当前没有待补的历史缺口") }}</text></view
			>
			<view v-for="group in groups" :key="groupKey(group)" class="gap-card">
				<view class="gap-card-head"
					><text class="gap-kind">{{ t("缺口组") }}</text
					><text class="gap-state">{{ stateLabel(group) }}</text></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("连续读取窗口") }}</text
					><text class="gap-value"
						>{{ formatWindow(group.fromSec, group.toSec) }}</text
					></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("实际待补") }}</text
					><text class="gap-value">{{ group.repairSeconds }} {{ t("秒") }}</text></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("窗口内非待补") }}</text
					><text class="gap-value"
						>{{ group.bridgeSeconds }} {{ t("秒（连续读取时跳过写入）") }}</text
					></view
				>
				<view class="gap-line"
					><text class="gap-label">{{ t("预计耗时") }}</text
					><text class="gap-value">{{ estimateLabel(group) }}</text></view
				>
				<cl-button
					type="primary"
					color="#047857"
					rounded
					size="small"
					class="gap-repair"
					:disabled="isRepairDisabled()"
					@tap="repairGroup(group)"
					>{{ repairButtonText(groupKey(group)) }}</cl-button
				>
			</view>
		</scroll-view>
	</cl-popup>
</template>
<script lang="ts" setup>
// #ifndef H5
import { computed, ref, watch } from "vue";
import { t } from "@/.cool";
import { historyBaseline, type HistoryGap } from "@/.cool/bluetooth/history/baseline";
import type { HistoryGapRepairPayload, HistoryGapRepairPopupProps } from "./types";
const show = defineModel("show", { default: false });
const emit = defineEmits(["refresh", "repair-history-gap"]);
const props = defineProps<HistoryGapRepairPopupProps>();
const revision = computed<number>(() => props.revision);
const groups = ref<HistoryGap[]>([]);
const baseline = ref<number>(0);
const ceiling = ref<number>(0);
const readyRanges = ref<number>(0);
const loading = ref<boolean>(false);
const errorText = ref<string>("");
const totalRepairSeconds = computed<number>(() => {
	let total = 0;
	for (let i = 0; i < groups.value.length; i++) total += groups.value[i].repairSeconds;
	return total;
});
/**
 * 一条连接不设时长上限，一轮就把所有缺口补完，所以卡片数量就是本轮的全部工作量，
 * 不再是「一次只补一批」。这里只把窗口跨度对应的大致耗时写出来，让用户对长连接有预期。
 */
const batchHint = computed<string>(() => {
	if (groups.value.length == 0) return "";
	return (
		t("本轮共") +
		" " +
		groups.value.length +
		" " +
		t("组缺口、") +
		" " +
		totalRepairSeconds.value +
		" " +
		t("秒待补，一次连接全部读完，连接期间广播暂停。")
	);
});
const repairingGroupKey = ref("");
function groupKey(group: HistoryGap): string {
	return group.fromSec + "-" + group.toSec;
}
function repairGroup(group: HistoryGap): void {
	repairingGroupKey.value = groupKey(group);
	const payload: HistoryGapRepairPayload = { fromSec: group.fromSec, toSec: group.toSec };
	emit("repair-history-gap", payload);
}
function isRepairDisabled(): boolean {
	return loading.value || props.busy;
}
function repairButtonText(key: string): string {
	if (props.busy && repairingGroupKey.value == key) return t("正在补录...");
	if (props.busy) return t("队列执行中");
	return t("补此缺口");
}
async function loadTasks(): Promise<void> {
	try {
		const nowSec = Math.floor(Date.now() / 1000);
		const snapshot = await historyBaseline.snapshot(nowSec);
		baseline.value = snapshot.baseline;
		ceiling.value = snapshot.ceiling;
		readyRanges.value = snapshot.readyRanges.length;
		groups.value = snapshot.gaps;
	} catch (error) {
		groups.value = [];
		errorText.value = "查询失败: " + error;
	} finally {
		loading.value = false;
	}
}
async function refresh(): Promise<void> {
	if (loading.value) return;
	loading.value = true;
	errorText.value = "";
	await loadTasks();
}
function scheduleOpenRefresh(): void {
	if (loading.value) return;
	loading.value = true;
	errorText.value = "";
	setTimeout(() => {
		loadTasks();
	}, 16);
}
watch(show, (visible: boolean) => {
	if (visible) scheduleOpenRefresh();
});
/** 由 DeviceSync 的规划/执行 revision 驱动，不在弹窗内轮询数据库。 */
watch(revision, (value: number) => {
	if (show.value && value > 0) scheduleOpenRefresh();
});
function two(value: number): string {
	return value < 10 ? "0" + value : value.toString();
}
function formatSec(sec: number): string {
	if (sec <= 0) return "-";
	const date = new Date(sec * 1000);
	return (
		date.getFullYear() +
		"-" +
		two(date.getMonth() + 1) +
		"-" +
		two(date.getDate()) +
		" " +
		two(date.getHours()) +
		":" +
		two(date.getMinutes()) +
		":" +
		two(date.getSeconds())
	);
}
function formatWindow(fromSec: number, toSec: number): string {
	if (toSec <= fromSec) return formatSec(fromSec);
	return formatSec(fromSec) + " 至 " + formatSec(toSec - 1);
}
function stateLabel(group: HistoryGap): string {
	return group.bridgeSeconds > 0 ? t("含桥接合并") : t("等待补录");
}
/** 设备按 2 分钟一页、页间 250ms 返回，一页约 1.45 秒。 */
const PAGE_COST_SEC = 1.45;
function estimateLabel(group: HistoryGap): string {
	const pages = Math.ceil(Math.max(0, group.toSec - group.fromSec) / 120);
	return Math.round(pages * PAGE_COST_SEC) + " " + t("秒（约") + " " + pages + " " + t("页）");
}
// #endif
</script>
<style lang="scss" scoped>
.gap-popup {
	background-color: #111827;
}
.gap-summary {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 10px;
}
.gap-summary-title {
	color: #fff;
	font-size: 16px;
	font-weight: 700;
	flex: 1;
}
.gap-summary-count {
	color: #a7f3d0;
	font-size: 13px;
	margin-right: 10px;
}
.gap-loading {
	margin-right: 10px;
	color: #93c5fd;
	font-size: 12px;
}
.gap-baseline {
	background-color: #1f2937;
	border-radius: 10px;
	padding: 10px 12px;
	margin-bottom: 10px;
}
.gap-batch {
	color: #93c5fd;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 10px;
}
.gap-running {
	margin-right: 10px;
	color: #fcd34d;
	font-size: 12px;
}
.gap-progress {
	padding: 10px;
	margin-bottom: 10px;
	border-radius: 8px;
	background-color: rgba(146, 64, 14, 0.3);
}
.gap-progress-text {
	color: #fef3c7;
	font-size: 12px;
	line-height: 18px;
}
.gap-help {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 12px;
}
.gap-empty {
	padding: 32px 12px;
}
.gap-empty-text {
	color: #9ca3af;
	text-align: center;
}
.gap-error {
	padding: 10px;
	margin-bottom: 10px;
	border-radius: 8px;
	background-color: rgba(127, 29, 29, 0.35);
}
.gap-error-text {
	color: #fecaca;
	font-size: 12px;
	line-height: 18px;
}
.gap-card {
	background-color: #1f2937;
	border-radius: 10px;
	padding: 12px;
	margin-bottom: 10px;
}
.gap-card-head {
	display: flex;
	flex-direction: row;
	margin-bottom: 9px;
}
.gap-kind {
	color: #fef3c7;
	font-size: 14px;
	font-weight: 700;
	flex: 1;
}
.gap-state {
	color: #a7f3d0;
	font-size: 12px;
}
.gap-line {
	display: flex;
	flex-direction: row;
	margin-bottom: 6px;
}
.gap-label {
	color: #9ca3af;
	font-size: 12px;
	width: 88px;
}
.gap-value {
	color: #e5e7eb;
	font-size: 12px;
	flex: 1;
	line-height: 17px;
}
.gap-repair {
	margin-top: 6px;
}
</style>
