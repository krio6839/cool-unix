<template>
	<cl-popup v-model="show" :title="t('历史补录')" direction="bottom" :size="620">
		<scroll-view class="repair-popup p-4" scroll-y="true" style="height: 100%">
			<view class="repair-summary">
				<text class="repair-summary-title">{{ t("待补秒数") }}</text>
				<text class="repair-summary-count">{{ behind }} {{ t("秒") }}</text>
				<text v-if="loading" class="repair-loading">{{ t("正在读取...") }}</text>
				<text v-if="props.busy" class="repair-running">{{ props.commandMessage }}</text>
				<cl-button
					type="primary"
					color="#725"
					rounded
					size="small"
					:disabled="loading || props.busy"
					@tap="refresh"
					>{{ t("刷新") }}</cl-button
				>
			</view>
			<view class="repair-baseline">
				<view class="repair-line"
					><text class="repair-label">{{ t("基准时间 B") }}</text
					><text class="repair-value">{{ formatSec(baseline) }}</text></view
				>
				<view class="repair-line"
					><text class="repair-label">{{ t("记账上限") }}</text
					><text class="repair-value">{{ formatSec(ceiling) }}</text></view
				>
				<view class="repair-line"
					><text class="repair-label">{{ t("已判定到 C") }}</text
					><text class="repair-value">{{ formatSec(classifiedUntil) }}</text></view
				>
				<view class="repair-line"
					><text class="repair-label">{{ t("读取窗口") }}</text
					><text class="repair-value">{{ formatWindow(baseline, ceiling) }}</text></view
				>
			</view>
			<text v-if="batchHint != ''" class="repair-batch">{{ batchHint }}</text>
			<view v-if="errorText != ''" class="repair-error"
				><text class="repair-error-text">{{ errorText }}</text></view
			>
			<view v-if="props.busy" class="repair-progress"
				><text class="repair-progress-text">{{ props.commandMessage }}</text></view
			>
			<text class="repair-help">{{
				t(
					"读取从基准时间 B 起、到记账上限止的一整段：先发 0x3A 定位，再用 0x3B 向更新方向顺序读取。设备会把没记录的区间直接跳过，所以这一段里缺多少秒都不影响连接次数；没读完的留到下一次连接接着读。"
				)
			}}</text>
			<cl-button
				type="primary"
				color="#047857"
				rounded
				size="small"
				class="repair-action"
				:disabled="isRepairDisabled()"
				@tap="repairWindow"
				>{{ repairButtonText() }}</cl-button
			>
		</scroll-view>
	</cl-popup>
</template>
<script lang="ts" setup>
// #ifndef H5
import { computed, ref, watch } from "vue";
import { t } from "@/.cool";
import { historyBaseline } from "@/.cool/bluetooth/history/baseline";
import type { HistoryRepairPayload, HistoryRepairPopupProps } from "./types";
const show = defineModel("show", { default: false });
const emit = defineEmits(["repair"]);
const props = defineProps<HistoryRepairPopupProps>();
const revision = computed<number>(() => props.revision);
const baseline = ref<number>(0);
const ceiling = ref<number>(0);
const classifiedUntil = ref<number>(0);
const behind = ref<number>(0);
const loading = ref<boolean>(false);
const errorText = ref<string>("");
/** 设备按 2 分钟一页、页间 250ms 返回，一页约 1.45 秒。 */
const PAGE_COST_SEC = 1.45;
/**
 * 一条连接不设时长上限，从 `B` 一路读到记账上限，所以窗口跨度就是本轮的全部工作量。
 * 这里把大致耗时写出来，让用户对长连接有预期。
 */
const batchHint = computed<string>(() => {
	const span = ceiling.value - baseline.value;
	if (span <= 0) return t("基准时间已贴着记账上限，当前没有待补数据。");
	const pages = Math.ceil(span / 120);
	const cost = Math.max(1, Math.round(pages * PAGE_COST_SEC));
	return (
		t("本轮窗口跨度") +
		" " +
		span +
		" " +
		t("秒，最长约") +
		" " +
		cost +
		" " +
		t("秒读完，连接期间广播暂停。")
	);
});
function isRepairDisabled(): boolean {
	return loading.value || props.busy;
}
function repairButtonText(): string {
	if (props.busy) return t("队列执行中");
	return t("补录整段");
}
/** 补录固定读 `[B, 记账上限)`，端点由弹窗当下读到的快照给出。 */
function repairWindow(): void {
	const payload: HistoryRepairPayload = { fromSec: baseline.value, toSec: ceiling.value };
	emit("repair", payload);
}
async function loadTasks(): Promise<void> {
	try {
		const nowSec = Math.floor(Date.now() / 1000);
		const snapshot = await historyBaseline.snapshot(nowSec);
		baseline.value = snapshot.baseline;
		ceiling.value = snapshot.ceiling;
		classifiedUntil.value = snapshot.classifiedUntil;
		behind.value = snapshot.behind;
	} catch (error) {
		behind.value = 0;
		errorText.value = "查询失败: " + error;
	} finally {
		loading.value = false;
	}
}
async function refresh(): Promise<void> {
	if (loading.value) return;
	loading.value = true;
	errorText.value = "";
	await loadTasks();
}
function scheduleOpenRefresh(): void {
	if (loading.value) return;
	loading.value = true;
	errorText.value = "";
	setTimeout(() => {
		loadTasks();
	}, 16);
}
watch(show, (visible: boolean) => {
	if (visible) scheduleOpenRefresh();
});
/** 由心跳的规划/执行 revision 驱动，不在弹窗内轮询数据库。 */
watch(revision, (value: number) => {
	if (show.value && value > 0) scheduleOpenRefresh();
});
function two(value: number): string {
	return value < 10 ? "0" + value : value.toString();
}
function formatSec(sec: number): string {
	if (sec <= 0) return "-";
	const date = new Date(sec * 1000);
	return (
		date.getFullYear() +
		"-" +
		two(date.getMonth() + 1) +
		"-" +
		two(date.getDate()) +
		" " +
		two(date.getHours()) +
		":" +
		two(date.getMinutes()) +
		":" +
		two(date.getSeconds())
	);
}
function formatWindow(fromSec: number, toSec: number): string {
	if (toSec <= fromSec) return formatSec(fromSec);
	return formatSec(fromSec) + " 至 " + formatSec(toSec - 1);
}
// #endif
</script>
<style lang="scss" scoped>
.repair-popup {
	background-color: #111827;
}
.repair-summary {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 10px;
}
.repair-summary-title {
	color: #fff;
	font-size: 16px;
	font-weight: 700;
	flex: 1;
}
.repair-summary-count {
	color: #a7f3d0;
	font-size: 13px;
	margin-right: 10px;
}
.repair-loading {
	margin-right: 10px;
	color: #93c5fd;
	font-size: 12px;
}
.repair-baseline {
	background-color: #1f2937;
	border-radius: 10px;
	padding: 10px 12px;
	margin-bottom: 10px;
}
.repair-batch {
	color: #93c5fd;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 10px;
}
.repair-running {
	margin-right: 10px;
	color: #fcd34d;
	font-size: 12px;
}
.repair-progress {
	padding: 10px;
	margin-bottom: 10px;
	border-radius: 8px;
	background-color: rgba(146, 64, 14, 0.3);
}
.repair-progress-text {
	color: #fef3c7;
	font-size: 12px;
	line-height: 18px;
}
.repair-help {
	color: #9ca3af;
	font-size: 12px;
	line-height: 18px;
	margin-bottom: 12px;
}
.repair-action {
	margin-bottom: 14px;
}
.repair-error {
	padding: 10px;
	margin-bottom: 10px;
	border-radius: 8px;
	background-color: rgba(127, 29, 29, 0.35);
}
.repair-error-text {
	color: #fecaca;
	font-size: 12px;
	line-height: 18px;
}
.repair-line {
	display: flex;
	flex-direction: row;
	margin-bottom: 6px;
}
.repair-label {
	color: #9ca3af;
	font-size: 12px;
	width: 88px;
}
.repair-value {
	color: #e5e7eb;
	font-size: 12px;
	flex: 1;
	line-height: 17px;
}
</style>
