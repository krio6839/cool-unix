<template>
	<cl-popup v-model="show" :title="t('设备测试')" direction="bottom" :size="600">
		<scroll-view class="p-4 flex flex-col" scroll-y="true" style="height: 100%">
			<!-- 设备状态信息 -->
			<view class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("设备状态") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("连接状态") }}</cl-text>
						<cl-text color="white" :size="14">{{ deviceStore.status.value }}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("心率") }}</cl-text>
						<cl-text color="white" :size="14"
							>{{ deviceStore.heartRate.value }} BPM</cl-text
						>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("血氧") }}</cl-text>
						<cl-text color="white" :size="14"
							>{{ deviceStore.bloodOxygen.value }}%</cl-text
						>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("电池") }}</cl-text>
						<cl-text color="white" :size="14">{{ deviceStore.battery.value }}%</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("PPI") }}</cl-text>
						<cl-text color="white" :size="14">{{ deviceStore.ppi.value }}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("设备ID") }}</cl-text>
						<cl-text color="white" :size="12" :line="1">{{
							deviceStore.currentDeviceId
						}}</cl-text>
					</view>
				</view>
			</view>

			<!-- 设备控制测试 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("设备控制") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#333"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="toggleDevice"
				>
					{{ t("开关设备") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#333"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testDisconnect"
				>
					{{ t("断开连接") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#333"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReconnect"
				>
					{{ t("测试重连") }}
				</cl-button>
			</view>

			<!-- 数据读取测试 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("数据读取") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadBloodOxygen"
				>
					{{ t("读取血氧") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadBattery"
				>
					{{ t("读取电池") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetLEDStatus"
				>
					{{ t("获取LED状态") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="subscribeHeartRate"
				>
					{{ t("订阅心率") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="deviceStore.subscribeUART()"
				>
					{{ t("订阅UART") }}
				</cl-button>
			</view>

			<!-- 设备信息 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("设备信息") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#555"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetDeviceInfo"
				>
					{{ t("获取设备信息") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#555"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testClearError"
				>
					{{ t("清除错误") }}
				</cl-button>
			</view>

			<!-- 历史数据状态 -->
			<view class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("历史数据状态") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("心率血氧记录数") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.dataReadyStatus.value.heartRateCount
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("睡眠记录数") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.dataReadyStatus.value.sleepCount
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("RTC时间") }}</cl-text>
						<cl-text color="white" :size="14">{{ deviceStore.rtcTime.value }}</cl-text>
					</view>
				</view>
			</view>

			<!-- 历史数据查询 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("历史数据查询") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#777"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testQueryDataReady"
				>
					{{ t("查询数据状态") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#777"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetDeviceTime"
				>
					{{ t("获取RTC时间") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#777"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetHistoricalData"
				>
					{{ t("获取心率血氧历史") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#777"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetSleepData"
				>
					{{ t("获取睡眠数据") }}
				</cl-button>
			</view>

			<!-- 睡眠数据测试 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("睡眠数据测试") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#666"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testGetSleepDataByIndex"
				>
					{{ t("获取第N条睡眠") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#777"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testUploadSleepData"
				>
					{{ t("上传睡眠数据") }}
				</cl-button>
			</view>

			<!-- 设备控制 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("设备控制") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#888"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testShutdown"
				>
					{{ t("设备关机") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#888"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testSetDeviceTime"
				>
					{{ t("设置RTC时间") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#888"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testEndSleep"
				>
					{{ t("结束睡眠判断") }}
				</cl-button>
			</view>

			<!-- 数据库操作 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("数据库操作") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#999"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testClearDatabase"
				>
					{{ t("清空数据库") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#aaa"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testDeleteDatabase"
				>
					{{ t("删除数据库") }}
				</cl-button>
			</view>
		</scroll-view>
	</cl-popup>
</template>

<script lang="ts" setup>
import { t, useStore } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { bluetoothDataManager } from "@/.cool/bluetooth";

const ui = useUi();
const { device: deviceStore } = useStore();

const show = defineModel("show", {
	default: false
});

async function testReadBloodOxygen() {
	ui.showToast({ message: t("读取中..."), type: "warn" });
	await deviceStore.readBloodOxygen();
}

async function toggleDevice() {
	await deviceStore.toggleDeviceStatus();
}

async function subscribeHeartRate() {
	deviceStore.subscribeHeartRate();
}

async function testDisconnect() {
	ui.showToast({ message: t("断开连接中..."), type: "warn" });
	deviceStore.disconnectDevice();
}

function testReconnect() {
	ui.showToast({ message: t("测试重连..."), type: "warn" });
	deviceStore.reconnect();
}

async function testReadBattery() {
	ui.showToast({ message: t("读取电池..."), type: "warn" });
	await deviceStore.readCharacteristic(
		"0000180f-0000-1000-8000-00805f9b34fb",
		"00002a19-0000-1000-8000-00805f9b34fb"
	);
}

function testGetLEDStatus() {
	ui.showToast({ message: t("获取LED状态..."), type: "warn" });
	deviceStore.getLEDStatus();
}

function testGetDeviceInfo() {
	const info = {
		status: deviceStore.status.value,
		deviceId: deviceStore.currentDeviceId,
		services: deviceStore.services.length,
		characteristics: deviceStore.characteristics.size,
		heartRate: deviceStore.heartRate.value,
		bloodOxygen: deviceStore.bloodOxygen.value,
		battery: deviceStore.battery.value,
		ppi: deviceStore.ppi.value
	};
	console.log("设备信息:", info);
	ui.showToast({ message: t("设备信息已输出到控制台"), type: "success" });
}

function testClearError() {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}

async function testQueryDataReady() {
	ui.showToast({ message: t("查询数据状态..."), type: "warn" });
	const result = await deviceStore.queryDataReadyStatus();
	if (result) {
		ui.showToast({ message: t("查询成功"), type: "success" });
	} else {
		ui.showToast({ message: t("查询失败"), type: "error" });
	}
}

async function testGetDeviceTime() {
	ui.showToast({ message: t("获取RTC时间..."), type: "warn" });
	const result = await deviceStore.getDeviceTime();
	if (result) {
		ui.showToast({ message: t("获取成功"), type: "success" });
	} else {
		ui.showToast({ message: t("获取失败"), type: "error" });
	}
}

async function testGetHistoricalData() {
	ui.showToast({ message: t("获取心率血氧历史..."), type: "warn" });
	const result = await deviceStore.getHistoricalHeartRateData(0);
	if (result) {
		console.log("历史数据:", deviceStore.historicalHeartRateData.value);
		ui.showToast({ message: t("获取成功"), type: "success" });
	} else {
		ui.showToast({ message: t("获取失败"), type: "error" });
	}
}

async function testGetSleepData() {
	ui.showToast({ message: t("获取睡眠数据..."), type: "warn" });
	const result = await deviceStore.getSleepData(0);
	if (result) {
		console.log("睡眠数据:", deviceStore.sleepData.value);
		ui.showToast({ message: t("获取成功"), type: "success" });
	} else {
		ui.showToast({ message: t("获取失败"), type: "error" });
	}
}

async function testShutdown() {
	ui.showToast({ message: t("设备关机..."), type: "warn" });
	const result = await deviceStore.shutdownDevice();
	if (result) {
		ui.showToast({ message: t("关机命令发送成功"), type: "success" });
	} else {
		ui.showToast({ message: t("关机命令发送失败"), type: "error" });
	}
}

async function testSetDeviceTime() {
	ui.showToast({ message: t("设置RTC时间..."), type: "warn" });
	const timestamp = Math.floor(Date.now() / 1000);
	console.log("当前时间戳:", timestamp);
	const result = await deviceStore.setDeviceTime(timestamp);
	if (result) {
		ui.showToast({ message: t("设置成功") + timestamp, type: "success" });
	} else {
		ui.showToast({ message: t("设置失败"), type: "error" });
	}
}

async function testEndSleep() {
	ui.showToast({ message: t("结束睡眠判断..."), type: "warn" });
	const result = await deviceStore.endSleepJudgment();
	if (result) {
		ui.showToast({ message: t("命令发送成功"), type: "success" });
	} else {
		ui.showToast({ message: t("命令发送失败"), type: "error" });
	}
}

async function testClearDatabase() {
	ui.showToast({ message: t("清空数据库..."), type: "warn" });
	await bluetoothDataManager.clearAllData();
	ui.showToast({ message: t("数据库已清空"), type: "success" });
}

async function testDeleteDatabase() {
	ui.showToast({ message: t("删除数据库..."), type: "warn" });
	await bluetoothDataManager.clearAllData();
	ui.showToast({ message: t("数据库已删除"), type: "success" });
}

async function testGetSleepDataByIndex() {
	const index = 0;
	ui.showToast({ message: t("获取睡眠数据...") + index, type: "warn" });
	const result = await deviceStore.getSleepData(index);
	if (result) {
		console.log("睡眠数据:", deviceStore.sleepData.value);
		ui.showToast({ message: t("获取成功"), type: "success" });
	} else {
		ui.showToast({ message: t("获取失败"), type: "error" });
	}
}

async function testUploadSleepData() {
	ui.showToast({ message: t("上传睡眠数据..."), type: "warn" });
	const result = await bluetoothDataManager.uploadSleepData();
	if (result) {
		ui.showToast({ message: t("上传成功"), type: "success" });
	} else {
		ui.showToast({ message: t("上传失败"), type: "error" });
	}
}
</script>
