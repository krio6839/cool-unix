<template>
	<cl-popup v-model="show" :title="t('BOOM 设备测试')" direction="bottom" :size="700">
		<scroll-view class="p-4 flex flex-col" scroll-y="true" style="height: 100%">
			<!-- Mock 模拟（无设备时使用） -->
			<view class="mb-4 p-3 bg-blue-900 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("Mock 模拟（无设备时使用）") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<cl-button
						type="primary"
						:color="deviceStore.useMock ? '#900' : '#06f'"
						rounded
						size="small"
						class="mr-2 mb-2"
						@tap="toggleMock"
					>
						{{ deviceStore.useMock ? t("停止 Mock") : t("启动 Mock") }}
					</cl-button>
				</view>
				<cl-text color="gray-300" :size="12">
					{{ t("启动后：每 1s 推送 0x50 实时广播 + 8 个 GATT 命令直接看到 event 更新") }}
				</cl-text>
			</view>

			<!-- 设备状态 -->
			<view class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("BOOM 协议状态") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("固件版本") }}</cl-text>
						<cl-text color="white" :size="14">{{ fwText }}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("设备编号") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.event.deviceNumber
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("BOOM 时戳") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.event.boomTimestamp
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("生物识别") }}</cl-text>
						<cl-text color="white" :size="12">{{ bioText }}</cl-text>
					</view>
				</view>
			</view>

			<!-- 0x50 实时广播 -->
			<view class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("0x50 实时广播") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("心率") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.hr }} bpm</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("血氧") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.spo2 }} %</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("电池电压") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.voltage }} V</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("PPI") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.ppi }} ms</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("PPG 佩戴") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.ppgAttached }}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("行为 / 活动") }}</cl-text>
						<cl-text color="white" :size="14">
							{{ rtText.behavior }} / {{ rtText.activity }}
						</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("基础心率") }}</cl-text>
						<cl-text color="white" :size="14">{{ rtText.bhr }} bpm</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("上次接收") }}</cl-text>
						<cl-text color="white" :size="12">{{ rtText.receivedAt }}</cl-text>
					</view>
				</view>
			</view>

			<!-- BOOM GATT 协议测试（8 个按钮） -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("BOOM GATT 协议测试") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadFirmware"
				>
					{{ t("0x30 读固件") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadDeviceNumber"
				>
					{{ t("0x32 读设备编号") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadTimestamp"
				>
					{{ t("0x34 读时戳") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#444"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadBiometric"
				>
					{{ t("0x36 读生物识别") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#666"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testSetDeviceNumber"
				>
					{{ t("0x31 写设备编号") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#666"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testSetTimestamp"
				>
					{{ t("0x33 写时戳") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#666"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testSetBiometric"
				>
					{{ t("0x35 写生物识别") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#888"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testVibration"
				>
					{{ t("0x40 震动马达") }}
				</cl-button>
			</view>

			<!-- 历史数据（0x3A/0x3B/0x3C/0x3D，4 个按钮） -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("历史数据（v5 新增）") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#0a0"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadVitalData"
				>
					{{ t("0x3A 读生命体征") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#0a0"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testContinueReadVital"
				>
					{{ t("0x3B 续读生命体征") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#a00"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReadEventData"
				>
					{{ t("0x3C 读事件") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#a00"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testContinueReadEvent"
				>
					{{ t("0x3D 续读事件") }}
				</cl-button>
			</view>

			<!-- 0x3A 生命体征响应展示区 -->
			<view v-if="hasVitalData" class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("0x3A 生命体征响应") }}
				</cl-text>
				<view class="mb-2">
					<cl-text color="gray-400" :size="12">
						{{ t("起始时戳 / 方向 / 分钟数") }}: {{ vitalText.start }}
					</cl-text>
				</view>
				<view class="mb-2">
					<cl-text color="gray-400" :size="12">
						{{ t("RMSSD/SDNN") }}: {{ vitalText.rmssdSdnn }}
					</cl-text>
				</view>
				<view>
					<cl-text color="gray-400" :size="12">
						{{ t("逐秒数据 (前 30 条)") }}: {{ vitalText.vital }}
					</cl-text>
				</view>
			</view>

			<!-- 0x3C/0x3D 事件响应展示区 -->
			<view v-if="hasEventData" class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("0x3C 事件响应") }}
				</cl-text>
				<view class="mb-2">
					<cl-text color="gray-400" :size="12">
						{{ t("事件头") }}: {{ eventText.header }}
					</cl-text>
				</view>
				<view>
					<cl-text color="gray-400" :size="12">
						{{ t("事件列表 (前 10 条)") }}: {{ eventText.items }}
					</cl-text>
				</view>
			</view>

			<!-- 设备控制 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("设备控制") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#333"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testDisconnect"
				>
					{{ t("断开连接") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#333"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testReconnect"
				>
					{{ t("测试重连") }}
				</cl-button>
				<cl-button
					type="primary"
					color="#555"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="testClearError"
				>
					{{ t("清除错误") }}
				</cl-button>
			</view>
		</scroll-view>
	</cl-popup>
</template>

<script lang="ts" setup>
//#ifndef H5
import { computed } from "vue";
import { DEVICE_NUMBER_MAX_LEN, LOG_EVENT_NAMES, t, useStore } from "@/.cool";
import type { VibrationSpec, VitalBiometric } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";

/* 0x50 实时数据展示用 computed 类型（9 字段全部 string） */
type RtText = {
	hr: string;
	spo2: string;
	voltage: string;
	ppi: string;
	ppgAttached: string;
	behavior: string;
	activity: string;
	bhr: string;
	receivedAt: string;
};

const ui = useUi();
const { device: deviceStore } = useStore();

const show = defineModel("show", {
	default: false
});

/* ===== 展示用 computed ===== */

const fwText = computed<string>(() => {
	const f = deviceStore.event.firmwareVersion.value;
	if (f == null) return "-";
	return `${f.major}.${f.minor}.${f.revision}`;
});

const bioText = computed<string>(() => {
	const b = deviceStore.event.biometricInfo.value;
	if (b == null) return "-";
	return `性别${b.gender} 体重${b.weight} 身高${b.height} 年龄${b.age} PPG${b.ppgPosition} BHR${b.bhr}`;
});

const rtText = computed<RtText>(() => {
	const r = deviceStore.realtime.value;
	if (r == null) {
		return {
			hr: "-",
			spo2: "-",
			voltage: "-",
			ppi: "-",
			ppgAttached: "-",
			behavior: "-",
			activity: "-",
			bhr: "-",
			receivedAt: "-"
		};
	}
	return {
		hr: r.hr.toString(),
		spo2: r.spo2Pct.toFixed(1),
		voltage: (r.voltageMv / 100).toFixed(2),
		ppi: r.ppi.toString(),
		ppgAttached: r.ppgAttached ? t("已佩戴") : t("未佩戴"),
		behavior: r.behavior.toString(),
		activity: r.activity.toString(),
		bhr: r.bhr.toString(),
		receivedAt: new Date(r.receivedAt).toLocaleTimeString()
	};
});

/* ===== 8 个协议测试按钮 ===== */

async function testReadFirmware(): Promise<void> {
	ui.showToast({ message: t("0x30 发送..."), type: "warn" });
	const ok = await deviceStore.protocol.readFirmwareVersion();
	ui.showToast({ message: ok ? t("已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testReadDeviceNumber(): Promise<void> {
	ui.showToast({ message: t("0x32 发送..."), type: "warn" });
	const ok = await deviceStore.protocol.readDeviceNumber();
	ui.showToast({ message: ok ? t("已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testReadTimestamp(): Promise<void> {
	ui.showToast({ message: t("0x34 发送..."), type: "warn" });
	const ok = await deviceStore.protocol.readTimestamp();
	ui.showToast({ message: ok ? t("已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testReadBiometric(): Promise<void> {
	ui.showToast({ message: t("0x36 发送..."), type: "warn" });
	const ok = await deviceStore.protocol.readBiometric();
	ui.showToast({ message: ok ? t("已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testSetDeviceNumber(): Promise<void> {
	// 弹窗手动输入设备编号（最多 29 位数字/字母）
	uni.showModal({
		title: t("设置设备编号"),
		placeholderText: t("请输入设备编号（最多29位）"),
		editable: true,
		success: (res) => {
			if (res.confirm && res.content != null) {
				const num = res.content?.trim() ?? "";
				if (num.length == 0 || num.length > DEVICE_NUMBER_MAX_LEN) {
					ui.showToast({ message: t("编号长度需 1~29 位"), type: "error" });
					return;
				}
				deviceStore.protocol.setDeviceNumber(num).then((ok) => {
					ui.showToast({
						message: ok ? t("0x31 已发送") : t("失败"),
						type: ok ? "success" : "error"
					});
				});
			}
		}
	});
}

async function testSetTimestamp(): Promise<void> {
	const ok = await deviceStore.protocol.setTimestamp(Math.floor(Date.now() / 1000));
	ui.showToast({ message: ok ? t("0x33 已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testSetBiometric(): Promise<void> {
	// 固定测试值：男 6837(68.37kg) 17500(175cm) 30 岁 PPG=0(手腕) BHR=70
	const b: VitalBiometric = {
		gender: 0,
		weight: 6837,
		height: 17500,
		age: 30,
		ppgPosition: 0,
		bhr: 70
	};
	const ok = await deviceStore.protocol.setBiometric(b);
	ui.showToast({ message: ok ? t("0x35 已发送") : t("失败"), type: ok ? "success" : "error" });
}

async function testVibration(): Promise<void> {
	// loops=1, count=3, 5 段 on/off: [200ms震, 100ms静, 200ms震, 100ms静, 200ms震]
	const spec: VibrationSpec = {
		loops: 1,
		count: 3,
		onOffMs: [200, 100, 200, 100, 200]
	};
	const ok = await deviceStore.protocol.controlVibration(spec);
	ui.showToast({ message: ok ? t("0x40 已发送") : t("失败"), type: ok ? "success" : "error" });
}

/* ===== 历史数据测试按钮（v5 新增） ===== */

async function testReadVitalData(): Promise<void> {
	uni.showModal({
		title: t("0x3A 读生命体征"),
		editable: true,
		placeholderText: t("startSec(秒) | dir(0/1) | minutes(2/5)，如 1783000000|0|2"),
		success: (res) => {
			if (res.confirm && res.content != null) {
				const parts = (res.content ?? "").split("|");
				if (parts.length < 3) {
					ui.showToast({ message: t("格式错误"), type: "error" });
					return;
				}
				const startSec = parseInt(parts[0] ?? "0", 10);
				const direction = parseInt(parts[1] ?? "0", 10);
				const minutes = parseInt(parts[2] ?? "2", 10);
				deviceStore.protocol
					.readVitalData({ startSec, direction, minutes })
					.then((ok) => {
						ui.showToast({
							message: ok ? t("0x3A 已发送") : t("失败"),
							type: ok ? "success" : "error"
						});
					});
			}
		}
	});
}

async function testContinueReadVital(): Promise<void> {
	uni.showModal({
		title: t("0x3B 续读生命体征"),
		editable: true,
		placeholderText: t("minutes 只能是 2 或 5"),
		success: (res) => {
			if (res.confirm && res.content != null) {
				const minutes = parseInt(res.content ?? "2", 10);
				deviceStore.protocol.continueReadVitalData(minutes).then((ok) => {
					ui.showToast({
						message: ok ? t("0x3B 已发送") : t("失败"),
						type: ok ? "success" : "error"
					});
				});
			}
		}
	});
}

async function testReadEventData(): Promise<void> {
	uni.showModal({
		title: t("0x3C 读事件"),
		editable: true,
		placeholderText: t("type(0/1) | startSec | endSec，如 0|1783000000|1784000000"),
		success: (res) => {
			if (res.confirm && res.content != null) {
				const parts = (res.content ?? "").split("|");
				if (parts.length < 3) {
					ui.showToast({ message: t("格式错误"), type: "error" });
					return;
				}
				const type = parseInt(parts[0] ?? "0", 10);
				const startSec = parseInt(parts[1] ?? "0", 10);
				const endSec = parseInt(parts[2] ?? "0", 10);
				deviceStore.protocol
					.readEventData({ type, startSec, endSec })
					.then((ok) => {
						ui.showToast({
							message: ok ? t("0x3C 已发送") : t("失败"),
							type: ok ? "success" : "error"
						});
					});
			}
		}
	});
}

async function testContinueReadEvent(): Promise<void> {
	uni.showModal({
		title: t("0x3D 续读事件"),
		editable: true,
		placeholderText: t("maxCount 最多条数，如 10"),
		success: (res) => {
			if (res.confirm && res.content != null) {
				const maxCount = parseInt(res.content ?? "10", 10);
				deviceStore.protocol.continueReadEventData(maxCount).then((ok) => {
					ui.showToast({
						message: ok ? t("0x3D 已发送") : t("失败"),
						type: ok ? "success" : "error"
					});
				});
			}
		}
	});
}

/* ===== v5 历史数据展示用 computed ===== */

type VitalText = {
	start: string;
	rmssdSdnn: string;
	vital: string;
};
type EventText = {
	header: string;
	items: string;
};

const vitalText = computed<VitalText>(() => {
	const r = deviceStore.event.vitalDataResponse.value;
	if (r == null) {
		return { start: "-", rmssdSdnn: "-", vital: "-" };
	}
	const start = `${r.startSec} / ${r.direction} / ${r.n}min`;
	const rmssdSdnn = r.rmssdSdnn
		.slice(0, 10)
		.map((p) => (p.valid == true ? `${p.rmssd}|${p.sdnn}` : "FF"))
		.join(",");
	const vital = r.vitalData
		.slice(0, 30)
		.map((d) => (d.valid == true ? `t+${d.hr}bpm` : "—"))
		.join(" ");
	return { start, rmssdSdnn, vital };
});

const hasVitalData = computed<boolean>(() => {
	return deviceStore.event.vitalDataResponse.value != null;
});

const eventText = computed<EventText>(() => {
	const h = deviceStore.event.eventDataHeader.value;
	const list = deviceStore.event.eventDataList.value;
	if (h == null && list.length == 0) {
		return { header: "-", items: "-" };
	}
	const header = h == null
		? "-"
		: `type=${h.type} sn[${h.earliestSn}~${h.latestSn}] ts[${h.earliestSec}~${h.latestSec}]`;
	const items = list
		.slice(0, 10)
		.map((it) => {
			const typeName = LOG_EVENT_NAMES[it.eventType] ?? "?";
			return `sn=${it.header.sn} ${typeName} ts=${it.ts}`;
		})
		.join("\n");
	return { header, items };
});

const hasEventData = computed<boolean>(() => {
	const h = deviceStore.event.eventDataHeader.value;
	const list = deviceStore.event.eventDataList.value;
	return h != null || list.length > 0;
});

/* ===== 设备控制 ===== */

function testDisconnect(): void {
	deviceStore.connection.disconnectDevice();
}

function testReconnect(): void {
	ui.showToast({ message: t("测试重连..."), type: "warn" });
	deviceStore.connection.reconnect();
}

function testClearError(): void {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}

/* ===== Mock 模拟（无设备时使用） ===== */

function toggleMock(): void {
	if (deviceStore.useMock) {
		deviceStore.stopMock();
		ui.showToast({ message: t("Mock 已停止"), type: "success" });
	} else {
		deviceStore.startMock();
		ui.showToast({ message: t("Mock 已启动，1s 后开始推送广播"), type: "success" });
	}
}
//#endif
</script>
