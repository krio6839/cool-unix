} from "@/.cool";
import type { PpgPositionOption } from "@/.cool";
import { useUi, type ClSelectOption } from "@/uni_modules/cool-ui";

/* 0x50 实时数据展示用 computed 类型（9 字段全部 string） */
type RtText = {
	hr: string;
	spo2: string;
	voltage: string;
	ppi: string;
	ppgAttached: string;
	behavior: string;
	activity: string;
	bhr: string;
	receivedAt: string;
};

const ui = useUi();
const { device: deviceStore } = useStore();

const show = defineModel("show", {
	default: false
});

/* ===== 展示用 computed ===== */

function formatBiometric(b: VitalBiometric): string {
	return `性别${b.gender} 体重${(b.weight / 100).toFixed(2)}kg 身高${(b.height / 100).toFixed(2)}cm 年龄${b.age} PPG${b.ppgPosition} BHR${b.bhr}`;
}

const fwText = computed<string>(() => {
	const f = deviceStore.event.firmwareVersion.value;
	if (f == null) return "-";
	return `${f.major}.${f.minor}.${f.revision}`;
});

const bioText = computed<string>(() => {
	const b = deviceStore.event.biometricInfo.value;
	if (b == null) return "-";
	return formatBiometric(b);
});

function sameBiometric(a: VitalBiometric | null, b: VitalBiometric): boolean {
	if (a == null) return false;
	return (
		a.gender == b.gender &&
		a.weight == b.weight &&
		a.height == b.height &&
		a.age == b.age &&
		a.ppgPosition == b.ppgPosition &&
		a.bhr == b.bhr
	);
}

function isAlphaNumeric(value: string): boolean {
	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i) ?? 0;
		const isNumber = code >= 48 && code <= 57;
		const isUpper = code >= 65 && code <= 90;
		const isLower = code >= 97 && code <= 122;
		if (isNumber == false && isUpper == false && isLower == false) return false;
	}
	return true;
}

const rtText = computed<RtText>(() => {
	const r = deviceStore.realtime.value;
	if (r == null) {
		return {
			hr: "-",
			spo2: "-",
			voltage: "-",
			ppi: "-",
			ppgAttached: "-",
			behavior: "-",
			activity: "-",
			bhr: "-",
			receivedAt: "-"
		};
	}
	return {
		hr: r.hr.toString(),
		spo2: r.spo2Pct.toFixed(1),
		voltage: (r.voltageMv / 100).toFixed(2),
		ppi: r.ppi.toString(),
		ppgAttached: r.ppgAttached ? t("已佩戴") : t("未佩戴"),
		behavior: r.behavior.toString(),
		activity: r.activity.toString(),
		bhr: r.bhr.toString(),
		receivedAt: new Date(r.receivedAt).toLocaleTimeString()
	};
});

/* ===== 响应展示 ref + 11 个 computed ===== */

/** 每个 T 码的响应摘要（key 为十六进制字符串，如 "0x30"） */
type LastResponse = Record<string, string>;
const lastResponse = reactive<LastResponse>({});
const activeCommand = ref<string>("");

function getResp(cmd: string): string {
	const v = lastResponse[cmd];
	return v == null || v == "" ? "-" : v;
}

const protocolReady = computed<boolean>(() => {
	return (
		deviceStore.status.value == "CONNECTED" &&
		deviceStore.protocol.writeCharUuid != "" &&
		deviceStore.protocol.notifyCharUuid != ""
	);
});

const protocolReadyText = computed<string>(() => {
	if (deviceStore.status.value != "CONNECTED") return t("设备未连接，测试命令暂不可用");
	if (deviceStore.protocol.writeCharUuid == "") return t("未发现写入特征，请重新连接设备");
	if (deviceStore.protocol.notifyCharUuid == "") return t("未发现通知特征，请重新连接设备");
	return t("协议已就绪，可以发送测试命令");
});

function isCommandDisabled(cmd: string): boolean {
	return protocolReady.value == false || activeCommand.value != "";
}

function setCommandResponse(cmd: string, message: string): void {
	const time = new Date().toLocaleTimeString();
	lastResponse[cmd] = `${time} ${message}`;
}

function beginCommand(cmd: string): boolean {
	if (protocolReady.value == false) {
		ui.showToast({ message: protocolReadyText.value, type: "warn" });
		return false;
	}
	if (activeCommand.value != "") {
		ui.showToast({ message: t("已有命令发送中，请稍候"), type: "warn" });
		return false;
	}
	activeCommand.value = cmd;
	setCommandResponse(cmd, t("发送中..."));
	return true;
}

function endCommand(cmd: string): void {
	if (activeCommand.value == cmd) {
		activeCommand.value = "";
	}
}

function sleep(ms: number): Promise<void> {
	return new Promise<void>((resolve) => {
		setTimeout(() => {
			resolve();
		}, ms);
	});
}

async function waitForBiometric(
	beforeSeq: number,
	sentAt: number,
	expected: VitalBiometric | null,
	timeoutMs: number
): Promise<VitalBiometric | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.biometricInfo.value;
		if (current != null) {
			if (expected != null && sameBiometric(current, expected)) return current;
			if (
				expected == null &&
				(deviceStore.event.biometricInfoSeq.value > beforeSeq ||
					deviceStore.event.biometricInfoReceivedAt.value >= sentAt)
			) {
				return current;
			}
		}
		await sleep(150);
	}
	return null;
}

async function waitForVibration(
	before: VibrationResult | null,
	timeoutMs: number
): Promise<VibrationResult | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.lastVibration.value;
		if (current != null && current !== before) return current;
		await sleep(150);
	}
	return null;
}

const fwResp = computed<string>(() => getResp("0x30"));
const devNumResp = computed<string>(() => getResp("0x32"));
const tsResp = computed<string>(() => getResp("0x34"));
const bioResp = computed<string>(() => getResp("0x36"));
const setDevNumResp = computed<string>(() => getResp("0x31"));
const setTsResp = computed<string>(() => getResp("0x33"));
const setBioResp = computed<string>(() => getResp("0x35"));
const vibResp = computed<string>(() => getResp("0x40"));
const vitalResp = computed<string>(() => getResp("0x3A"));
const vitalContResp = computed<string>(() => getResp("0x3B"));
const eventResp = computed<string>(() => getResp("0x3C"));
const eventContResp = computed<string>(() => getResp("0x3D"));
const pendingVitalCommand = ref<"" | "0x3A" | "0x3B">("");

/* ===== 参数输入子弹窗状态 ===== */

/** 当前打开的表单类型（空=未打开） */
const activeForm = ref<"" | "0x31" | "0x35" | "0x3A" | "0x3B" | "0x3C" | "0x3D">("");
/** 子弹窗显示控制（v-model 双向绑定） */
const formVisible = ref(false);

const formTitle = computed<string>(() => {
	switch (activeForm.value) {
		case "0x31":
			return t("设置设备编号");
		case "0x35":
			return t("0x35 写生物识别");
		case "0x3A":
			return t("0x3A 读生命体征");
		case "0x3B":
			return t("0x3B 续读生命体征");
		case "0x3C":
			return t("0x3C 读事件");
		case "0x3D":
			return t("0x3D 续读事件");
		default:
			return "";
	}
});

/** 表单数据（按字段分独立 ref，避免 Ref<T, S> 联合类型推断问题） */
const formDeviceNumber = ref<string>("");
const formStartSec = ref<string>("0");
const formEndSec = ref<string>("0");
const formMaxCount = ref<string>("10");
const formDirection = ref<number>(0);
const formMinutes = ref<number>(2);
const formType = ref<number>(0);
// 0x35 生物识别表单字段
const formGender = ref<number>(0);
const formWeight = ref<string>("7000");
const formHeight = ref<string>("18000");
const formAge = ref<string>("20");
const formPpgPosition = ref<number>(0);
const formBhr = ref<string>("60");

/** 方向选项（0=向前 1=向后） */
const directionOptions: ClSelectOption[] = [
	{ label: t("向前 (0)"), value: 0 },
	{ label: t("向后 (1)"), value: 1 }
];

/** 分钟数选项（2 / 5） */
const minutesOptions: ClSelectOption[] = [
	{ label: t("2 分钟"), value: 2 },
	{ label: t("5 分钟"), value: 5 }
];

/** 事件类型选项（0=ALL 1=BY_TIME） */
const eventTypeOptions: ClSelectOption[] = [
	{ label: t("全部 (0)"), value: 0 },
	{ label: t("按时间 (1)"), value: 1 }
];

/** 性别选项（0=男 1=女） */
const genderOptions: ClSelectOption[] = [
	{ label: t("男 (0)"), value: 0 },
	{ label: t("女 (1)"), value: 1 }
];

/** PPG 位置选项（0~6，与协议 UINT8 保持一致） */
const ppgPositionOptions: ClSelectOption[] = PPG_POSITION_OPTIONS.map(
	(item: PpgPositionOption): ClSelectOption => ({
		label: `${t(item.label)} (${item.value})`,
		value: item.value
	})
);

/** 当前表单可用的文档示例（按 T 码查 DOC_EXAMPLES_BY_T） */
const exampleList = computed<DocExample[]>(() => {
	if (activeForm.value == "") return [];
	const tCode = parseInt(activeForm.value, 16);
	return DOC_EXAMPLES_BY_T.get(tCode) ?? [];
});

/** 打开子弹窗并重置默认值 */
function openForm(cmd: "0x31" | "0x35" | "0x3A" | "0x3B" | "0x3C" | "0x3D"): void {
	const now = Math.floor(Date.now() / 1000);
	switch (cmd) {
		case "0x31":
			formDeviceNumber.value = "";
			break;
		case "0x35":
			formGender.value = 0;
			formWeight.value = "7000";
			formHeight.value = "18000";
			formAge.value = "20";
			formPpgPosition.value = 0;
			formBhr.value = "60";
			break;
		case "0x3A":
			formStartSec.value = (now - 120).toString();
			formDirection.value = 0;
			formMinutes.value = 2;
			break;
		case "0x3B":
			formMinutes.value = 2;
			break;
		case "0x3C":
			formType.value = 0;
			formStartSec.value = (now - 3600).toString();
			formEndSec.value = now.toString();
			break;
		case "0x3D":
			formMaxCount.value = "10";
			break;
	}
	activeForm.value = cmd;
	formVisible.value = true;
}

/** 关闭子弹窗 */
function closeForm(): void {
	formVisible.value = false;
	activeForm.value = "";
}

/** 提交表单（按 activeForm 分派） */
async function submitForm(): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	if (!beginCommand(cmd)) return;
	let shouldClose = false;
	try {
		switch (cmd) {
			case "0x31": {
				const num = formDeviceNumber.value.trim();
				if (num.length == 0 || num.length > DEVICE_NUMBER_MAX_LEN) {
					ui.showToast({ message: t("编号长度需 1~29 位"), type: "error" });
					return;
				}
				if (isAlphaNumeric(num) == false) {
					ui.showToast({ message: t("设备编号只能包含数字和字母"), type: "error" });
					return;
				}
				ui.showToast({ message: t("0x31 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setDeviceNumber(num);
				setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x31 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = ok;
				break;
			}
			case "0x35": {
				const w = parseInt(formWeight.value, 10);
				const h = parseInt(formHeight.value, 10);
				const a = parseInt(formAge.value, 10);
				const b = parseInt(formBhr.value, 10);
				if (Number.isNaN(w) || w < 1000 || w > 65000) {
					ui.showToast({ message: t("体重需 1000~65000"), type: "error" });
					return;
				}
				if (Number.isNaN(h) || h < 10000 || h > 28000) {
					ui.showToast({ message: t("身高需 10000~28000"), type: "error" });
					return;
				}
				if (Number.isNaN(a) || a < 10 || a > 99) {
					ui.showToast({ message: t("年龄需 10~99"), type: "error" });
					return;
				}
				if (Number.isNaN(b) || b < 28 || b > 240) {
					ui.showToast({ message: t("BHR 需 28~240"), type: "error" });
					return;
				}
				const req: VitalBiometric = {
					gender: formGender.value,
					weight: w,
					height: h,
					age: a,
					ppgPosition: formPpgPosition.value,
					bhr: b
				};
				const beforeSeq = deviceStore.event.biometricInfoSeq.value;
				const sentAt = Date.now();
				ui.showToast({ message: t("0x35 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setBiometric(req);
				if (!ok) {
					setCommandResponse(cmd, t("发送失败，请重试"));
					ui.showToast({ message: t("发送失败"), type: "error" });
					return;
				}
				setCommandResponse(cmd, t("已发送，等待设备确认"));
				const confirmed = await waitForBiometric(beforeSeq, sentAt, req, 2500);
				if (confirmed != null) {
					setCommandResponse(cmd, `${t("设备已确认")} ${formatBiometric(confirmed)}`);
					ui.showToast({ message: t("设备已确认写入"), type: "success" });
				} else {
					setCommandResponse(cmd, t("已发送，但未收到 0x35 确认"));
					ui.showToast({ message: t("未收到写入确认，可手动读回验证"), type: "warn" });
				}
				setCommandResponse("0x36", t("如需验证，请手动点击 0x36 读生物识别"));
				shouldClose = true;
				break;
			}
			case "0x3A": {
				const startSec = parseInt(formStartSec.value, 10);
				if (Number.isNaN(startSec) || startSec <= 0) {
					ui.showToast({ message: t("起始时戳必须是正数"), type: "error" });
					return;
				}
				ui.showToast({ message: t("0x3A 发送..."), type: "warn" });
				const req: VitalDataQueryRequest = {
					startSec,
					direction: formDirection.value,
					minutes: formMinutes.value
				};
				pendingVitalCommand.value = "0x3A";
				const ok = await deviceStore.protocol.readVitalData(req);
				if (!ok && pendingVitalCommand.value == "0x3A") pendingVitalCommand.value = "";
				setCommandResponse(cmd, ok ? t("已请求，等待响应") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x3A 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = ok;
				break;
			}
			case "0x3B": {
				ui.showToast({ message: t("0x3B 发送..."), type: "warn" });
				pendingVitalCommand.value = "0x3B";
				const ok = await deviceStore.protocol.continueReadVitalData(formMinutes.value);
				if (!ok && pendingVitalCommand.value == "0x3B") pendingVitalCommand.value = "";
				setCommandResponse(cmd, ok ? t("已请求，等待响应") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x3B 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = ok;
				break;
			}
			case "0x3C": {
				const startSec = parseInt(formStartSec.value, 10);
				const endSec = parseInt(formEndSec.value, 10);
				if (
					Number.isNaN(startSec) ||
					startSec <= 0 ||
					Number.isNaN(endSec) ||
					endSec <= 0
				) {
					ui.showToast({ message: t("起止时戳必须是正数"), type: "error" });
					return;
				}
				if (endSec <= startSec) {
					ui.showToast({ message: t("结束时戳必须大于起始时戳"), type: "error" });
					return;
				}
				ui.showToast({ message: t("0x3C 发送..."), type: "warn" });
				const req: EventDataQuery = {
					type: formType.value,
					startSec,
					endSec
				};
				const ok = await deviceStore.protocol.readEventData(req);
				setCommandResponse(cmd, ok ? t("已请求，等待响应") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x3C 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = ok;
				break;
			}
			case "0x3D": {
				const maxCount = parseInt(formMaxCount.value, 10);
				if (Number.isNaN(maxCount) || maxCount <= 0) {
					ui.showToast({ message: t("最大条数必须是正数"), type: "error" });
					return;
				}
				ui.showToast({ message: t("0x3D 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.continueReadEventData(maxCount);
				setCommandResponse(cmd, ok ? t("已请求，等待响应") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x3D 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = ok;
				break;
			}
		}
	} finally {
		endCommand(cmd);
	}
	if (shouldClose) closeForm();
}

/* ===== 7 个无参/硬编码协议命令 ===== */

async function testReadFirmware(): Promise<void> {
	const cmd = "0x30";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x30 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readFirmwareVersion();
		const f = deviceStore.event.firmwareVersion.value;
		if (ok && f != null) {
			setCommandResponse(cmd, `${f.major}.${f.minor}.${f.revision}`);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadDeviceNumber(): Promise<void> {
	const cmd = "0x32";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x32 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readDeviceNumber();
		const num = deviceStore.event.deviceNumber.value;
		if (ok && num != "") {
			setCommandResponse(cmd, num);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadTimestamp(): Promise<void> {
	const cmd = "0x34";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x34 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readTimestamp();
		const sec = deviceStore.event.boomTimestamp.value;
		if (ok && sec > 0) {
			setCommandResponse(cmd, new Date(sec * 1000).toLocaleString());
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadBiometric(): Promise<void> {
	const cmd = "0x36";
	if (!beginCommand(cmd)) return;
	try {
		const beforeSeq = deviceStore.event.biometricInfoSeq.value;
		const sentAt = Date.now();
		ui.showToast({ message: t("0x36 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readBiometric();
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return;
		}
		setCommandResponse(cmd, t("已发送，等待设备响应"));
		const b = await waitForBiometric(beforeSeq, sentAt, null, 2500);
		if (b != null) {
			setCommandResponse(cmd, formatBiometric(b));
			ui.showToast({ message: t("设备已响应"), type: "success" });
		} else {
			setCommandResponse(cmd, t("已发送，但未收到设备响应"));
			ui.showToast({ message: t("未收到设备响应"), type: "warn" });
		}
	} finally {
		endCommand(cmd);
	}
}

async function testSetTimestamp(): Promise<void> {
	const cmd = "0x33";
	if (!beginCommand(cmd)) return;
	try {
		const ok = await deviceStore.protocol.setTimestamp(Math.floor(Date.now() / 1000));
		setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("0x33 已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
	} finally {
		endCommand(cmd);
	}
}

/** 快速发送文档示例（不填表单，直接发 raw 帧） */
async function sendExample(ex: DocExample): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: `${t("发送示例")} ${ex.name}`, type: "warn" });
		if (cmd == "0x3A" || cmd == "0x3B") pendingVitalCommand.value = cmd;
		const ok = await deviceStore.protocol.sendRawFrame(ex.request);
		if (!ok && (cmd == "0x3A" || cmd == "0x3B") && pendingVitalCommand.value == cmd) {
			pendingVitalCommand.value = "";
		}
		setCommandResponse(cmd, ok ? t("示例已发送，等待设备响应") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		if (ok) closeForm();
	} finally {
		endCommand(cmd);
	}
}

async function testVibration(): Promise<void> {
	const cmd = "0x40";
	if (!beginCommand(cmd)) return;
	try {
		const before = deviceStore.event.lastVibration.value;
		// 对齐状态说明 1.4.4.12 示例: loops=1, count=2, 500ms震,1000ms静,800ms震
		const spec: VibrationSpec = {
			loops: 1,
			count: 2,
			onOffMs: [500, 1000, 800]
		};
		setCommandResponse(cmd, t("发送中: 500ms/1000ms/800ms"));
		const ok = await deviceStore.protocol.controlVibration(spec);
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return;
		}
		setCommandResponse(cmd, t("已发送，等待 0x40 响应"));
		const v = await waitForVibration(before, 2500);
		if (v != null) {
			setCommandResponse(cmd, v.code == 0 ? t("code=0 (成功)") : `code=${v.code}`);
			ui.showToast({
				message: v.code == 0 ? t("震动命令成功") : t("震动命令失败"),
				type: v.code == 0 ? "success" : "error"
			});
		} else {
			setCommandResponse(cmd, t("已发送，但未收到 0x40 响应"));
			ui.showToast({ message: t("未收到震动响应"), type: "warn" });
		}
	} finally {
		endCommand(cmd);
	}
}

/* ===== v5 历史数据展示用 computed ===== */

type VitalText = {
	start: string;
	status: string;
	rmssdSdnn: string;
	vital: string;
};
type EventText = {
	header: string;
	items: string;
};

const vitalText = computed<VitalText>(() => {
	const r = deviceStore.event.vitalDataResponse.value;
	if (r == null) {
		return { start: "-", status: "-", rmssdSdnn: "-", vital: "-" };
	}
	const startTime =
		r.startSec > 0 ? new Date(r.startSec * 1000).toLocaleString() : t("无后续数据");
	const directionText =
		r.direction == 0
			? t("向前")
			: r.direction == 1
				? t("向后")
				: `${t("未知")}(${r.direction})`;
	const start = `${r.startSec} (${startTime}) / ${directionText} / ${r.n}min`;
	let validCount = 0;
	let ppiCount = 0;
	for (let i = 0; i < r.vitalData.length; i++) {
		if (r.vitalData[i].valid == true) validCount++;
		if (r.vitalData[i].ppi > 0) ppiCount++;
	}
	const expectedCount = r.n * 60;
	let status = `${validCount}/${r.vitalData.length} ${t("心率有效")}，${ppiCount}/${r.vitalData.length} PPI`;
	if (r.startSec == 0) {
		status = t("设备返回时间戳 0，后面没有数据，不需要续读");
	} else if (r.vitalData.length == 0) {
		status = t("本段无逐秒数据，可点击 0x3B 继续读下一段");
	} else if (r.vitalData.length < expectedCount) {
		status = `${status}；${t("本段数据长度不足，后半段无有效数据，可按需续读")}`;
	} else if (validCount == 0) {
		status = `${status}；${t("本段全为无效或空白数据")}`;
	}
	const rmssdSdnn = r.rmssdSdnn
		.slice(0, 10)
		.map((p, i) =>
			p.valid == true
				? `m${i + 1}:${p.rmssd.toFixed(1)}/${p.sdnn.toFixed(1)}`
				: `m${i + 1}:FF`
		)
		.join(",");
	const vital = r.vitalData
		.slice(0, 30)
		.map((d, i) => {
			if (d.valid == false) return `${i}s:FF`;
			const behavior = (d.status >> 3) & 0x07;
			const activity = d.status & 0x07;
			const ppi = d.ppi > 0 ? `${d.ppi}ms` : "PPI-";
			return `${i}s:${d.hr}bpm/${ppi}/b${behavior}a${activity}`;
		})
		.join(" ");
	return { start, status, rmssdSdnn, vital };
});

const hasVitalData = computed<boolean>(() => {
	return deviceStore.event.vitalDataResponse.value != null;
});

const eventText = computed<EventText>(() => {
	const h = deviceStore.event.eventDataHeader.value;
	const list = deviceStore.event.eventDataList.value;
	if (h == null && list.length == 0) {
		return { header: "-", items: "-" };
	}
	const header =
		h == null
			? "-"
			: `type=${h.type} sn[${h.earliestSn}~${h.latestSn}] ts[${h.earliestSec}~${h.latestSec}]`;
	const items = list
		.slice(0, 10)
		.map((it) => {
			const typeName = LOG_EVENT_NAMES[it.eventType] ?? "?";
			return `sn=${it.header.sn} ${typeName} ts=${it.ts}`;
		})
		.join("\n");
	return { header, items };
});

const hasEventData = computed<boolean>(() => {
	const h = deviceStore.event.eventDataHeader.value;
	const list = deviceStore.event.eventDataList.value;
	return h != null || list.length > 0;
});

watch(deviceStore.event.vitalDataResponse, (r: VitalDataQueryResponse | null) => {
	if (r == null) return;
	let validCount = 0;
	for (let i = 0; i < r.vitalData.length; i++) {
		if (r.vitalData[i].valid == true) validCount++;
	}
	let summary = `${validCount}/${r.vitalData.length} ${t("有效")}`;
	if (r.startSec == 0) {
		summary = t("已到底，无后续数据");
	} else if (r.vitalData.length == 0) {
		summary = t("本段无数据，可续读");
	}
	const cmd = pendingVitalCommand.value == "" ? "0x3A" : pendingVitalCommand.value;
	setCommandResponse(cmd, summary);
	pendingVitalCommand.value = "";
});

watch(deviceStore.event.eventDataHeader, (h: EventDataHeaderResponse | null) => {
	if (h == null) return;
	setCommandResponse(
		"0x3C",
		`type=${h.type} ${t("共")} ${deviceStore.event.eventDataList.value.length} ${t("条")}`
	);
});

/* ===== 设备控制 ===== */

function testDisconnect(): void {
	deviceStore.connection.disconnectDevice();
}

function testReconnect(): void {
	ui.showToast({ message: t("测试重连..."), type: "warn" });
	deviceStore.connection.reconnect();
}

function testClearError(): void {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}
//#endif
</script>
