<template>
	<cl-popup v-model="show" :title="t('BOOM 设备测试')" direction="bottom" :size="620">
		<scroll-view class="p-4 flex flex-col" scroll-y="true" style="height: 100%">
			<!-- 测试模式 -->
			<view class="mb-4 p-3 bg-gray-800 rounded test-mode-panel">
				<view class="flex flex-row items-center justify-between mb-3">
					<view>
						<cl-text color="white" :size="15" :pt="{ className: 'font-bold' }">
							{{ t("测试模式") }}
						</cl-text>
						<cl-text color="gray-400" :size="11">
							{{ testModeText }}
						</cl-text>
					</view>
					<view class="mode-pill">
						<text class="mode-pill-text">{{
							testMode == "broadcast" ? t("广播") : t("连接")
						}}</text>
					</view>
				</view>
				<view class="mode-segment">
					<view
						:class="
							testMode == 'connect'
								? 'segment-option segment-option-active'
								: 'segment-option'
						"
						@tap="switchTestMode('connect')"
					>
						<text class="segment-title">{{ t("连接模式") }}</text>
						<text class="segment-desc">{{ t("GATT / 历史") }}</text>
					</view>
					<view
						:class="
							testMode == 'broadcast'
								? 'segment-option segment-option-active'
								: 'segment-option'
						"
						@tap="switchTestMode('broadcast')"
					>
						<text class="segment-title">{{ t("广播模式") }}</text>
						<text class="segment-desc">{{ t("0x50 实时") }}</text>
					</view>
				</view>
				<view class="auto-restore-row mt-3">
					<view class="auto-restore-copy">
						<text class="auto-restore-title">{{ t("命令后回广播") }}</text>
						<text class="auto-restore-desc">{{
							autoRestoreBroadcastAfterGattTask
								? t("连接模式下，执行完 GATT 命令后自动恢复 0x50")
								: t("连接模式下保持连接，便于连续测试多个 GATT 命令")
						}}</text>
					</view>
					<cl-switch v-model="autoRestoreBroadcastAfterGattTask"></cl-switch>
				</view>
			</view>

			<!-- 设备状态 -->
			<view class="mb-4 p-3 bg-gray-800 rounded">
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("BOOM 协议状态") }}
				</cl-text>
				<view class="flex flex-row flex-wrap">
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("固件版本") }}</cl-text>
						<cl-text color="white" :size="14">{{ fwText }}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("设备编号") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.event.deviceNumber
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("BOOM 时戳") }}</cl-text>
						<cl-text color="white" :size="14">{{
							deviceStore.event.boomTimestamp
						}}</cl-text>
					</view>
					<view class="w-1/2 mb-2">
						<cl-text color="gray-400" :size="12">{{ t("生物识别") }}</cl-text>
						<cl-text color="white" :size="12">{{ bioText }}</cl-text>
					</view>
				</view>
				<view class="mt-2 p-2 bg-gray-700 rounded">
					<cl-text :color="protocolReady ? 'success' : 'warning'" :size="12">
						{{ protocolReadyText }}
					</cl-text>
				</view>
			</view>

			<!-- 0x50 实时广播 -->
			<view
				v-if="testMode == 'broadcast'"
				class="mb-4 p-3 bg-gray-800 rounded broadcast-panel"
			>
				<view class="flex flex-row items-center justify-between mb-3">
					<cl-text color="white" :size="15" :pt="{ className: 'font-bold' }">
						{{ t("0x50 实时广播") }}
					</cl-text>
					<cl-text :color="advText.seq == '-' ? 'warning' : 'success'" :size="12">
						{{ advText.seq == "-" ? t("等待广播") : `${t("已接收")} #${advText.seq}` }}
					</cl-text>
				</view>
				<view class="broadcast-hero mb-3">
					<view class="metric-large">
						<text class="metric-label">{{ t("心率") }}</text>
						<text class="metric-value">{{ rtText.hr }}</text>
						<text class="metric-unit">bpm</text>
					</view>
					<view class="metric-large">
						<text class="metric-label">{{ t("HRV/PPI") }}</text>
						<text class="metric-value">{{ rtText.hrv }}</text>
						<text class="metric-unit">ms</text>
					</view>
					<view class="metric-large">
						<text class="metric-label">{{ t("血氧") }}</text>
						<text class="metric-value">{{ rtText.spo2 }}</text>
						<text class="metric-unit">%</text>
					</view>
				</view>
				<view class="broadcast-grid">
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("电池电压") }}</text>
						<text class="cell-value"
							>{{ rtText.voltage }} V / {{ rtText.voltageMv }} mV</text
						>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">PPI</text>
						<text class="cell-value">{{ rtText.ppi }} ms</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("PPG 佩戴") }}</text>
						<text class="cell-value">{{ rtText.ppgAttached }}</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">Status</text>
						<text class="cell-value">{{ rtText.status }}</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("行为 / 活动") }}</text>
						<text class="cell-value"
							>{{ rtText.behavior }} / {{ rtText.activity }}</text
						>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("静息心率 BHR") }}</text>
						<text class="cell-value">{{ rtText.bhr }} bpm</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("步数") }}</text>
						<text class="cell-value">{{ rtText.steps }}</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("卡路里") }}</text>
						<text class="cell-value">{{ rtText.calories }} kcal</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("上次接收") }}</text>
						<text class="cell-value">{{ rtText.receivedAt }}</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">UTC</text>
						<text class="cell-value">{{ rtText.utc }}</text>
					</view>
					<view class="broadcast-cell">
						<text class="cell-label">{{ t("时间偏差") }}</text>
						<text class="cell-value">{{ advText.diff }}</text>
					</view>
				</view>
				<view class="broadcast-debug mt-3">
					<text class="debug-line"
						>device={{ advText.deviceId }} RSSI={{ advText.rssi }}</text
					>
					<text class="debug-line">{{ advText.parsed }}</text>
					<text class="debug-line">raw={{ advText.rawHex }}</text>
					<text class="debug-line">v={{ advText.vHex }}</text>
				</view>
			</view>

			<template v-if="testMode == 'connect'">
				<!-- BOOM GATT 协议测试（8 个按钮 + 上次响应行） -->
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("BOOM GATT 协议测试") }}
				</cl-text>
				<view class="mb-4">
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#444"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x30')"
							@tap="testReadFirmware"
						>
							{{ t("0x30 读固件") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x30] {{ fwResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#444"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x32')"
							@tap="testReadDeviceNumber"
						>
							{{ t("0x32 读设备编号") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x32] {{ devNumResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#444"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x34')"
							@tap="testReadTimestamp"
						>
							{{ t("0x34 读时戳") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x34] {{ tsResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#444"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x36')"
							@tap="testReadBiometric"
						>
							{{ t("0x36 读生物识别") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x36] {{ bioResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#666"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x31')"
							@tap="openForm('0x31')"
						>
							{{ t("0x31 写设备编号") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x31] {{ setDevNumResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#666"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x33')"
							@tap="testSetTimestamp"
						>
							{{ t("0x33 写时戳") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x33] {{ setTsResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#666"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x35')"
							@tap="openForm('0x35')"
						>
							{{ t("0x35 写生物识别") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x35] {{ setBioResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#888"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x40')"
							@tap="testVibration"
						>
							{{ t("0x40 震动马达") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x40] {{ vibResp }}
						</cl-text>
					</view>
				</view>

				<!-- 历史数据（0x3A/0x3B/0x3C/0x3D） -->
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("历史数据（v5 新增）") }}
				</cl-text>
				<view class="mb-4">
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#0a0"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x3A')"
							@tap="openForm('0x3A')"
						>
							{{ t("0x3A 开始生命体征") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#087"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="vitalAutoReading == false"
							@tap="stopVitalAutoRead"
						>
							{{ t("停止生命体征") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x3A/0x3B] {{ vitalFlowResp }}
						</cl-text>
					</view>
					<view class="flex flex-row flex-wrap items-center mb-1">
						<cl-button
							type="primary"
							color="#a00"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="isCommandDisabled('0x3C')"
							@tap="openForm('0x3C')"
						>
							{{ t("0x3C 开始事件") }}
						</cl-button>
						<cl-button
							type="primary"
							color="#870"
							rounded
							size="small"
							class="mr-2 mb-1"
							:disabled="eventAutoReading == false"
							@tap="stopEventAutoRead"
						>
							{{ t("停止事件") }}
						</cl-button>
						<cl-text color="gray-400" :size="12" class="flex-1 mb-1">
							[0x3C/0x3D] {{ eventFlowResp }}
						</cl-text>
					</view>
				</view>

				<!-- 0x3A 生命体征响应展示区 -->
				<view v-if="hasVitalData" class="mb-4 p-3 bg-gray-800 rounded data-card">
					<view class="data-card-header">
						<cl-text color="white" :size="14" :pt="{ className: 'font-bold' }">
							{{ t("0x3A 生命体征响应") }}
						</cl-text>
						<cl-text color="gray-400" :size="11">{{ vitalText.summary }}</cl-text>
					</view>
					<view class="data-grid">
						<view class="data-cell">
							<text class="cell-label">{{ t("起始时间") }}</text>
							<text class="cell-value">{{ vitalText.start }}</text>
						</view>
						<view class="data-cell">
							<text class="cell-label">{{ t("方向 / 分钟") }}</text>
							<text class="cell-value">{{ vitalText.directionMinutes }}</text>
						</view>
						<view class="data-cell">
							<text class="cell-label">{{ t("有效心率") }}</text>
							<text class="cell-value">{{ vitalText.valid }}</text>
						</view>
						<view class="data-cell">
							<text class="cell-label">PPI</text>
							<text class="cell-value">{{ vitalText.ppi }}</text>
						</view>
					</view>
					<view class="data-debug mt-3">
						<text class="debug-line">{{ vitalText.status }}</text>
						<text class="debug-line">RMSSD/SDNN: {{ vitalText.rmssdSdnn }}</text>
						<text class="debug-line"
							>{{ t("逐秒数据 (前 30 条)") }}: {{ vitalText.vital }}</text
						>
					</view>
					<view class="mt-3">
						<text class="protocol-log-line protocol-log-detail">{{
							vitalAutoDetail
						}}</text>
					</view>
				</view>

				<!-- 0x3C/0x3D 事件响应展示区 -->
				<view v-if="hasEventData" class="mb-4 p-3 bg-gray-800 rounded data-card">
					<view class="data-card-header">
						<cl-text color="white" :size="14" :pt="{ className: 'font-bold' }">
							{{ t("0x3C 事件响应") }}
						</cl-text>
						<cl-text color="gray-400" :size="11">{{ eventText.summary }}</cl-text>
					</view>
					<view class="data-grid">
						<view class="data-cell">
							<text class="cell-label">{{ t("事件头") }}</text>
							<text class="cell-value">{{ eventText.header }}</text>
						</view>
						<view class="data-cell">
							<text class="cell-label">{{ t("事件数量") }}</text>
							<text class="cell-value">{{ eventText.count }}</text>
						</view>
					</view>
					<view class="data-debug mt-3">
						<text class="debug-line">{{ t("事件列表 (前 10 条)") }}:</text>
						<text class="debug-line">{{ eventText.items }}</text>
					</view>
					<view class="mt-3">
						<text class="protocol-log-line protocol-log-detail">{{
							eventAutoDetail
						}}</text>
					</view>
				</view>

				<!-- 设备控制 -->
				<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
					{{ t("设备控制") }}
				</cl-text>
				<view class="flex flex-row flex-wrap mb-4">
					<cl-button
						type="primary"
						color="#333"
						rounded
						size="small"
						class="mr-2 mb-2"
						:disabled="activeCommand != ''"
						@tap="testDisconnect"
					>
						{{ t("断开连接") }}
					</cl-button>
					<cl-button
						type="primary"
						color="#333"
						rounded
						size="small"
						class="mr-2 mb-2"
						:disabled="activeCommand != ''"
						@tap="testReconnect"
					>
						{{ t("测试重连") }}
					</cl-button>
					<cl-button
						type="primary"
						color="#555"
						rounded
						size="small"
						class="mr-2 mb-2"
						:disabled="activeCommand != ''"
						@tap="testClearError"
					>
						{{ t("清除错误") }}
					</cl-button>
					<cl-button
						type="primary"
						color="#555"
						rounded
						size="small"
						class="mr-2 mb-2"
						@tap="openProtocolLog"
					>
						{{ t("协议日志") }}
					</cl-button>
				</view>
			</template>

			<!-- 更多测试 -->
			<cl-text color="white" :size="14" :pt="{ className: 'font-bold mb-2' }">
				{{ t("更多测试") }}
			</cl-text>
			<view class="flex flex-row flex-wrap mb-4">
				<cl-button
					type="primary"
					color="#256"
					rounded
					size="small"
					class="mr-2 mb-2"
					@tap="openDatabasePopup"
				>
					{{ t("数据库查询") }}
				</cl-button>
			</view>
		</scroll-view>

		<DatabaseTestPopup v-model:show="databasePopupVisible"></DatabaseTestPopup>

		<!-- 参数输入子弹窗（0x31/0x35/0x3A/0x3C 共用） -->
		<cl-popup v-model="formVisible" direction="bottom" :size="700" :title="formTitle">
			<scroll-view class="p-4" scroll-y="true" style="height: 100%">
				<!-- 0x31 设备编号 -->
				<template v-if="activeForm == '0x31'">
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("设备编号（1~29 位，数字/字母）") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input
							v-model="formDeviceNumber"
							:placeholder="t('请输入设备编号')"
							:maxlength="29"
							clearable
						></cl-input>
					</view>
				</template>

				<!-- 0x35 写生物识别 -->
				<template v-else-if="activeForm == '0x35'">
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("性别") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select v-model="formGender" :options="genderOptions"></cl-select>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("体重 (×100, e.g. 7000 = 70.00kg)") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input v-model="formWeight" type="number" placeholder="7000"></cl-input>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("身高 (×100, e.g. 18000 = 180cm)") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input v-model="formHeight" type="number" placeholder="18000"></cl-input>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("年龄 (岁)") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input v-model="formAge" type="number" placeholder="20"></cl-input>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("PPG 位置") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select
							v-model="formPpgPosition"
							:options="ppgPositionOptions"
						></cl-select>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("静息心率 BHR (28~240)") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input v-model="formBhr" type="number" placeholder="60"></cl-input>
					</view>
				</template>

				<!-- 0x3A 读生命体征 -->
				<template v-else-if="activeForm == '0x3A'">
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("起始时戳 (秒)") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input
							v-model="formStartSec"
							type="number"
							:placeholder="t('默认 2 分钟前')"
						></cl-input>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("方向") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select v-model="formDirection" :options="directionOptions"></cl-select>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("分钟数") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select v-model="formMinutes" :options="minutesOptions"></cl-select>
					</view>
				</template>

				<!-- 0x3C 读事件 -->
				<template v-else-if="activeForm == '0x3C'">
					<view class="event-window-shortcuts mb-3">
						<view class="event-window-button" @tap="setEventWindowMinutes(15)">
							<text class="event-window-button-text">{{ t("近15分钟") }}</text>
						</view>
						<view class="event-window-button" @tap="setEventWindowMinutes(60)">
							<text class="event-window-button-text">{{ t("近1小时") }}</text>
						</view>
						<view class="event-window-button" @tap="setEventWindowMinutes(360)">
							<text class="event-window-button-text">{{ t("近6小时") }}</text>
						</view>
						<view class="event-window-button" @tap="setEventWindowMinutes(1440)">
							<text class="event-window-button-text">{{ t("近24小时") }}</text>
						</view>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("类型") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select v-model="formType" :options="eventTypeOptions"></cl-select>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("事件时间范围") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-select-date
							v-model:values="formEventRange"
							type="second"
							rangeable
							:show-shortcuts="false"
							value-format="YYYY-MM-DD HH:mm:ss"
							label-format="YYYY-MM-DD HH:mm:ss"
							:start-placeholder="t('开始时间')"
							:end-placeholder="t('结束时间')"
						></cl-select-date>
						<view class="event-window-preview">
							<text class="event-window-preview-text">
								{{ eventWindowPreviewText }}
							</text>
						</view>
					</view>
					<view class="mb-3">
						<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
							{{ t("续读最大条数") }}
							<cl-text color="error">*</cl-text>
						</cl-text>
						<cl-input
							v-model="formMaxCount"
							type="number"
							:placeholder="t('默认 10')"
						></cl-input>
					</view>
				</template>

				<!-- 快速发送示例（有文档示例时显示） -->
				<view v-if="exampleList.length > 0" class="mt-4 p-3 bg-gray-700 rounded">
					<cl-text color="gray-300" :size="12" :pt="{ className: 'mb-2 font-bold' }">
						{{ t("快速发送示例（免填表单）") }}
					</cl-text>
					<view class="flex flex-row flex-wrap">
						<cl-button
							v-for="(ex, i) in exampleList"
							:key="i"
							type="primary"
							color="#a0a"
							rounded
							size="small"
							class="mr-1 mb-1"
							:disabled="activeCommand != '' || protocolReady == false"
							@tap="sendExample(ex)"
						>
							{{ ex.name }}
						</cl-button>
					</view>
				</view>

				<view class="flex flex-row mt-4">
					<cl-button type="light" size="large" class="flex-1 mr-2" @tap="closeForm">
						{{ t("取消") }}
					</cl-button>
					<cl-button
						type="primary"
						size="large"
						class="flex-1 ml-2"
						:disabled="activeCommand != ''"
						@tap="submitForm"
					>
						{{ activeCommand != "" ? t("发送中") : t("发送") }}
					</cl-button>
				</view>
			</scroll-view>
		</cl-popup>

		<!-- 协议日志 + 手动 raw 发送 -->
		<cl-popup
			v-model="protocolLogVisible"
			direction="bottom"
			:size="620"
			:title="t('协议日志')"
		>
			<view
				style="
					height: 100%;
					position: relative;
					overflow: hidden;
					background-color: #2b2c28;
				"
			>
				<view
					style="
						position: absolute;
						top: 12px;
						left: 12px;
						right: 12px;
						height: 170px;
						z-index: 2;
						overflow: hidden;
						background-color: #2b2c28;
					"
				>
					<cl-text color="white" :size="14" :pt="{ className: 'mb-2' }">
						{{ t("手动发送完整 hex 帧") }}
					</cl-text>
					<cl-textarea
						v-model="manualRawHex"
						:placeholder="t('例如 06C0360000000FAC')"
						:height="90"
					></cl-textarea>
					<view class="flex flex-row mt-2">
						<cl-button
							type="primary"
							size="small"
							class="mr-2"
							:disabled="activeCommand != '' || protocolReady == false"
							@tap="sendManualRawHex"
						>
							{{ t("发送") }}
						</cl-button>
						<cl-button type="light" size="small" class="mr-2" @tap="clearManualRawHex">
							{{ t("清空输入") }}
						</cl-button>
						<cl-button type="light" size="small" @tap="clearProtocolLogs">
							{{ t("清空日志") }}
						</cl-button>
					</view>
				</view>

				<scroll-view
					scroll-y="true"
					style="
						position: absolute;
						top: 194px;
						left: 12px;
						right: 12px;
						height: 370px;
						z-index: 1;
						overflow: hidden;
					"
				>
					<view
						v-for="item in protocolLogs"
						:key="item.id"
						class="mb-2 p-2 bg-gray-800 rounded protocol-log-item"
						style="overflow: hidden"
					>
						<view class="flex flex-row items-center mb-1">
							<cl-text :color="protocolLogColor(item.direction)" :size="12">
								[{{ item.direction }}]
							</cl-text>
							<cl-text color="gray-400" :size="12" class="ml-2">
								{{ item.time }}
							</cl-text>
							<cl-text color="white" :size="12" class="ml-2">
								{{ item.title }}
							</cl-text>
						</view>
						<view v-if="item.detail != ''" style="width: 100%; overflow: hidden">
							<text class="protocol-log-line protocol-log-detail">{{
								item.detail
							}}</text>
						</view>
						<view v-if="item.hex != ''" style="width: 100%; overflow: hidden">
							<text class="protocol-log-line protocol-log-hex">{{ item.hex }}</text>
						</view>
					</view>
					<view v-if="protocolLogs.length == 0" class="py-8">
						<cl-text color="gray-400" :size="14">{{ t("暂无协议日志") }}</cl-text>
					</view>
				</scroll-view>
			</view>
		</cl-popup>
	</cl-popup>
</template>

<script lang="ts" setup>
//#ifndef H5
import { computed, reactive, ref } from "vue";
import {
	DEVICE_NUMBER_MAX_LEN,
	DOC_EXAMPLES_BY_T,
	LOG_EVENT_NAMES,
	LOG_EVENT_TYPE,
	PPG_POSITION_OPTIONS,
	dayUts,
	t,
	useStore
} from "@/.cool";
import type {
	DocExample,
	VibrationResult,
	VibrationSpec,
	VitalBiometric,
	ProtocolLogDirection,
	ProtocolLogItem
} from "@/.cool";
import type { PpgPositionOption } from "@/.cool";
import { useUi, type ClSelectOption } from "@/uni_modules/cool-ui";
import DatabaseTestPopup from "./DatabaseTestPopup.uvue";

/* 0x50 实时数据展示用 computed 类型（9 字段全部 string） */
type RtText = {
	hr: string;
	spo2: string;
	voltage: string;
	voltageMv: string;
	ppi: string;
	hrv: string;
	ppgAttached: string;
	behavior: string;
	activity: string;
	status: string;
	bhr: string;
	steps: string;
	calories: string;
	utc: string;
	receivedAt: string;
};

type AdvText = {
	seq: string;
	diff: string;
	deviceId: string;
	rssi: string;
	summary: string;
	parsed: string;
	rawHex: string;
	vHex: string;
};

const ui = useUi();
const { device: deviceStore } = useStore();

const show = defineModel("show", {
	default: false
});

const protocolLogVisible = ref(false);
const databasePopupVisible = ref(false);
const manualRawHex = ref("");
const testMode = deviceStore.testMode;
const testModeChanging = ref<boolean>(false);
const autoRestoreBroadcastAfterGattTask = ref<boolean>(true);
const restoringBroadcastAfterGattTask = ref<boolean>(false);
const protocolLogs = computed<ProtocolLogItem[]>((): ProtocolLogItem[] => {
	if (protocolLogVisible.value == false) return [];
	return deviceStore.protocolLogs.value.slice();
});

const testModeText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (testMode.value == "broadcast") {
		const boundId = deviceStore.boundDeviceId;
		if (boundId == "") return t("广播模式需要先连接并绑定设备");
		return `${t("只解析绑定设备广播")}: ${boundId}`;
	}
	return t("连接模式使用 GATT 命令和历史读取");
});

/* ===== 展示用 computed ===== */

function openProtocolLog(): void {
	protocolLogVisible.value = true;
}

function openDatabasePopup(): void {
	databasePopupVisible.value = true;
}

function clearManualRawHex(): void {
	manualRawHex.value = "";
}

function clearProtocolLogs(): void {
	deviceStore.clearProtocolLogs();
}

function normalizeHexInput(hex: string): string {
	return hex.replace(/\s|0x/g, "").toLowerCase();
}

function protocolLogColor(direction: ProtocolLogDirection): string {
	if (direction == "TX") return "success";
	if (direction == "RX") return "primary";
	if (direction == "ERR") return "error";
	return "warning";
}

function toByteHex(value: number): string {
	const item = (value & 0xff).toString(16);
	return item.length == 1 ? "0" + item : item;
}

function formatBiometric(b: VitalBiometric): string {
	return `性别${b.gender} 体重${(b.weight / 100).toFixed(2)}kg 身高${(b.height / 100).toFixed(2)}cm 年龄${b.age} PPG${b.ppgPosition} BHR${b.bhr}`;
}

const fwText = computed<string>(() => {
	const f = deviceStore.event.firmwareVersion.value;
	if (f == null) return "-";
	return `${f.major}.${f.minor}.${f.revision}`;
});

const bioText = computed<string>(() => {
	const b = deviceStore.event.biometricInfo.value;
	if (b == null) return "-";
	return formatBiometric(b);
});

function sameBiometric(a: VitalBiometric | null, b: VitalBiometric): boolean {
	if (a == null) return false;
	return (
		a.gender == b.gender &&
		a.weight == b.weight &&
		a.height == b.height &&
		a.age == b.age &&
		a.ppgPosition == b.ppgPosition &&
		a.bhr == b.bhr
	);
}

function isAlphaNumeric(value: string): boolean {
	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i) ?? 0;
		const isNumber = code >= 48 && code <= 57;
		const isUpper = code >= 65 && code <= 90;
		const isLower = code >= 97 && code <= 122;
		if (isNumber == false && isUpper == false && isLower == false) return false;
	}
	return true;
}

const rtText = computed<RtText>(() => {
	const r = deviceStore.realtime.value;
	if (r == null) {
		return {
			hr: "-",
			spo2: "-",
			voltage: "-",
			voltageMv: "-",
			ppi: "-",
			hrv: "-",
			ppgAttached: "-",
			behavior: "-",
			activity: "-",
			status: "-",
			bhr: "-",
			steps: "-",
			calories: "-",
			utc: "-",
			receivedAt: "-"
		};
	}
	return {
		hr: r.hrValid ? r.hr.toString() : `${r.hr}(${t("无效")})`,
		spo2: r.spo2Valid ? r.spo2Pct.toFixed(1) : `${r.spo2Pct.toFixed(1)}(${t("无效")})`,
		voltage: r.voltageV.toFixed(3),
		voltageMv: r.voltageMv.toString(),
		ppi: r.ppiValid ? r.ppi.toString() : `${r.ppi}(${t("无效")})`,
		hrv: r.ppiValid ? r.hrvMs.toString() : `${r.hrvMs}(${t("无效")})`,
		ppgAttached: r.ppgAttached ? t("已佩戴") : t("未佩戴"),
		behavior: `${r.behavior} ${r.behaviorLabel}`,
		activity: `${r.activity} ${r.activityLabel}`,
		status: `0x${toByteHex(r.status)} bit7=${r.statusReserved}`,
		bhr: r.bhrValid ? r.bhr.toString() : `${r.bhr}(${t("无效")})`,
		steps: r.stepsEveryday.toString(),
		calories: r.calorieKcal.toFixed(1),
		utc: r.utc > 0 ? new Date(r.utc * 1000).toLocaleString() : "0",
		receivedAt: new Date(r.receivedAt).toLocaleTimeString()
	};
});

const advText = computed<AdvText>(() => {
	const d = deviceStore.broadcastDebug.value;
	if (d == null) {
		return {
			seq: "-",
			diff: "-",
			deviceId: "-",
			rssi: "-",
			summary: "-",
			parsed: "-",
			rawHex: "-",
			vHex: "-"
		};
	}
	const r = deviceStore.realtime.value;
	let parsed = "-";
	if (r != null) {
		parsed = `utc=${r.utc} ${rtText.value.utc} received=${rtText.value.receivedAt} status=0x${toByteHex(r.status)} bit7=${r.statusReserved} ppg=${r.ppgAttached} behavior=${r.behavior}(${r.behaviorLabel}) activity=${r.activity}(${r.activityLabel}) hr=${r.hr} valid=${r.hrValid} ppi=${r.ppi} valid=${r.ppiValid} hrv=${r.hrvMs}ms spo2=${r.spo2Pct.toFixed(1)} valid=${r.spo2Valid} bhr=${r.bhr} valid=${r.bhrValid} steps=${r.stepsEveryday} calories=${r.calorieKcal.toFixed(1)}kcal voltage=${r.voltageMv}mV/${r.voltageV.toFixed(3)}V`;
	}
	return {
		seq: d.seq.toString(),
		diff: `diff=${d.diffSec}s`,
		deviceId: d.deviceId,
		rssi: `${d.rssi} dBm`,
		summary: `${d.summary} ${new Date(d.receivedAt).toLocaleTimeString()}`,
		parsed,
		rawHex: d.rawHex,
		vHex: d.vHex
	};
});

/* ===== 响应展示 ref + 11 个 computed ===== */

/** 每个 T 码的响应摘要（key 为十六进制字符串，如 "0x30"） */
type LastResponse = Record<string, string>;
const lastResponse = reactive<LastResponse>({});
const activeCommand = ref<string>("");

function getResp(cmd: string): string {
	const v = lastResponse[cmd];
	return v == null || v == "" ? "-" : v;
}

const protocolReady = computed<boolean>(() => {
	deviceStore.stateVersion.value;
	return (
		deviceStore.status.value == "CONNECTED" &&
		deviceStore.protocol.writeCharUuid != "" &&
		deviceStore.protocol.notifyCharUuid != ""
	);
});

const protocolReadyText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (testMode.value == "broadcast") return t("广播模式只解析绑定设备广播，不连接 GATT");
	if (deviceStore.status.value != "CONNECTED") return t("设备未连接，测试命令暂不可用");
	if (deviceStore.protocol.writeCharUuid == "") return t("未发现写入特征，请重新连接设备");
	if (deviceStore.protocol.notifyCharUuid == "") return t("未发现通知特征，请重新连接设备");
	return t("协议已就绪，可以发送测试命令");
});

function isCommandDisabled(cmd: string): boolean {
	return (
		testMode.value == "broadcast" || protocolReady.value == false || activeCommand.value != ""
	);
}

function setCommandResponse(cmd: string, message: string): void {
	const time = new Date().toLocaleTimeString();
	lastResponse[cmd] = `${time} ${message}`;
}

function beginCommand(cmd: string): boolean {
	if (protocolReady.value == false) {
		ui.showToast({ message: protocolReadyText.value, type: "warn" });
		return false;
	}
	if (activeCommand.value != "") {
		ui.showToast({ message: t("已有命令发送中，请稍候"), type: "warn" });
		return false;
	}
	activeCommand.value = cmd;
	setCommandResponse(cmd, t("发送中..."));
	return true;
}

async function restoreBroadcastAfterGattTask(): Promise<void> {
	if (autoRestoreBroadcastAfterGattTask.value == false) return;
	if (testMode.value != "connect") return;
	if (deviceStore.boundDeviceId == "") return;
	if (restoringBroadcastAfterGattTask.value == true) return;
	restoringBroadcastAfterGattTask.value = true;
	try {
		await new Promise<void>((resolve) => {
			setTimeout(() => {
				resolve();
			}, 350);
		});
		await deviceStore.connection.disconnectForBroadcastMode();
		testMode.value = "broadcast";
	} catch (e) {
		console.warn("[TEST] GATT 命令结束后恢复广播模式失败:", e);
	} finally {
		restoringBroadcastAfterGattTask.value = false;
	}
}

function endCommand(cmd: string): void {
	if (activeCommand.value == cmd) {
		activeCommand.value = "";
	}
	restoreBroadcastAfterGattTask();
}

async function sendManualRawHex(): Promise<void> {
	const hex = normalizeHexInput(manualRawHex.value);
	if (hex.length == 0) {
		ui.showToast({ message: t("请输入 hex 帧"), type: "error" });
		return;
	}
	if (hex.length % 2 != 0) {
		ui.showToast({ message: t("hex 长度必须是偶数"), type: "error" });
		return;
	}
	if (/^[0-9a-f]+$/.test(hex) == false) {
		ui.showToast({ message: t("hex 只能包含 0-9/a-f"), type: "error" });
		return;
	}
	if (!beginCommand("RAW")) return;
	try {
		const ok = await deviceStore.protocol.sendRawFrame(hex);
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
	} finally {
		endCommand("RAW");
	}
}

function sleep(ms: number): Promise<void> {
	return new Promise<void>((resolve) => {
		setTimeout(() => {
			resolve();
		}, ms);
	});
}

async function waitForBiometric(
	beforeSeq: number,
	sentAt: number,
	expected: VitalBiometric | null,
	timeoutMs: number
): Promise<VitalBiometric | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.biometricInfo.value;
		if (current != null) {
			if (expected != null && sameBiometric(current, expected)) return current;
			if (
				expected == null &&
				(deviceStore.event.biometricInfoSeq.value > beforeSeq ||
					deviceStore.event.biometricInfoReceivedAt.value >= sentAt)
			) {
				return current;
			}
		}
		await sleep(150);
	}
	return null;
}

async function waitForVibration(
	before: VibrationResult | null,
	timeoutMs: number
): Promise<VibrationResult | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.lastVibration.value;
		if (current != null && current !== before) return current;
		await sleep(150);
	}
	return null;
}

const fwResp = computed<string>(() => getResp("0x30"));
const devNumResp = computed<string>(() => getResp("0x32"));
const tsResp = computed<string>(() => getResp("0x34"));
const bioResp = computed<string>(() => getResp("0x36"));
const setDevNumResp = computed<string>(() => getResp("0x31"));
const setTsResp = computed<string>(() => getResp("0x33"));
const setBioResp = computed<string>(() => getResp("0x35"));
const vibResp = computed<string>(() => getResp("0x40"));
const vitalFlowResp = computed<string>(() => getResp("VITAL"));
const eventFlowResp = computed<string>(() => getResp("EVENT"));
const vitalAutoReading = ref<boolean>(false);
const eventAutoReading = ref<boolean>(false);
const vitalAutoDetail = ref<string>("-");
const eventAutoDetail = ref<string>("-");
const MAX_AUTO_PAGES = 100;
const VITAL_FORM_DEFAULT_OFFSET_SECONDS = 120;

async function switchToBroadcastMode(): Promise<void> {
	if (deviceStore.boundDeviceId == "") {
		ui.showToast({ message: t("请先连接/绑定设备"), type: "warn" });
		return;
	}
	vitalAutoReading.value = false;
	eventAutoReading.value = false;
	await deviceStore.connection.disconnectForBroadcastMode();
	testMode.value = "broadcast";
	ui.showToast({ message: t("已进入广播模式"), type: "success" });
}

async function switchToConnectMode(): Promise<void> {
	const boundId = deviceStore.boundDeviceId;
	if (boundId == "") {
		testMode.value = "connect";
		ui.showToast({ message: t("请先连接/绑定设备"), type: "warn" });
		return;
	}
	testMode.value = "connect";
	if (deviceStore.currentDeviceId != "") {
		ui.showToast({ message: t("已进入连接模式"), type: "success" });
		return;
	}
	const ok = await deviceStore.connection.connectBoundDeviceForGatt();
	if (ok == true) {
		ui.showToast({ message: t("已进入连接模式"), type: "success" });
	} else {
		ui.showToast({ message: t("直连失败，正在搜索并连接设备..."), type: "warn" });
	}
}

async function switchTestMode(mode: "connect" | "broadcast"): Promise<void> {
	if (testModeChanging.value == true) return;
	if (mode == testMode.value) return;
	testModeChanging.value = true;
	try {
		if (mode == "broadcast") {
			await switchToBroadcastMode();
		} else {
			await switchToConnectMode();
		}
	} finally {
		testModeChanging.value = false;
	}
}

/* ===== 参数输入子弹窗状态 ===== */

/** 当前打开的表单类型（空=未打开） */
const activeForm = ref<"" | "0x31" | "0x35" | "0x3A" | "0x3C">("");
/** 子弹窗显示控制（v-model 双向绑定） */
const formVisible = ref(false);

const formTitle = computed<string>(() => {
	switch (activeForm.value) {
		case "0x31":
			return t("设置设备编号");
		case "0x35":
			return t("0x35 写生物识别");
		case "0x3A":
			return t("生命体征读取流程");
		case "0x3C":
			return t("事件读取流程");
		default:
			return "";
	}
});

/** 表单数据（按字段分独立 ref，避免 Ref<T, S> 联合类型推断问题） */
const formDeviceNumber = ref<string>("");
const formStartSec = ref<string>("0");
const formEndSec = ref<string>("0");
const formEventRange = ref<string[]>([]);
const formMaxCount = ref<string>("10");
const formDirection = ref<number>(0);
const formMinutes = ref<number>(2);
const formType = ref<number>(0);
// 0x35 生物识别表单字段
const formGender = ref<number>(0);
const formWeight = ref<string>("7000");
const formHeight = ref<string>("18000");
const formAge = ref<string>("20");
const formPpgPosition = ref<number>(0);
const formBhr = ref<string>("60");

/** 方向选项（0=向前 1=向后） */
const directionOptions: ClSelectOption[] = [
	{ label: t("向前 (0)"), value: 0 },
	{ label: t("向后 (1)"), value: 1 }
];

/** 分钟数选项（2 / 5） */
const minutesOptions: ClSelectOption[] = [
	{ label: t("2 分钟"), value: 2 },
	{ label: t("5 分钟"), value: 5 }
];

/** 事件查询类型：文档 1.4.4.10 示例固定 Byte1=1，按时间窗口读取全部事件类型 */
const eventTypeOptions: ClSelectOption[] = [{ label: t("按时间读取全部事件 (1)"), value: 1 }];

/** 性别选项（0=男 1=女） */
const genderOptions: ClSelectOption[] = [
	{ label: t("男 (0)"), value: 0 },
	{ label: t("女 (1)"), value: 1 }
];

/** PPG 位置选项（0~6，与协议 UINT8 保持一致） */
const ppgPositionOptions: ClSelectOption[] = PPG_POSITION_OPTIONS.map(
	(item: PpgPositionOption): ClSelectOption => ({
		label: `${t(item.label)} (${item.value})`,
		value: item.value
	})
);

/** 当前表单可用的文档示例（按 T 码查 DOC_EXAMPLES_BY_T） */
const exampleList = computed<DocExample[]>(() => {
	if (activeForm.value == "") return [];
	const tCode = parseInt(activeForm.value, 16);
	return DOC_EXAMPLES_BY_T.get(tCode) ?? [];
});

function getNowSec(): number {
	return Math.floor(Date.now() / 1000);
}

function resetVitalFormToCurrentWindow(): void {
	const now = getNowSec();
	const startSec = now - VITAL_FORM_DEFAULT_OFFSET_SECONDS;
	formStartSec.value = startSec.toString();
	formDirection.value = 0;
	formMinutes.value = 2;
	console.log(`[BOOM-TEST] 打开 0x3A 表单，刷新默认时间: nowSec=${now}, startSec=${startSec}`);
}

function formatEventWindowTime(sec: number): string {
	return new Date(sec * 1000).toLocaleString();
}

function formatEventPickerTime(sec: number): string {
	return dayUts(new Date(sec * 1000)).format("YYYY-MM-DD HH:mm:ss");
}

function syncEventWindowSec(startSec: number, endSec: number): void {
	formStartSec.value = startSec.toString();
	formEndSec.value = endSec.toString();
	formEventRange.value = [formatEventPickerTime(startSec), formatEventPickerTime(endSec)];
}

function setEventWindowMinutes(minutes: number): void {
	const now = getNowSec();
	const start = now - minutes * 60;
	syncEventWindowSec(start, now);
}

function parseEventPickerSec(value: string): number {
	if (value == "") return 0;
	const ms = dayUts(value).valueOf();
	if (Number.isNaN(ms)) return 0;
	return Math.floor(ms / 1000);
}

const eventWindowPreviewText = computed<string>(() => {
	let startSec = parseInt(formStartSec.value, 10);
	let endSec = parseInt(formEndSec.value, 10);
	if (formEventRange.value.length >= 2) {
		const pickedStart = parseEventPickerSec(formEventRange.value[0]);
		const pickedEnd = parseEventPickerSec(formEventRange.value[1]);
		if (pickedStart > 0 && pickedEnd > 0) {
			startSec = pickedStart;
			endSec = pickedEnd;
		}
	}
	if (Number.isNaN(startSec) || Number.isNaN(endSec) || startSec <= 0 || endSec <= 0) {
		return `${t("协议秒")}: -`;
	}
	return `${t("协议秒")}: ${startSec} ~ ${endSec}`;
});

/** 打开子弹窗并重置默认值 */
function openForm(cmd: "0x31" | "0x35" | "0x3A" | "0x3C"): void {
	switch (cmd) {
		case "0x31":
			formDeviceNumber.value = "";
			break;
		case "0x35":
			formGender.value = 0;
			formWeight.value = "7000";
			formHeight.value = "18000";
			formAge.value = "20";
			formPpgPosition.value = 0;
			formBhr.value = "60";
			break;
		case "0x3A":
			resetVitalFormToCurrentWindow();
			break;
		case "0x3C": {
			const now = getNowSec();
			formType.value = 1;
			syncEventWindowSec(now - 3600, now);
			formMaxCount.value = "10";
			break;
		}
	}
	activeForm.value = cmd;
	formVisible.value = true;
}

/** 关闭子弹窗 */
function closeForm(): void {
	formVisible.value = false;
	activeForm.value = "";
}

/** 提交表单（按 activeForm 分派） */
async function submitForm(): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	const commandKey = cmd == "0x3A" ? "VITAL" : cmd == "0x3C" ? "EVENT" : cmd;
	if (!beginCommand(commandKey)) return;
	let shouldClose = false;
	try {
		switch (cmd) {
			case "0x31": {
				const num = formDeviceNumber.value.trim();
				if (num.length == 0 || num.length > DEVICE_NUMBER_MAX_LEN) {
					ui.showToast({ message: t("编号长度需 1~29 位"), type: "error" });
					return;
				}
				if (isAlphaNumeric(num) == false) {
					ui.showToast({ message: t("设备编号只能包含数字和字母"), type: "error" });
					return;
				}
				ui.showToast({ message: t("0x31 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setDeviceNumber(num);
				setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x31 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				shouldClose = true;
				break;
			}
			case "0x35": {
				const w = parseInt(formWeight.value, 10);
				const h = parseInt(formHeight.value, 10);
				const a = parseInt(formAge.value, 10);
				const b = parseInt(formBhr.value, 10);
				if (Number.isNaN(w) || w < 1000 || w > 65000) {
					ui.showToast({ message: t("体重需 1000~65000"), type: "error" });
					return;
				}
				if (Number.isNaN(h) || h < 10000 || h > 28000) {
					ui.showToast({ message: t("身高需 10000~28000"), type: "error" });
					return;
				}
				if (Number.isNaN(a) || a < 10 || a > 99) {
					ui.showToast({ message: t("年龄需 10~99"), type: "error" });
					return;
				}
				if (Number.isNaN(b) || b < 28 || b > 240) {
					ui.showToast({ message: t("BHR 需 28~240"), type: "error" });
					return;
				}
				const req: VitalBiometric = {
					gender: formGender.value,
					weight: w,
					height: h,
					age: a,
					ppgPosition: formPpgPosition.value,
					bhr: b
				};
				const beforeSeq = deviceStore.event.biometricInfoSeq.value;
				const sentAt = Date.now();
				ui.showToast({ message: t("0x35 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setBiometric(req);
				if (!ok) {
					setCommandResponse(cmd, t("发送失败，请重试"));
					ui.showToast({ message: t("发送失败"), type: "error" });
					return;
				}
				setCommandResponse(cmd, t("已发送，等待设备确认"));
				const confirmed = await waitForBiometric(beforeSeq, sentAt, req, 2500);
				if (confirmed != null) {
					setCommandResponse(cmd, `${t("设备已确认")} ${formatBiometric(confirmed)}`);
					ui.showToast({ message: t("设备已确认写入"), type: "success" });
				} else {
					setCommandResponse(cmd, t("已发送，但未收到 0x35 确认"));
					ui.showToast({ message: t("未收到写入确认，可手动读回验证"), type: "warn" });
				}
				setCommandResponse("0x36", t("如需验证，请手动点击 0x36 读生物识别"));
				shouldClose = true;
				break;
			}
			case "0x3A": {
				const startSec = parseInt(formStartSec.value, 10);
				if (Number.isNaN(startSec) || startSec <= 0) {
					ui.showToast({ message: t("起始时戳必须是正数"), type: "error" });
					return;
				}
				vitalAutoReading.value = true;
				vitalAutoDetail.value = "-";
				setCommandResponse("VITAL", t("0x3A 已开始，自动续读中"));
				closeForm();
				const result = await deviceStore.history.readVitalDataAuto({
					startSec,
					direction: formDirection.value,
					minutes: formMinutes.value,
					maxPages: MAX_AUTO_PAGES,
					pageDelayMs: 250,
					shouldStop: () => vitalAutoReading.value == false,
					onProgress: (p) => {
						if (p.phase == "0x3B" && p.page % 5 == 0) {
							setCommandResponse("VITAL", `${t("自动续读")} ${p.page}`);
						}
					},
					onPage: (r, page) => {
						if (page % 5 != 0 && r.startSec != 0) return;
						let validCount = 0;
						for (let i = 0; i < r.vitalData.length; i++) {
							if (r.vitalData[i].valid == true) validCount++;
						}
						setCommandResponse(
							"VITAL",
							`${page} ${t("段")} ${validCount}/${r.vitalData.length} ${t("有效")}`
						);
					}
				});
				vitalAutoReading.value = false;
				vitalAutoDetail.value = deviceStore.history.formatVitalAutoDetail(result.responses);
				setCommandResponse(
					"VITAL",
					result.done
						? `${t("读取完成")} ${result.pages} ${t("段")} ${t("保存")} ${result.savedRecords}`
						: result.stoppedByLimit
							? `${t("达到上限")} ${result.pages} ${t("段")}`
							: `${t("读取停止")} ${result.pages} ${t("段")}`
				);
				shouldClose = false;
				break;
			}
			case "0x3C": {
				let startSec = parseInt(formStartSec.value, 10);
				let endSec = parseInt(formEndSec.value, 10);
				if (formEventRange.value.length >= 2) {
					const pickedStart = parseEventPickerSec(formEventRange.value[0]);
					const pickedEnd = parseEventPickerSec(formEventRange.value[1]);
					if (pickedStart > 0 && pickedEnd > 0) {
						startSec = pickedStart;
						endSec = pickedEnd;
						formStartSec.value = startSec.toString();
						formEndSec.value = endSec.toString();
					}
				}
				if (
					Number.isNaN(startSec) ||
					startSec <= 0 ||
					Number.isNaN(endSec) ||
					endSec <= 0
				) {
					ui.showToast({ message: t("起止时戳必须是正数"), type: "error" });
					return;
				}
				if (endSec <= startSec) {
					ui.showToast({ message: t("结束时戳必须大于起始时戳"), type: "error" });
					return;
				}
				const maxCount = parseInt(formMaxCount.value, 10);
				const finalMaxCount = Number.isNaN(maxCount) || maxCount <= 0 ? 10 : maxCount;
				eventAutoReading.value = true;
				eventAutoDetail.value = "-";
				setCommandResponse(
					"EVENT",
					`${t("0x3C 已开始")} ${formatEventWindowTime(startSec)} ~ ${formatEventWindowTime(endSec)}`
				);
				closeForm();
				const result = await deviceStore.history.readEventDataAuto({
					type: formType.value,
					startSec,
					endSec,
					maxCount: finalMaxCount,
					maxPages: MAX_AUTO_PAGES,
					pageDelayMs: 250,
					shouldStop: () => eventAutoReading.value == false,
					onHeader: (h) => {
						setCommandResponse(
							"EVENT",
							`0x3C type=${h.type} sn[${h.earliestSn}~${h.latestSn}]`
						);
					},
					onProgress: (p) => {
						if (p.phase == "0x3D" && p.page % 5 == 0) {
							setCommandResponse("EVENT", `${t("自动续读")} ${p.page}`);
						}
					},
					onBatch: (items, page) => {
						if (page % 5 != 0 && items.length > 0) return;
						setCommandResponse(
							"EVENT",
							`${page} ${t("批")} ${t("新增")} ${items.length} ${t("条")}`
						);
					}
				});
				eventAutoReading.value = false;
				eventAutoDetail.value = deviceStore.history.formatEventAutoDetail(result.items);
				setCommandResponse(
					"EVENT",
					result.done
						? `${t("读取完成")} ${result.items.length} ${t("条")}`
						: result.stoppedByLimit
							? `${t("达到上限")} ${result.items.length} ${t("条")}`
							: `${t("读取停止")} ${result.items.length} ${t("条")}`
				);
				shouldClose = false;
				break;
			}
		}
	} finally {
		endCommand(commandKey);
	}
	if (shouldClose) closeForm();
}

function stopVitalAutoRead(): void {
	vitalAutoReading.value = false;
	setCommandResponse("VITAL", t("已停止自动续读"));
}

function stopEventAutoRead(): void {
	eventAutoReading.value = false;
	setCommandResponse("EVENT", t("已停止自动续读"));
}

/* ===== 7 个无参/硬编码协议命令 ===== */

async function testReadFirmware(): Promise<void> {
	const cmd = "0x30";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x30 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readFirmwareVersion();
		const f = deviceStore.event.firmwareVersion.value;
		if (ok && f != null) {
			setCommandResponse(cmd, `${f.major}.${f.minor}.${f.revision}`);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadDeviceNumber(): Promise<void> {
	const cmd = "0x32";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x32 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readDeviceNumber();
		const num = deviceStore.event.deviceNumber.value;
		if (ok && num != "") {
			setCommandResponse(cmd, num);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadTimestamp(): Promise<void> {
	const cmd = "0x34";
	if (!beginCommand(cmd)) return;
	try {
		ui.showToast({ message: t("0x34 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readTimestamp();
		const sec = deviceStore.event.boomTimestamp.value;
		if (ok && sec > 0) {
			setCommandResponse(cmd, new Date(sec * 1000).toLocaleString());
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
	} finally {
		endCommand(cmd);
	}
}

async function testReadBiometric(): Promise<void> {
	const cmd = "0x36";
	if (!beginCommand(cmd)) return;
	try {
		const beforeSeq = deviceStore.event.biometricInfoSeq.value;
		const sentAt = Date.now();
		ui.showToast({ message: t("0x36 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readBiometric();
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return;
		}
		setCommandResponse(cmd, t("已发送，等待设备响应"));
		const b = await waitForBiometric(beforeSeq, sentAt, null, 2500);
		if (b != null) {
			setCommandResponse(cmd, formatBiometric(b));
			ui.showToast({ message: t("设备已响应"), type: "success" });
		} else {
			setCommandResponse(cmd, t("已发送，但未收到设备响应"));
			ui.showToast({ message: t("未收到设备响应"), type: "warn" });
		}
	} finally {
		endCommand(cmd);
	}
}

async function testSetTimestamp(): Promise<void> {
	const cmd = "0x33";
	if (!beginCommand(cmd)) return;
	try {
		const ok = await deviceStore.protocol.setTimestamp(Math.floor(Date.now() / 1000));
		setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("0x33 已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
	} finally {
		endCommand(cmd);
	}
}

/** 快速发送文档示例（不填表单，直接发 raw 帧） */
async function sendExample(ex: DocExample): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	const commandKey = cmd == "0x3A" ? "VITAL" : cmd == "0x3C" ? "EVENT" : cmd;
	if (!beginCommand(commandKey)) return;
	try {
		ui.showToast({ message: `${t("发送示例")} ${ex.name}`, type: "warn" });
		const ok = await deviceStore.protocol.sendRawFrame(ex.request);
		setCommandResponse(commandKey, ok ? t("示例已发送，等待设备响应") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		if (ok) closeForm();
	} finally {
		endCommand(commandKey);
	}
}

async function testVibration(): Promise<void> {
	const cmd = "0x40";
	if (!beginCommand(cmd)) return;
	try {
		const before = deviceStore.event.lastVibration.value;
		// 对齐状态说明 1.4.4.12 示例: loops=1, count=2, 500ms震,1000ms静,800ms震
		const spec: VibrationSpec = {
			loops: 1,
			count: 2,
			onOffMs: [500, 1000, 800]
		};
		setCommandResponse(cmd, t("发送中: 500ms/1000ms/800ms"));
		const ok = await deviceStore.protocol.controlVibration(spec);
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return;
		}
		setCommandResponse(cmd, t("已发送，等待 0x40 响应"));
		const v = await waitForVibration(before, 2500);
		if (v != null) {
			setCommandResponse(cmd, v.code == 0 ? t("code=0 (成功)") : `code=${v.code}`);
			ui.showToast({
				message: v.code == 0 ? t("震动命令成功") : t("震动命令失败"),
				type: v.code == 0 ? "success" : "error"
			});
		} else {
			setCommandResponse(cmd, t("已发送，但未收到 0x40 响应"));
			ui.showToast({ message: t("未收到震动响应"), type: "warn" });
		}
	} finally {
		endCommand(cmd);
	}
}

/* ===== v5 历史数据展示用 computed ===== */

type VitalText = {
	summary: string;
	start: string;
	directionMinutes: string;
	valid: string;
	ppi: string;
	status: string;
	rmssdSdnn: string;
	vital: string;
};
type EventText = {
	summary: string;
	header: string;
	count: string;
	items: string;
};

function getBehaviorLabel(value: number): string {
	if (value == 0) return t("休息");
	if (value == 1) return t("日常生活");
	if (value == 2) return t("步行");
	if (value == 3) return t("跑步");
	if (value == 4) return t("骑行");
	if (value == 5) return t("有氧运动");
	if (value == 6) return t("其他运动");
	if (value == 7) return t("保留");
	return t("未知");
}

function getActivityLabel(value: number): string {
	if (value == 0) return t("深度睡眠");
	if (value == 1) return t("浅度睡眠");
	if (value == 2) return t("其他睡眠");
	if (value == 3) return t("精神放松");
	if (value == 4) return t("活动量低");
	if (value == 5) return t("活动量高");
	if (value == 6) return t("精神兴奋");
	if (value == 7) return t("身体压力");
	return t("未知");
}

function formatStatusByte(status: number): string {
	const reserved = (status >> 6) & 0x03;
	const behavior = (status >> 3) & 0x07;
	const activity = status & 0x07;
	return `0x${toByteHex(status)} rsv=${reserved} b${behavior}(${getBehaviorLabel(behavior)}) a${activity}(${getActivityLabel(activity)})`;
}

function formatEventParsed(value: UTSJSONObject): string {
	const text = JSON.stringify(value);
	if (text == null || text == "") return "{}";
	return text;
}

function getJsonNumber(value: UTSJSONObject, key: string): number {
	const raw = value[key];
	if (raw == null) return 0;
	return raw as number;
}

function getJsonString(value: UTSJSONObject, key: string): string {
	const raw = value[key];
	if (raw == null) return "";
	return raw as string;
}

function formatDurationSeconds(sec: number): string {
	if (sec <= 0) return "0s";
	const h = Math.floor(sec / 3600);
	const m = Math.floor((sec % 3600) / 60);
	const s = sec % 60;
	if (h > 0) return `${h}h${m}m${s}s`;
	if (m > 0) return `${m}m${s}s`;
	return `${s}s`;
}

function formatEventParsedByType(eventType: number, parsed: UTSJSONObject): string {
	if (
		eventType == LOG_EVENT_TYPE.Text ||
		eventType == LOG_EVENT_TYPE.RemoteCmd ||
		eventType == LOG_EVENT_TYPE.SetDeviceSn
	) {
		return `text="${getJsonString(parsed, "text")}"`;
	}
	if (eventType == LOG_EVENT_TYPE.Reset) {
		return `reason=${getJsonNumber(parsed, "value")}`;
	}
	if (eventType == LOG_EVENT_TYPE.SetTime) {
		const oldSec = getJsonNumber(parsed, "oldSec");
		const newSec = getJsonNumber(parsed, "newSec");
		return `old=${oldSec} ${new Date(oldSec * 1000).toLocaleString()} -> new=${newSec} ${new Date(newSec * 1000).toLocaleString()}`;
	}
	if (eventType == LOG_EVENT_TYPE.FormatDS || eventType == LOG_EVENT_TYPE.SflashErase) {
		return `address=${getJsonNumber(parsed, "address")}`;
	}
	if (eventType == LOG_EVENT_TYPE.Wear) {
		const before = getJsonNumber(parsed, "before");
		const after = getJsonNumber(parsed, "after");
		return `wear ${before == 1 ? t("佩戴") : t("未佩戴")} -> ${after == 1 ? t("佩戴") : t("未佩戴")}`;
	}
	if (eventType == LOG_EVENT_TYPE.SleepResult) {
		const onset = getJsonNumber(parsed, "sleepOnsetSec");
		const awake = getJsonNumber(parsed, "awakeSec");
		const light = getJsonNumber(parsed, "lightSleepSec");
		const deep = getJsonNumber(parsed, "deepSleepSec");
		const other = getJsonNumber(parsed, "otherSleepSec");
		const restHr = getJsonNumber(parsed, "restHr");
		return `sleep onset=${onset} awake=${awake} light=${formatDurationSeconds(light)} deep=${formatDurationSeconds(deep)} other=${formatDurationSeconds(other)} restHr=${restHr}`;
	}
	if (eventType == LOG_EVENT_TYPE.Sedentary) {
		return `threshold=${formatDurationSeconds(getJsonNumber(parsed, "thresholdSec"))}`;
	}
	if (eventType == LOG_EVENT_TYPE.SetBiometricInfo) {
		return `gender=${getJsonNumber(parsed, "gender")} weight=${(getJsonNumber(parsed, "weight") / 100).toFixed(1)}kg height=${(getJsonNumber(parsed, "height") / 100).toFixed(1)}cm age=${getJsonNumber(parsed, "age")} ppg=${getJsonNumber(parsed, "ppgPosition")} bhr=${getJsonNumber(parsed, "bhr")}`;
	}
	return formatEventParsed(parsed);
}

const vitalText = computed<VitalText>(() => {
	const r = deviceStore.history.vitalDataResponse.value;
	if (r == null) {
		return {
			summary: "-",
			start: "-",
			directionMinutes: "-",
			valid: "-",
			ppi: "-",
			status: "-",
			rmssdSdnn: "-",
			vital: "-"
		};
	}
	const startTime =
		r.startSec > 0 ? new Date(r.startSec * 1000).toLocaleString() : t("无后续数据");
	const directionText =
		r.direction == 0
			? t("向前")
			: r.direction == 1
				? t("向后")
				: `${t("未知")}(${r.direction})`;
	const start = `${r.startSec} (${startTime})`;
	const directionMinutes = `${directionText} / ${r.n}min`;
	let validCount = 0;
	let ppiCount = 0;
	for (let i = 0; i < r.vitalData.length; i++) {
		if (r.vitalData[i].valid == true) validCount++;
		if (r.vitalData[i].ppi > 0) ppiCount++;
	}
	const expectedCount = r.n * 60;
	const valid = `${validCount}/${r.vitalData.length}`;
	const ppi = `${ppiCount}/${r.vitalData.length}`;
	const summary = `${validCount}/${expectedCount} ${t("有效")} · ${ppiCount} PPI`;
	let status = `${validCount}/${r.vitalData.length} ${t("心率有效")}，${ppiCount}/${r.vitalData.length} PPI，expected=${expectedCount}`;
	if (r.startSec == 0) {
		status = t("设备返回时间戳 0，后面没有数据，不需要续读");
	} else if (r.vitalData.length == 0) {
		status = t("本段无逐秒数据，可点击 0x3B 继续读下一段");
	} else if (r.vitalData.length < expectedCount) {
		status = `${status}；${t("本段数据长度不足，后半段无有效数据，可按需续读")}`;
	} else if (validCount == 0) {
		status = `${status}；${t("本段全为无效或空白数据")}`;
	}
	const rmssdSdnn = r.rmssdSdnn
		.slice(0, 10)
		.map((p, i) =>
			p.valid == true
				? `m${i + 1}:${p.rmssd.toFixed(1)}/${p.sdnn.toFixed(1)}`
				: `m${i + 1}:FF`
		)
		.join(",");
	const vital = r.vitalData
		.slice(0, 30)
		.map((d, i) => {
			if (d.valid == false) return `${i}s:FF`;
			const behavior = (d.status >> 3) & 0x07;
			const activity = d.status & 0x07;
			const ppi = d.ppi > 0 ? `${d.ppi}ms` : "PPI-";
			return `${i}s hr=${d.hr} ppi=${ppi} pitch=${d.pitch} acc=${d.acc} ${formatStatusByte(d.status)} b=${getBehaviorLabel(behavior)} a=${getActivityLabel(activity)}`;
		})
		.join(" ");
	return { summary, start, directionMinutes, valid, ppi, status, rmssdSdnn, vital };
});

const hasVitalData = computed<boolean>(() => {
	return deviceStore.history.vitalDataResponse.value != null;
});

const eventText = computed<EventText>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	const list = deviceStore.history.eventDataList.value;
	if (h == null && list.length == 0) {
		return { summary: "-", header: "-", count: "-", items: "-" };
	}
	const header =
		h == null
			? "-"
			: `type=${h.type} sn[${h.earliestSn}~${h.latestSn}] ts[${h.earliestSec}~${h.latestSec}] ${new Date(h.earliestSec * 1000).toLocaleString()} ~ ${new Date(h.latestSec * 1000).toLocaleString()}`;
	const count = list.length.toString();
	const summary = `${list.length} ${t("条事件")}`;
	const items = list
		.slice(0, 10)
		.map((it) => {
			const typeName = LOG_EVENT_NAMES[it.eventType] ?? "?";
			return `sn=${it.header.sn} global=${it.header.globalSn} ts=${it.ts} ${new Date(it.ts * 1000).toLocaleString()} tick=${it.tick} type=${it.eventType}(${typeName}) len=${it.dataLen} data=${it.eventDataHex} parsed=${formatEventParsedByType(it.eventType, it.parsedEvent)}`;
		})
		.join("\n");
	return { summary, header, count, items };
});

const hasEventData = computed<boolean>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	const list = deviceStore.history.eventDataList.value;
	return h != null || list.length > 0;
});

/* ===== 设备控制 ===== */

function testDisconnect(): void {
	deviceStore.connection.disconnectDevice();
}

function testReconnect(): void {
	ui.showToast({ message: t("测试重连..."), type: "warn" });
	deviceStore.connection.reconnect();
}

function testClearError(): void {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}
//#endif
</script>

