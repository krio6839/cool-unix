<template>
	<cl-page class="device-test-page">
		<cl-topbar
			safe-area-top
			background-color="transparent"
			:title="t('BOOM 设备测试')"
		></cl-topbar>
		<scroll-view class="test-popup-body" scroll-y="true">
			<view class="panel status-panel">
				<view class="panel-header"
					><view
						><cl-text color="white" :size="16" :pt="{ className: 'font-bold' }">{{
							t("设备状态")
						}}</cl-text
						><cl-text color="gray-400" :size="12">{{ testModeText }}</cl-text></view
					><view :class="'state-pill ' + runtimeStateClass"
						><text class="state-pill-text">{{ runtimeStateText }}</text></view
					></view
				>
				<view class="state-overview"
					><view :class="'state-card ' + runtimeStateClass"
						><text class="state-card-label">{{ t("运行态") }}</text
						><text class="state-card-value">{{ runtimeStateText }}</text></view
					><view :class="'state-card ' + channelStateClass"
						><text class="state-card-label">{{ t("通道态") }}</text
						><text class="state-card-value">{{ channelStateText }}</text></view
					></view
				>
				<view class="status-grid"
					><view class="status-cell"
						><text class="cell-label">{{ t("固件版本") }}</text
						><text class="cell-value">{{ fwText }}</text></view
					><view class="status-cell"
						><text class="cell-label">{{ t("设备编号") }}</text
						><text class="cell-value">{{ deviceNumberText }}</text></view
					><view class="status-cell"
						><text class="cell-label">{{ t("BOOM 时戳") }}</text
						><text class="cell-value">{{ boomTimestampText }}</text></view
					><view class="status-cell"
						><text class="cell-label">{{ t("生物识别") }}</text
						><text class="cell-value cell-value-small">{{ bioText }}</text></view
					></view
				>
				<view class="protocol-ready-line"
					><cl-text :color="protocolReady ? 'success' : 'warning'" :size="12">{{
						protocolReadyText
					}}</cl-text></view
				>
			</view>
			<view class="panel broadcast-panel">
				<view class="panel-header"
					><view
						><cl-text color="white" :size="15" :pt="{ className: 'font-bold' }">{{
							t("0x50 实时广播")
						}}</cl-text
						><cl-text color="gray-400" :size="12">{{
							broadcastSubtitleText
						}}</cl-text></view
					><view :class="'state-pill ' + broadcastStateClass"
						><text class="state-pill-text">{{ broadcastStateText }}</text></view
					></view
				>
				<view class="broadcast-hero"
					><view class="metric-large"
						><text class="metric-label">{{ t("心率") }}</text
						><text class="metric-value">{{ rtText.hr }}</text
						><text class="metric-unit">bpm</text></view
					><view class="metric-large"
						><text class="metric-label">{{ t("RMSSD") }}</text
						><text class="metric-value">{{ rtText.hrv }}</text
						><text class="metric-unit">ms</text></view
					><view class="metric-large"
						><text class="metric-label">{{ t("血氧") }}</text
						><text class="metric-value">{{ rtText.spo2 }}</text
						><text class="metric-unit">%</text></view
					></view
				>
				<view class="broadcast-grid"
					><view class="broadcast-cell"
						><text class="cell-label">PPI</text
						><text class="cell-value">{{ rtText.ppi }} ms</text></view
					><view class="broadcast-cell"
						><text class="cell-label">{{ t("电池电压") }}</text
						><text class="cell-value"
							>{{ rtText.voltage }} V / {{ rtText.voltageMv }} mV</text
						></view
					><view class="broadcast-cell"
						><text class="cell-label">{{ t("PPG 佩戴") }}</text
						><text class="cell-value">{{ rtText.ppgAttached }}</text></view
					><view class="broadcast-cell"
						><text class="cell-label">{{ t("事件提示") }}</text
						><text class="cell-value">{{ rtText.eventNotice }}</text></view
					><view class="broadcast-cell"
						><text class="cell-label">{{ t("步数") }}</text
						><text class="cell-value">{{ rtText.steps }}</text></view
					><view class="broadcast-cell"
						><text class="cell-label">{{ t("上次接收") }}</text
						><text class="cell-value">{{ rtText.receivedAt }}</text></view
					></view
				>
			</view>
			<view class="panel baseline-panel">
				<view class="panel-header"
					><view
						><cl-text color="white" :size="15" :pt="{ className: 'font-bold' }">{{
							t("基准时间与缺口")
						}}</cl-text
						><cl-text color="gray-400" :size="12">{{
							t("缺口由 B 与已记账区间相减得出，不落库")
						}}</cl-text></view
					><cl-button
						type="primary"
						color="#334155"
						rounded
						size="small"
						:disabled="baselineLoading"
						@tap="refreshBaselinePanel"
						>{{ t("刷新") }}</cl-button
					></view
				>
				<view class="baseline-grid"
					><view class="baseline-cell"
						><text class="cell-label">{{ t("基准时间 B") }}</text
						><text class="cell-value cell-value-small">{{
							baselinePanel.baselineText
						}}</text></view
					><view class="baseline-cell"
						><text class="cell-label">{{ t("记账上限") }}</text
						><text class="cell-value cell-value-small">{{
							baselinePanel.ceilingText
						}}</text></view
					><view class="baseline-cell"
						><text class="cell-label">{{ t("已记账区间") }}</text
						><text class="cell-value">{{ baselinePanel.readyText }}</text></view
					><view class="baseline-cell"
						><text class="cell-label">{{ t("待补总计") }}</text
						><text class="cell-value">{{ baselinePanel.repairText }}</text></view
					></view
				>
				<text v-if="baselinePanel.errorText != ''" class="baseline-error">{{
					baselinePanel.errorText
				}}</text>
				<text v-if="baselinePanel.gapLines.length == 0" class="baseline-empty">{{
					t("当前没有待补的历史缺口")
				}}</text>
				<view
					v-for="line in baselinePanel.gapLines"
					:key="line"
					class="baseline-gap"
					><text class="baseline-gap-text">{{ line }}</text></view
				>
			</view>
			<view class="entry-grid">
				<cl-button
					v-for="entry in testEntries"
					:key="entry.key"
					type="primary"
					color="#334155"
					rounded
					size="large"
					class="test-entry-button"
					:disabled="isTestEntryDisabled(entry.key)"
					@tap="openTestEntry(entry.key)"
					>{{ entry.label }}</cl-button
				>
			</view>
		</scroll-view>
		<HistoryQuickReadPopup
			v-model:show="quickHistoryPopupVisible"
			:status="quickHistoryStatus"
			:pages="quickHistoryPages"
			:seconds="quickHistorySeconds"
			:days="quickHistoryDays"
			:busy="vitalAutoReading"
			:export-count="vitalHistoryExportResponses.length"
			@read-range="testVitalHistoryRange"
			@stop="stopVitalAutoRead"
			@export="exportVitalHistoryCsv"
		/>
		<HistoryGapRepairPopup
			v-model:show="historyGapRepairPopupVisible"
			:busy="activeCommand == 'HISTORY_GAP'"
			:command-message="getResp('HISTORY_GAP')"
			:revision="historyGapRevision"
			@repair-history-gap="repairHistoryGap"
		/>
		<VitalProtocolPopup
			v-model:show="vitalProtocolPopupVisible"
			:vital-text="vitalText"
			:has-data="hasVitalData"
			:auto-detail="vitalAutoDetail"
			:raw-hex="vitalRawHex"
			:busy="vitalAutoReading"
			@submit="submitVitalFromPopup"
			@stop="stopVitalAutoRead"
		/>
		<EventProtocolPopup
			v-model:show="eventProtocolPopupVisible"
			:event-header="eventHeaderText"
			:event-count="eventCountText"
			:event-items="eventItemsText"
			:has-data="hasEventData"
			:auto-detail="eventAutoDetail"
			:raw-hex="eventRawHex"
			:busy="eventAutoReading"
			@submit="submitEventFromPopup"
			@stop="stopEventAutoRead"
		/>
		<DeviceControlPopup
			v-model:show="deviceControlPopupVisible"
			:busy="activeCommand != ''"
			:is-disabled="isCommandDisabled"
			@command="runDeviceCommand"
			@submit-form="submitDeviceForm"
		/>
		<DataDiagnosticsPopup
			v-model:show="diagnosticsPopupVisible"
			:protocol-logs="protocolLogText"
		/>
	</cl-page>
</template>
<script lang="ts" setup>
//#ifndef H5
import { computed, reactive, ref, watch } from "vue";
import {
	DEVICE_NUMBER_MAX_LEN,
	DOC_EXAMPLES_BY_T,
	EVENT_QUERY_TYPE_ALL,
	EVENT_QUERY_TYPE_BY_TIME,
	PPG_POSITION_OPTIONS,
	dayUts,
	decodeAdvStatus,
	formatRealtimeMetric,
	router,
	t,
	useStore
} from "@/.cool";
import type {
	DocExample,
	VibrationResult,
	VibrationSpec,
	VitalBiometric,
	VitalDataQueryResponse,
	ProtocolLogDirection,
	ProtocolLogItem
} from "@/.cool";
import type { PpgPositionOption } from "@/.cool";
import { useUi, type ClSelectOption } from "@/uni_modules/cool-ui";
import type { VitalAutoReadResult } from "@/.cool/store/device/history-reader";
import { buildVitalHistoryCsv } from "@/.cool/bluetooth/history/export";
import { historyBaseline, type HistoryGap } from "@/.cool/bluetooth/history/baseline";
import { saveCsvToDownloads } from "@/uni_modules/boom-csv-saver";
import DataDiagnosticsPopup from "./components/DataDiagnosticsPopup.uvue";
import HistoryGapRepairPopup from "./components/HistoryGapRepairPopup.uvue";
import HistoryQuickReadPopup from "./components/HistoryQuickReadPopup.uvue";
import VitalProtocolPopup from "./components/VitalProtocolPopup.uvue";
import EventProtocolPopup from "./components/EventProtocolPopup.uvue";
import DeviceControlPopup from "./components/DeviceControlPopup.uvue";
import type {
	DevicePopupPayload,
	EventPopupPayload,
	HistoryGapRepairPayload,
	VitalPopupPayload,
	VitalPopupText
} from "./components/types";

/* 0x50 实时数据展示用 computed 类型（9 字段全部 string） */
type RtText = {
	hr: string;
	spo2: string;
	voltage: string;
	voltageMv: string;
	ppi: string;
	hrv: string;
	ppgAttached: string;
	behavior: string;
	activity: string;
	battery: string;
	eventNotice: string;
	bhr: string;
	steps: string;
	calories: string;
	utc: string;
	receivedAt: string;
};

type AdvText = {
	seq: string;
	diff: string;
	deviceId: string;
	rssi: string;
	summary: string;
	parsed: string;
	rawHex: string;
	vHex: string;
};

type TestEntryKey = "quick" | "gap" | "vital" | "event" | "control" | "diagnostics";
type TestEntry = { key: TestEntryKey; label: string };

const ui = useUi();
const { device: deviceStore } = useStore();

const protocolLogVisible = ref(false);
const databasePopupVisible = ref(false);
const historyGapRepairPopupVisible = ref(false);
/**
 * 测试页手动补录直接调用 history.readVitalGapGroup，不经过心跳，
 * 因此不会更新 lastHistorySyncAt。补完必须自己抬一次版本，否则弹窗和基准面板
 * 留着补录之前的旧缺口。
 */
const manualHistoryRevision = ref<number>(0);
const historyGapRevision = computed<number>(() => {
	const plannedAt = deviceStore.tick.lastCheckAt.value;
	const completedAt = deviceStore.tick.lastHistorySyncAt.value;
	const manualAt = manualHistoryRevision.value;
	const latest = plannedAt > completedAt ? plannedAt : completedAt;
	return manualAt > latest ? manualAt : latest;
});
const quickHistoryPopupVisible = ref(false);
/**
 * 基准时间面板：直接展示 `B`、`vital_ready_ranges` 与由此推出的缺口。
 *
 * 面板不轮询数据库——它挂在 `historyGapRevision` 上，只有规划/补录真的发生过才重读，
 * 否则 30 天保留窗口下每帧广播都去查一次小表是白烧电。
 */
type BaselinePanelState = {
	baselineText: string;
	ceilingText: string;
	readyText: string;
	repairText: string;
	gapLines: string[];
	errorText: string;
};
const baselineLoading = ref(false);
const baselinePanel = ref<BaselinePanelState>({
	baselineText: "-",
	ceilingText: "-",
	readyText: "0",
	repairText: "0",
	gapLines: [],
	errorText: ""
});
/**
 * UTS 把 script setup 编译成 Kotlin 函数体，局部函数没有提升：调用点必须写在
 * 声明之后。下面两个格式化/取时工具被 `refreshBaselinePanel()` 和 0x3A 表单共用，
 * 因此声明必须留在它们最早的调用点之前，不能挪到文件下方。
 */
function getNowSec(): number {
	return Math.floor(Date.now() / 1000);
}

function formatEventWindowTime(sec: number): string {
	return new Date(sec * 1000).toLocaleString();
}

async function refreshBaselinePanel(): Promise<void> {
	if (baselineLoading.value) return;
	baselineLoading.value = true;
	try {
		const nowSec = getNowSec();
		const snapshot = await historyBaseline.snapshot(nowSec);
		const lines: string[] = [];
		for (let i = 0; i < snapshot.gaps.length; i++) {
			const gap = snapshot.gaps[i];
			lines.push(
				`#${i + 1} ${formatEventWindowTime(gap.fromSec)} ~ ${formatEventWindowTime(gap.toSec - 1)}` +
					` | ${t("待补")} ${gap.repairSeconds}s` +
					(gap.bridgeSeconds > 0 ? ` | ${t("桥接跨过")} ${gap.bridgeSeconds}s` : "")
			);
		}
		let total = 0;
		for (let i = 0; i < snapshot.gaps.length; i++) total += snapshot.gaps[i].repairSeconds;
		baselinePanel.value = {
			baselineText: `${snapshot.baseline} (${formatEventWindowTime(snapshot.baseline)})`,
			ceilingText: `${snapshot.ceiling} (${formatEventWindowTime(snapshot.ceiling)})`,
			readyText: snapshot.readyRanges.length.toString(),
			repairText: `${total}s / ${snapshot.gaps.length} ${t("组")}`,
			gapLines: lines,
			errorText: ""
		};
	} catch (error) {
		baselinePanel.value = {
			baselineText: "-",
			ceilingText: "-",
			readyText: "0",
			repairText: "0",
			gapLines: [],
			errorText: `${t("读取基准时间失败")}: ${error}`
		};
	} finally {
		baselineLoading.value = false;
	}
}
// 规划/补录完成后自动重读；`historyGapRevision` 由 sync 的 lastCheckAt/lastHistorySyncAt 驱动。
watch(historyGapRevision, (value: number) => {
	if (value > 0) refreshBaselinePanel();
});
const vitalProtocolPopupVisible = ref(false);
const eventProtocolPopupVisible = ref(false);
const deviceControlPopupVisible = ref(false);
const diagnosticsPopupVisible = ref(false);
const testEntries: TestEntry[] = [
	{ key: "quick", label: t("快速历史读取") },
	{ key: "gap", label: t("历史缺口补录") },
	{ key: "vital", label: t("生命体征协议") },
	{ key: "event", label: t("事件协议") },
	{ key: "control", label: t("设备控制") },
	{ key: "diagnostics", label: t("数据诊断") }
];
const manualRawHex = ref("");
const showStatusSection = ref<boolean>(true);
const showBroadcastSection = ref<boolean>(true);
const showBroadcastDebug = ref<boolean>(false);
const showGattCommandsSection = ref<boolean>(false);
const showHistoryCommandsSection = ref<boolean>(false);
const showVitalResultSection = ref<boolean>(true);
const showEventResultSection = ref<boolean>(true);
const showDeviceControlSection = ref<boolean>(false);
const showMoreSection = ref<boolean>(false);
const protocolLogs = computed<ProtocolLogItem[]>((): ProtocolLogItem[] => {
	return deviceStore.protocolLogs.value.slice();
});
const protocolLogText = computed<string[]>((): string[] => {
	const result: string[] = [];
	for (const item of protocolLogs.value) {
		result.push(
			"[" +
				item.direction +
				"] " +
				item.time +
				" " +
				item.title +
				" " +
				item.detail +
				" " +
				item.hex
		);
	}
	return result;
});

function rawProtocolHex(first: string, second: string): string {
	const result: string[] = [];
	for (const item of protocolLogs.value) {
		if ((item.title.indexOf(first) >= 0 || item.title.indexOf(second) >= 0) && item.hex != "") {
			result.push(item.hex);
		}
	}
	return result.length == 0 ? "-" : result.join("\n");
}

const vitalRawHex = computed<string>(() => rawProtocolHex("0x3A", "0x3B"));
const eventRawHex = computed<string>(() => rawProtocolHex("0x3C", "0x3D"));

function hasBoundBroadcastDebug(): boolean {
	deviceStore.stateVersion.value;
	return deviceStore.broadcastDebug.value != null;
}

const testModeText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.isGattTaskBusy() == true) {
		return `${t("临时连接设备执行命令")}: ${deviceStore.getGattTaskName()}`;
	}
	if (deviceStore.currentDeviceId != "") return t("GATT 已连接，命令会直接执行");
	if (deviceStore.boundDeviceId == "") return t("未绑定设备，无法执行 GATT 命令");
	if (hasBoundBroadcastDebug() == false) return t("已绑定设备，正在等待绑定广播");
	return `${t("广播接收中，点击命令会自动临时连接")}: ${deviceStore.boundDeviceId}`;
});

const runtimeStateText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.isGattTaskBusy() == true) return t("执行中");
	if (deviceStore.currentDeviceId != "") return t("GATT连接");
	if (deviceStore.boundDeviceId == "") return t("未绑定");
	return t("广播接收");
});

const runtimeStateClass = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.isGattTaskBusy() == true) return "state-busy";
	if (deviceStore.currentDeviceId != "") return "state-gatt";
	if (deviceStore.boundDeviceId == "") return "state-warn";
	return "state-broadcast";
});

const channelStateText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.currentDeviceId != "") return t("GATT 已连接");
	if (hasBoundBroadcastDebug() == false) return t("等待广播");
	return t("广播在线");
});

const channelStateClass = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.currentDeviceId != "") return "state-gatt";
	if (hasBoundBroadcastDebug() == false) return "state-warn";
	return "state-broadcast";
});

const broadcastStateText = computed<string>(() => {
	if (hasBoundBroadcastDebug() == false) return t("等待");
	return t("在线");
});

const broadcastStateClass = computed<string>(() => {
	if (hasBoundBroadcastDebug() == false) return "state-warn";
	return "state-broadcast";
});

const broadcastSubtitleText = computed<string>(() => {
	const d = deviceStore.broadcastDebug.value;
	if (d == null) return t("还没有收到绑定设备广播");
	const r = deviceStore.realtime.value;
	const receivedAt =
		r == null
			? new Date(d.receivedAt).toLocaleTimeString()
			: new Date(r.receivedAt).toLocaleTimeString();
	return `${t("最近广播")} #${d.seq} · ${receivedAt}`;
});

/* ===== 展示用 computed ===== */

function collapseText(open: boolean): string {
	return open ? t("收起") : t("展开");
}

function toggleStatusSection(): void {
	showStatusSection.value = !showStatusSection.value;
}

function toggleBroadcastSection(): void {
	showBroadcastSection.value = !showBroadcastSection.value;
}

function toggleBroadcastDebug(): void {
	showBroadcastDebug.value = !showBroadcastDebug.value;
}

function toggleGattCommandsSection(): void {
	showGattCommandsSection.value = !showGattCommandsSection.value;
}

function toggleHistoryCommandsSection(): void {
	showHistoryCommandsSection.value = !showHistoryCommandsSection.value;
}

function toggleVitalResultSection(): void {
	showVitalResultSection.value = !showVitalResultSection.value;
}

function toggleEventResultSection(): void {
	showEventResultSection.value = !showEventResultSection.value;
}

function toggleDeviceControlSection(): void {
	showDeviceControlSection.value = !showDeviceControlSection.value;
}

function toggleMoreSection(): void {
	showMoreSection.value = !showMoreSection.value;
}

function openProtocolLog(): void {
	protocolLogVisible.value = true;
}

function openDatabasePopup(): void {
	databasePopupVisible.value = true;
}

function openDiagnosticsPage(): void {
	router.to("/pages/set/diagnostics");
}

function clearManualRawHex(): void {
	manualRawHex.value = "";
}

function clearProtocolLogs(): void {
	deviceStore.clearProtocolLogs();
}

function normalizeHexInput(hex: string): string {
	return hex.replace(/\s|0x/g, "").toLowerCase();
}

function protocolLogColor(direction: ProtocolLogDirection): string {
	if (direction == "TX") return "success";
	if (direction == "RX") return "primary";
	if (direction == "ERR") return "error";
	return "warning";
}

function toByteHex(value: number): string {
	const item = (value & 0xff).toString(16);
	return item.length == 1 ? "0" + item : item;
}

function formatBiometric(b: VitalBiometric): string {
	return `性别${b.gender} 体重${(b.weight / 100).toFixed(2)}kg 身高${(b.height / 100).toFixed(2)}cm 年龄${b.age} PPG${b.ppgPosition} BHR${b.bhr}`;
}

const fwText = computed<string>(() => {
	const f = deviceStore.event.firmwareVersion.value;
	if (f == null) return "-";
	return `${f.major}.${f.minor}.${f.revision}`;
});

const bioText = computed<string>(() => {
	const b = deviceStore.event.biometricInfo.value;
	if (b == null) return "-";
	return formatBiometric(b);
});

const deviceNumberText = computed<string>(() => {
	const value = deviceStore.event.deviceNumber.value;
	return value == "" ? "-" : value;
});

const boomTimestampText = computed<string>(() => {
	const value = deviceStore.event.boomTimestamp.value;
	return value <= 0 ? "-" : value.toString();
});

function sameBiometric(a: VitalBiometric | null, b: VitalBiometric): boolean {
	if (a == null) return false;
	return (
		a.gender == b.gender &&
		a.weight == b.weight &&
		a.height == b.height &&
		a.age == b.age &&
		a.ppgPosition == b.ppgPosition &&
		a.bhr == b.bhr
	);
}

function isAlphaNumeric(value: string): boolean {
	for (let i = 0; i < value.length; i++) {
		const code = value.charCodeAt(i) ?? 0;
		const isNumber = code >= 48 && code <= 57;
		const isUpper = code >= 65 && code <= 90;
		const isLower = code >= 97 && code <= 122;
		if (isNumber == false && isUpper == false && isLower == false) return false;
	}
	return true;
}

function realtimeMetricText(value: number, valid: boolean, fractionDigits: number): string {
	const text = formatRealtimeMetric(value, valid, fractionDigits);
	return text == "invalid" ? t("无效") : text;
}

const rtText = computed<RtText>(() => {
	const r = deviceStore.realtime.value;
	if (r == null) {
		return {
			hr: "-",
			spo2: "-",
			voltage: "-",
			voltageMv: "-",
			ppi: "-",
			hrv: "-",
			ppgAttached: "-",
			behavior: "-",
			activity: "-",
			battery: "-",
			eventNotice: "-",
			bhr: "-",
			steps: "-",
			calories: "-",
			utc: "-",
			receivedAt: "-"
		};
	}
	return {
		hr: realtimeMetricText(r.hr, r.hrValid, 0),
		spo2: realtimeMetricText(r.spo2Pct, r.spo2Valid, 1),
		voltage: r.voltageV.toFixed(3),
		voltageMv: r.voltageMv.toString(),
		ppi: realtimeMetricText(r.ppi, r.ppiValid, 0),
		hrv: realtimeMetricText(r.rmssd, r.rmssdValid, 0),
		ppgAttached: r.ppgAttached ? t("已佩戴") : t("未佩戴"),
		behavior: `${r.behavior} ${r.behaviorLabel}`,
		activity: `${r.activity} ${r.activityLabel}`,
		battery: `${r.batteryStatus} ${r.batteryStatusLabel}`,
		eventNotice: `seq=${r.eventSeq} ${r.hasNewEvent ? t("有新事件") : t("无新事件")}`,
		bhr: realtimeMetricText(r.bhr, r.bhrValid, 0),
		steps: r.stepsEveryday.toString(),
		calories: r.calorieKcal.toFixed(1),
		utc: r.utc > 0 ? new Date(r.utc * 1000).toLocaleString() : "0",
		receivedAt: new Date(r.receivedAt).toLocaleTimeString()
	};
});

const advText = computed<AdvText>(() => {
	const d = deviceStore.broadcastDebug.value;
	if (d == null) {
		return {
			seq: "-",
			diff: "-",
			deviceId: "-",
			rssi: "-",
			summary: "-",
			parsed: "-",
			rawHex: "-",
			vHex: "-"
		};
	}
	const r = deviceStore.realtime.value;
	let parsed = "-";
	if (r != null) {
		parsed = `utc=${r.utc} ${rtText.value.utc} received=${rtText.value.receivedAt} eventSeq=${r.eventSeq} newEvent=${r.hasNewEvent} battery=${r.batteryStatus}(${r.batteryStatusLabel}) ppg=${r.ppgAttached} behavior=${r.behavior}(${r.behaviorLabel}) activity=${r.activity}(${r.activityLabel}) hr=${r.hr} valid=${r.hrValid} ppi=${r.ppi} valid=${r.ppiValid} rmssd=${r.rmssd.toFixed(2)}ms hrv=${r.hrvMs} valid=${r.rmssdValid} spo2=${r.spo2Pct.toFixed(1)} valid=${r.spo2Valid} bhr=${r.bhr} valid=${r.bhrValid} steps=${r.stepsEveryday} calories=${r.calorieKcal.toFixed(1)}kcal voltage=${r.voltageMv}mV/${r.voltageV.toFixed(3)}V`;
	}
	return {
		seq: d.seq.toString(),
		diff: `diff=${d.diffSec}s`,
		deviceId: d.deviceId,
		rssi: `${d.rssi} dBm`,
		summary: `${d.summary} ${new Date(d.receivedAt).toLocaleTimeString()}`,
		parsed,
		rawHex: d.rawHex,
		vHex: d.vHex
	};
});

/* ===== 响应展示 ref + 11 个 computed ===== */

/** 每个 T 码的响应摘要（key 为十六进制字符串，如 "0x30"） */
type LastResponse = Record<string, string>;
const lastResponse = reactive<LastResponse>({});
const activeCommand = ref<string>("");

function getResp(cmd: string): string {
	const v = lastResponse[cmd];
	return v == null || v == "" ? "-" : v;
}

const protocolReady = computed<boolean>(() => {
	deviceStore.stateVersion.value;
	return (
		deviceStore.status.value == "CONNECTED" &&
		deviceStore.protocol.writeCharUuid != "" &&
		deviceStore.protocol.notifyCharUuid != ""
	);
});

const protocolReadyText = computed<string>(() => {
	deviceStore.stateVersion.value;
	if (deviceStore.isGattTaskBusy() == true) {
		return `${t("GATT 任务执行中")}: ${deviceStore.getGattTaskName()}`;
	}
	if (deviceStore.boundDeviceId == "") return t("未绑定设备，无法执行 GATT 命令");
	if (deviceStore.status.value != "CONNECTED") return t("设备未连接，测试命令暂不可用");
	if (deviceStore.protocol.writeCharUuid == "") return t("未发现写入特征，请重新连接设备");
	if (deviceStore.protocol.notifyCharUuid == "") return t("未发现通知特征，请重新连接设备");
	return t("协议已就绪，可以发送测试命令");
});

function isCommandDisabled(cmd: string): boolean {
	return activeCommand.value != "";
}

function isTestEntryDisabled(key: TestEntryKey): boolean {
	return activeCommand.value != "" && key != "quick" && key != "vital" && key != "event";
}

function openTestEntry(key: TestEntryKey): void {
	if (key == "quick") {
		quickHistoryPopupVisible.value = true;
		return;
	}
	if (key == "gap") {
		historyGapRepairPopupVisible.value = true;
		return;
	}
	if (key == "vital") {
		vitalProtocolPopupVisible.value = true;
		return;
	}
	if (key == "event") {
		eventProtocolPopupVisible.value = true;
		return;
	}
	if (key == "control") {
		deviceControlPopupVisible.value = true;
		return;
	}
	if (key == "diagnostics") {
		diagnosticsPopupVisible.value = true;
		return;
	}
}

function setCommandResponse(cmd: string, message: string): void {
	const time = new Date().toLocaleTimeString();
	lastResponse[cmd] = `${time} ${message}`;
}

function beginCommand(cmd: string): boolean {
	if (deviceStore.boundDeviceId == "") {
		ui.showToast({ message: t("请先连接/绑定设备"), type: "warn" });
		return false;
	}
	if (activeCommand.value != "") {
		ui.showToast({ message: t("已有命令发送中，请稍候"), type: "warn" });
		return false;
	}
	activeCommand.value = cmd;
	setCommandResponse(cmd, t("发送中..."));
	return true;
}

function endCommand(cmd: string): void {
	if (activeCommand.value == cmd) {
		activeCommand.value = "";
	}
}

async function runQueuedGattCommand(cmd: string, runner: () => Promise<boolean>): Promise<boolean> {
	if (!beginCommand(cmd)) return false;
	const queuedText = t("已入队，等待 GATT 执行");
	setCommandResponse(cmd, queuedText);
	const ok = await deviceStore.scheduler.runManualGattTask(cmd, runner);
	if (ok == false) {
		const latest = getResp(cmd);
		if (latest.indexOf(queuedText) >= 0) {
			setCommandResponse(cmd, t("连接失败或命令执行失败"));
		}
		ui.showToast({ message: t("命令执行失败"), type: "error" });
	}
	endCommand(cmd);
	return ok;
}

function historyGapResultText(result: VitalAutoReadResult): string {
	if (result.message == "0x3A send failed") return t("补录失败：0x3A 发送失败");
	if (result.message == "0x3B send failed") return t("补录失败：0x3B 发送失败");
	if (result.message == "wait vital response timeout") return t("补录失败：等待设备响应超时");
	if (result.message == "gatt busy") return t("补录失败：GATT 通道忙");
	if (result.message == "no bound device") return t("补录失败：没有绑定设备");
	if (result.saveOk == false) return t("补录失败：页面处理未完成");
	if (result.status != "DONE") return t("补录未完成") + "：" + result.message;
	if (result.savedRecords == 0) return t("补录完成：设备未返回有效生命体征");
	return t("连续缺口补录完成");
}

/** 测试页指定 SQLite 中的一条待补任务，仍复用正式的逐页落库与游标推进流程。 */
async function repairHistoryGap(payload: HistoryGapRepairPayload): Promise<void> {
	if (payload.toSec <= payload.fromSec) return;
	const ok = await runQueuedGattCommand("HISTORY_GAP", async () => {
		try {
			setCommandResponse("HISTORY_GAP", `${t("连续缺口补录")} 0x3A → 0x3B`);
			// 直接按缺口端点读，不再先查任务行：缺口是推算出来的，没有可寻址的表行。
			const gap: HistoryGap = {
				fromSec: payload.fromSec,
				toSec: payload.toSec,
				repairSeconds: payload.toSec - payload.fromSec,
				bridgeSeconds: 0
			};
			const result = await deviceStore.history.readVitalGapGroup(gap);
			setCommandResponse(
				"HISTORY_GAP",
				`${historyGapResultText(result)}, ${t("页数")} ${result.pages}, ${t("保存")} ${result.savedRecords}`
			);
			return result.saveOk && result.status == "DONE";
		} catch (error) {
			setCommandResponse("HISTORY_GAP", `${t("指定缺口补录失败")}: ${error}`);
			return false;
		}
	});
	// 手动补录不经过 sync，主动抬版本让弹窗重读本批缺口。
	manualHistoryRevision.value = Date.now();
	ui.showToast({
		message: ok ? t("连续缺口补录已完成") : t("连续缺口补录失败"),
		type: ok ? "success" : "error"
	});
}

async function sendManualRawHex(): Promise<void> {
	const hex = normalizeHexInput(manualRawHex.value);
	if (hex.length == 0) {
		ui.showToast({ message: t("请输入 hex 帧"), type: "error" });
		return;
	}
	if (hex.length % 2 != 0) {
		ui.showToast({ message: t("hex 长度必须是偶数"), type: "error" });
		return;
	}
	if (/^[0-9a-f]+$/.test(hex) == false) {
		ui.showToast({ message: t("hex 只能包含 0-9/a-f"), type: "error" });
		return;
	}
	await runQueuedGattCommand("RAW", async (): Promise<boolean> => {
		const ok = await deviceStore.protocol.sendRawFrame(hex);
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		return ok;
	});
}

function sleep(ms: number): Promise<void> {
	return new Promise<void>((resolve) => {
		setTimeout(() => {
			resolve();
		}, ms);
	});
}

async function waitForBiometric(
	beforeSeq: number,
	sentAt: number,
	expected: VitalBiometric | null,
	timeoutMs: number
): Promise<VitalBiometric | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.biometricInfo.value;
		if (current != null) {
			if (expected != null && sameBiometric(current, expected)) return current;
			if (
				expected == null &&
				(deviceStore.event.biometricInfoSeq.value > beforeSeq ||
					deviceStore.event.biometricInfoReceivedAt.value >= sentAt)
			) {
				return current;
			}
		}
		await sleep(150);
	}
	return null;
}

async function waitForVibration(
	before: VibrationResult | null,
	timeoutMs: number
): Promise<VibrationResult | null> {
	const start = Date.now();
	while (Date.now() - start < timeoutMs) {
		const current = deviceStore.event.lastVibration.value;
		if (current != null && current !== before) return current;
		await sleep(150);
	}
	return null;
}

const vitalAutoReading = ref<boolean>(false);
const eventAutoReading = ref<boolean>(false);
const vitalAutoDetail = ref<string>("-");
const eventAutoDetail = ref<string>("-");
/** 快速历史读取结束后保留本次所有页面，供 CSV 导出；不混入手动 0x3A 调试结果。 */
const vitalHistoryExportResponses = ref<VitalDataQueryResponse[]>([]);
const quickHistoryStatus = ref<string>(t("尚未读取"));
const quickHistoryPages = ref<number>(0);
const quickHistorySeconds = ref<number>(0);
const quickHistoryDays = ref<number>(0);
const VITAL_FORM_DEFAULT_OFFSET_SECONDS = 120;
const VITAL_HISTORY_TEST_MINUTES = 2;

/* ===== 参数输入子弹窗状态 ===== */

/** 当前打开的表单类型（空=未打开） */
const activeForm = ref<"" | "0x31" | "0x35" | "0x3A" | "0x3C">("");
/** 子弹窗显示控制（v-model 双向绑定） */
const formVisible = ref(false);

const formTitle = computed<string>(() => {
	switch (activeForm.value) {
		case "0x31":
			return t("设置设备编号");
		case "0x35":
			return t("0x35 写生物识别");
		case "0x3A":
			return t("生命体征读取流程");
		case "0x3C":
			return t("事件读取流程");
		default:
			return "";
	}
});

/** 表单数据（按字段分独立 ref，避免 Ref<T, S> 联合类型推断问题） */
const formDeviceNumber = ref<string>("");
const formStartSec = ref<string>("0");
const formEndSec = ref<string>("0");
const formEventRange = ref<string[]>([]);
const formMaxCount = ref<string>("10");
const formDirection = ref<number>(0);
const formMinutes = ref<number>(2);
const formType = ref<number>(0);
// 0x35 生物识别表单字段
const formGender = ref<number>(0);
const formWeight = ref<string>("7000");
const formHeight = ref<string>("18000");
const formAge = ref<string>("20");
const formPpgPosition = ref<number>(0);
const formBhr = ref<string>("60");

/** 方向选项（0=向前 1=向后） */
const directionOptions: ClSelectOption[] = [
	{ label: t("向前 (0)"), value: 0 },
	{ label: t("向后 (1)"), value: 1 }
];

/** 分钟数选项（2 / 5） */
const minutesOptions: ClSelectOption[] = [
	{ label: t("2 分钟"), value: 2 },
	{ label: t("5 分钟"), value: 5 }
];

/** 事件查询类型：Byte1=0 全部，Byte1=1 按时间窗口 */
const eventTypeOptions: ClSelectOption[] = [
	{ label: t("按时间读取全部事件 (1)"), value: EVENT_QUERY_TYPE_BY_TIME },
	{ label: t("读取全部事件 (0)"), value: EVENT_QUERY_TYPE_ALL }
];

/** 性别选项（0=男 1=女） */
const genderOptions: ClSelectOption[] = [
	{ label: t("男 (0)"), value: 0 },
	{ label: t("女 (1)"), value: 1 }
];

/** PPG 位置选项（0~6，与协议 UINT8 保持一致） */
const ppgPositionOptions: ClSelectOption[] = PPG_POSITION_OPTIONS.map(
	(item: PpgPositionOption): ClSelectOption => ({
		label: `${t(item.label)} (${item.value})`,
		value: item.value
	})
);

/** 当前表单可用的文档示例（按 T 码查 DOC_EXAMPLES_BY_T） */
const exampleList = computed<DocExample[]>(() => {
	if (activeForm.value == "") return [];
	const tCode = parseInt(activeForm.value, 16);
	return DOC_EXAMPLES_BY_T.get(tCode) ?? [];
});

function resetVitalFormToCurrentWindow(): void {
	const now = getNowSec();
	const startSec = now - VITAL_FORM_DEFAULT_OFFSET_SECONDS;
	formStartSec.value = startSec.toString();
	formDirection.value = 0;
	formMinutes.value = 2;
	console.log(`[BOOM-TEST] 打开 0x3A 表单，刷新默认时间: nowSec=${now}, startSec=${startSec}`);
}

/** 当前整分钟是 0x3A 的查询锚点；后续 0x3B 按设备的实际页向更早时间推进。 */
function getCurrentMinuteSec(): number {
	return Math.floor(getNowSec() / 60) * 60;
}

/**
 * 测试页预设范围：从当前时间开始向过去连续读取。
 * “无有效秒”不是结束条件；只在实际返回页到达目标时间或设备明确无更早页时结束。
 */
async function testVitalHistoryRange(days: number): Promise<void> {
	const anchorSec = getCurrentMinuteSec();
	const targetStartSec = anchorSec - days * 24 * 60 * 60;
	let reachedTarget = false;
	vitalAutoReading.value = true;
	vitalAutoDetail.value = "-";
	vitalHistoryExportResponses.value = [];
	quickHistoryDays.value = days;
	quickHistoryPages.value = 0;
	quickHistorySeconds.value = 0;
	quickHistoryStatus.value = `${formatEventWindowTime(targetStartSec)} ~ ${formatEventWindowTime(anchorSec)}`;
	await runQueuedGattCommand("VITAL", async (): Promise<boolean> => {
		setCommandResponse(
			"VITAL",
			`${t("开始读取近")} ${days} ${t("天")}: ${formatEventWindowTime(targetStartSec)} ~ ${formatEventWindowTime(anchorSec)}`
		);
		const result = await deviceStore.history.readVitalDataAuto({
			startSec: anchorSec,
			direction: 0,
			minutes: VITAL_HISTORY_TEST_MINUTES,
			// 独立测试不设总页数上限；按目标范围读取，或由用户手动停止。
			maxPages: 0,
			pageDelayMs: 250,
			shouldStop: () => vitalAutoReading.value == false || reachedTarget,
			onProgress: (p) => {
				if (p.phase == "0x3B" && p.page % 20 == 0) {
					setCommandResponse("VITAL", `${t("连续向前读取")} ${p.page} ${t("段")}`);
				}
			},
			onPage: (response, page) => {
				quickHistoryPages.value = page;
				quickHistorySeconds.value += response.vitalData.length;
				if (response.startSec > 0 && response.startSec <= targetStartSec) {
					reachedTarget = true;
				}
				if (page % 20 != 0 && reachedTarget == false && response.startSec != 0) return;
				setCommandResponse(
					"VITAL",
					`${page} ${t("段")} ${formatEventWindowTime(response.startSec)}${
						reachedTarget ? ` · ${t("已到达目标时间")}` : ""
					}`
				);
			}
		});
		vitalHistoryExportResponses.value = result.responses;
		vitalAutoDetail.value = deviceStore.history.formatVitalAutoDetail(result.responses);
		vitalAutoReading.value = false;
		const completion = reachedTarget
			? `${t("读取近")} ${days} ${t("天完成")}`
			: result.done
				? t("设备没有更早历史数据")
				: result.stoppedByLimit
					? `${t("达到页数保护上限")} ${result.pages}`
					: t("读取已停止");
		setCommandResponse(
			"VITAL",
			`${completion}: ${t("读取")} ${result.pages} ${t("段，保存")} ${result.savedRecords}`
		);
		quickHistoryStatus.value = `${completion} · ${t("已保留本次解析数据，可保存到下载")}`;
		return true;
	});
	vitalAutoReading.value = false;
}

/** 将本次快速历史读取的全部解析秒写入手机公共 Download/BOOM 目录。 */
function exportVitalHistoryCsv(): void {
	if (vitalHistoryExportResponses.value.length == 0) {
		ui.showToast({ message: t("没有可导出的历史读取结果"), type: "warn" });
		return;
	}
	const csv = buildVitalHistoryCsv(vitalHistoryExportResponses.value);
	const fileName = `boom-vital-${quickHistoryDays.value}d-${Date.now()}.csv`;
	try {
		const filePath = saveCsvToDownloads(fileName, csv);
		quickHistoryStatus.value = `${t("CSV 已保存")}: ${filePath}`;
		ui.showToast({ message: t("CSV 已保存") });
	} catch (error) {
		console.error("[BOOM-HISTORY] CSV 写入下载目录失败", error);
		ui.showToast({ message: t("CSV 写入失败"), type: "error" });
	}
}

function formatEventPickerTime(sec: number): string {
	return dayUts(new Date(sec * 1000)).format("YYYY-MM-DD HH:mm:ss");
}

function syncEventWindowSec(startSec: number, endSec: number): void {
	formStartSec.value = startSec.toString();
	formEndSec.value = endSec.toString();
	formEventRange.value = [formatEventPickerTime(startSec), formatEventPickerTime(endSec)];
}

function setEventWindowMinutes(minutes: number): void {
	const now = getNowSec();
	const start = now - minutes * 60;
	formType.value = EVENT_QUERY_TYPE_BY_TIME;
	syncEventWindowSec(start, now);
}

function setEventWindowAll(): void {
	formType.value = EVENT_QUERY_TYPE_ALL;
	formStartSec.value = "0";
	formEndSec.value = "0";
	formEventRange.value = [];
}

function parseEventPickerSec(value: string): number {
	if (value == "") return 0;
	const ms = dayUts(value).valueOf();
	if (Number.isNaN(ms)) return 0;
	return Math.floor(ms / 1000);
}

const eventWindowPreviewText = computed<string>(() => {
	if (formType.value == EVENT_QUERY_TYPE_ALL) {
		return t("读取全部事件，不使用时间范围");
	}
	let startSec = parseInt(formStartSec.value, 10);
	let endSec = parseInt(formEndSec.value, 10);
	if (formEventRange.value.length >= 2) {
		const pickedStart = parseEventPickerSec(formEventRange.value[0]);
		const pickedEnd = parseEventPickerSec(formEventRange.value[1]);
		if (pickedStart > 0 && pickedEnd > 0) {
			startSec = pickedStart;
			endSec = pickedEnd;
		}
	}
	if (Number.isNaN(startSec) || Number.isNaN(endSec) || startSec <= 0 || endSec <= 0) {
		return `${t("协议秒")}: -`;
	}
	return `${t("协议秒")}: ${startSec} ~ ${endSec}`;
});

/** 打开子弹窗并重置默认值 */
function openForm(cmd: "0x31" | "0x35" | "0x3A" | "0x3C"): void {
	switch (cmd) {
		case "0x31":
			formDeviceNumber.value = "";
			break;
		case "0x35":
			formGender.value = 0;
			formWeight.value = "7000";
			formHeight.value = "18000";
			formAge.value = "20";
			formPpgPosition.value = 0;
			formBhr.value = "60";
			break;
		case "0x3A":
			resetVitalFormToCurrentWindow();
			break;
		case "0x3C": {
			const now = getNowSec();
			formType.value = EVENT_QUERY_TYPE_BY_TIME;
			syncEventWindowSec(now - 24 * 60 * 60, now);
			formMaxCount.value = "30";
			break;
		}
	}
	activeForm.value = cmd;
	formVisible.value = true;
}

/** 关闭子弹窗 */
function closeForm(): void {
	formVisible.value = false;
	activeForm.value = "";
}

/** 提交表单（按 activeForm 分派） */
async function submitForm(): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	let shouldClose = false;
	switch (cmd) {
		case "0x31": {
			const num = formDeviceNumber.value.trim();
			if (num.length == 0 || num.length > DEVICE_NUMBER_MAX_LEN) {
				ui.showToast({ message: t("编号长度需 1~29 位"), type: "error" });
				return;
			}
			if (isAlphaNumeric(num) == false) {
				ui.showToast({ message: t("设备编号只能包含数字和字母"), type: "error" });
				return;
			}
			const ok = await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
				ui.showToast({ message: t("0x31 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setDeviceNumber(num);
				setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
				ui.showToast({
					message: ok ? t("0x31 已发送") : t("发送失败"),
					type: ok ? "success" : "error"
				});
				return ok;
			});
			shouldClose = ok;
			break;
		}
		case "0x35": {
			const w = parseInt(formWeight.value, 10);
			const h = parseInt(formHeight.value, 10);
			const a = parseInt(formAge.value, 10);
			const b = parseInt(formBhr.value, 10);
			if (Number.isNaN(w) || w < 1000 || w > 65000) {
				ui.showToast({ message: t("体重需 1000~65000"), type: "error" });
				return;
			}
			if (Number.isNaN(h) || h < 10000 || h > 28000) {
				ui.showToast({ message: t("身高需 10000~28000"), type: "error" });
				return;
			}
			if (Number.isNaN(a) || a < 10 || a > 99) {
				ui.showToast({ message: t("年龄需 10~99"), type: "error" });
				return;
			}
			if (Number.isNaN(b) || b < 28 || b > 240) {
				ui.showToast({ message: t("BHR 需 28~240"), type: "error" });
				return;
			}
			const req: VitalBiometric = {
				gender: formGender.value,
				weight: w,
				height: h,
				age: a,
				ppgPosition: formPpgPosition.value,
				bhr: b
			};
			const ok = await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
				const beforeSeq = deviceStore.event.biometricInfoSeq.value;
				const sentAt = Date.now();
				ui.showToast({ message: t("0x35 发送..."), type: "warn" });
				const ok = await deviceStore.protocol.setBiometric(req);
				if (!ok) {
					setCommandResponse(cmd, t("发送失败，请重试"));
					ui.showToast({ message: t("发送失败"), type: "error" });
					return false;
				}
				setCommandResponse(cmd, t("已发送，等待设备确认"));
				const confirmed = await waitForBiometric(beforeSeq, sentAt, req, 2500);
				if (confirmed != null) {
					setCommandResponse(cmd, `${t("设备已确认")} ${formatBiometric(confirmed)}`);
					ui.showToast({ message: t("设备已确认写入"), type: "success" });
				} else {
					setCommandResponse(cmd, t("已发送，但未收到 0x35 确认"));
					ui.showToast({ message: t("未收到写入确认，可手动读回验证"), type: "warn" });
				}
				setCommandResponse("0x36", t("如需验证，请手动点击 0x36 读生物识别"));
				return true;
			});
			shouldClose = ok;
			break;
		}
		case "0x3A": {
			const startSec = parseInt(formStartSec.value, 10);
			if (Number.isNaN(startSec) || startSec <= 0) {
				ui.showToast({ message: t("起始时戳必须是正数"), type: "error" });
				return;
			}
			vitalAutoReading.value = true;
			vitalAutoDetail.value = "-";
			closeForm();
			await runQueuedGattCommand("VITAL", async (): Promise<boolean> => {
				vitalAutoReading.value = true;
				vitalAutoDetail.value = "-";
				setCommandResponse("VITAL", t("0x3A 已开始，自动续读中"));
				const result = await deviceStore.history.readVitalDataAuto({
					startSec,
					direction: formDirection.value,
					minutes: formMinutes.value,
					// 手动协议测试持续读取，只有用户停止或设备结束才退出。
					maxPages: 0,
					pageDelayMs: 250,
					shouldStop: () => vitalAutoReading.value == false,
					onProgress: (p) => {
						if (p.phase == "0x3B" && p.page % 5 == 0) {
							setCommandResponse("VITAL", `${t("自动续读")} ${p.page}`);
						}
					},
					onPage: (r, page) => {
						if (page % 5 != 0 && r.startSec != 0) return;
						let validCount = 0;
						for (let i = 0; i < r.vitalData.length; i++) {
							if (r.vitalData[i].valid == true) validCount++;
						}
						setCommandResponse(
							"VITAL",
							`${page} ${t("段")} ${validCount}/${r.vitalData.length} ${t("有效")}`
						);
					}
				});
				vitalAutoReading.value = false;
				vitalAutoDetail.value = deviceStore.history.formatVitalAutoDetail(result.responses);
				setCommandResponse(
					"VITAL",
					result.done
						? `${t("读取完成")} ${result.pages} ${t("段")} ${t("保存")} ${result.savedRecords}`
						: result.stoppedByLimit
							? `${t("达到上限")} ${result.pages} ${t("段")}`
							: `${t("读取停止")} ${result.pages} ${t("段")}`
				);
				return true;
			});
			shouldClose = false;
			break;
		}
		case "0x3C": {
			let startSec = parseInt(formStartSec.value, 10);
			let endSec = parseInt(formEndSec.value, 10);
			if (formType.value == EVENT_QUERY_TYPE_BY_TIME && formEventRange.value.length >= 2) {
				const pickedStart = parseEventPickerSec(formEventRange.value[0]);
				const pickedEnd = parseEventPickerSec(formEventRange.value[1]);
				if (pickedStart > 0 && pickedEnd > 0) {
					startSec = pickedStart;
					endSec = pickedEnd;
					formStartSec.value = startSec.toString();
					formEndSec.value = endSec.toString();
				}
			}
			if (formType.value == EVENT_QUERY_TYPE_BY_TIME) {
				if (
					Number.isNaN(startSec) ||
					startSec <= 0 ||
					Number.isNaN(endSec) ||
					endSec <= 0
				) {
					ui.showToast({ message: t("起止时戳必须是正数"), type: "error" });
					return;
				}
				if (endSec <= startSec) {
					ui.showToast({ message: t("结束时戳必须大于起始时戳"), type: "error" });
					return;
				}
			} else {
				startSec = 0;
				endSec = 0;
			}
			const maxCount = parseInt(formMaxCount.value, 10);
			const finalMaxCount = Number.isNaN(maxCount) || maxCount <= 0 ? 10 : maxCount;
			eventAutoReading.value = true;
			eventAutoDetail.value = "-";
			closeForm();
			await runQueuedGattCommand("EVENT", async (): Promise<boolean> => {
				eventAutoReading.value = true;
				eventAutoDetail.value = "-";
				setCommandResponse(
					"EVENT",
					formType.value == EVENT_QUERY_TYPE_ALL
						? t("0x3C 已开始，读取全部事件")
						: `${t("0x3C 已开始")} ${formatEventWindowTime(startSec)} ~ ${formatEventWindowTime(endSec)}`
				);
				const result = await deviceStore.history.readEventDataAuto({
					type: formType.value,
					startSec,
					endSec,
					maxCount: finalMaxCount,
					// 手动协议测试持续读取，只有用户停止或设备结束才退出。
					maxPages: 0,
					pageDelayMs: 250,
					shouldStop: () => eventAutoReading.value == false,
					onHeader: (h) => {
						setCommandResponse(
							"EVENT",
							`0x3C type=${h.type} sn[${h.earliestSn}~${h.latestSn}]`
						);
					},
					onProgress: (p) => {
						if (p.phase == "0x3D" && p.page % 5 == 0) {
							setCommandResponse("EVENT", `${t("自动续读")} ${p.page}`);
						}
					},
					onBatch: (items, page) => {
						if (page % 5 != 0 && items.length > 0) return;
						setCommandResponse(
							"EVENT",
							`${page} ${t("批")} ${t("新增")} ${items.length} ${t("条")}`
						);
					}
				});
				eventAutoReading.value = false;
				eventAutoDetail.value = deviceStore.history.formatEventAutoDetail(result.items);
				let sleepSaveText = "";
				if (result.savedSleepRecords > 0) {
					sleepSaveText = `, ${t("睡眠保存")} ${result.savedSleepRecords}`;
					if (result.uploadAttempted == true) {
						sleepSaveText +=
							result.uploadOk == true ? ` ${t("上传成功")}` : ` ${t("上传失败")}`;
					}
				}
				setCommandResponse(
					"EVENT",
					result.done
						? `${t("读取完成")} ${result.items.length} ${t("条")}${sleepSaveText}`
						: result.stoppedByLimit
							? `${t("达到上限")} ${result.items.length} ${t("条")}${sleepSaveText}`
							: `${t("读取停止")} ${result.items.length} ${t("条")}${sleepSaveText}`
				);
				return true;
			});
			shouldClose = false;
			break;
		}
	}
	if (shouldClose) closeForm();
}

function stopVitalAutoRead(): void {
	vitalAutoReading.value = false;
	quickHistoryStatus.value = t("正在停止当前读取，等待当前页结束");
	setCommandResponse("VITAL", t("已请求停止当前生命体征读取"));
}

function stopEventAutoRead(): void {
	eventAutoReading.value = false;
	setCommandResponse("EVENT", t("已停止自动续读"));
}

async function submitVitalFromPopup(payload: VitalPopupPayload): Promise<void> {
	formStartSec.value = payload.startSec;
	formDirection.value = payload.direction;
	formMinutes.value = payload.minutes;
	activeForm.value = "0x3A";
	await submitForm();
}

async function submitEventFromPopup(payload: EventPopupPayload): Promise<void> {
	formType.value = payload.type;
	formStartSec.value = payload.startSec;
	formEndSec.value = payload.endSec;
	formMaxCount.value = payload.maxCount;
	activeForm.value = "0x3C";
	await submitForm();
}

async function submitDeviceForm(payload: DevicePopupPayload): Promise<void> {
	activeForm.value = payload.type;
	formDeviceNumber.value = payload.deviceNumber ?? "";
	formGender.value = payload.gender ?? 0;
	formWeight.value = payload.weight ?? "7000";
	formHeight.value = payload.height ?? "18000";
	formAge.value = payload.age ?? "20";
	formBhr.value = payload.bhr ?? "60";
	await submitForm();
}

/* ===== 7 个无参/硬编码协议命令 ===== */

async function testReadFirmware(): Promise<void> {
	const cmd = "0x30";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		ui.showToast({ message: t("0x30 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readFirmwareVersion();
		const f = deviceStore.event.firmwareVersion.value;
		if (ok && f != null) {
			setCommandResponse(cmd, `${f.major}.${f.minor}.${f.revision}`);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
		return ok;
	});
}

async function testReadDeviceNumber(): Promise<void> {
	const cmd = "0x32";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		ui.showToast({ message: t("0x32 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readDeviceNumber();
		const num = deviceStore.event.deviceNumber.value;
		if (ok && num != "") {
			setCommandResponse(cmd, num);
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
		return ok;
	});
}

async function testReadTimestamp(): Promise<void> {
	const cmd = "0x34";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		ui.showToast({ message: t("0x34 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readTimestamp();
		const sec = deviceStore.event.boomTimestamp.value;
		if (ok && sec > 0) {
			setCommandResponse(cmd, new Date(sec * 1000).toLocaleString());
		} else {
			setCommandResponse(cmd, ok ? t("已发送，等待设备响应") : t("发送失败，请重试"));
		}
		ui.showToast({ message: ok ? t("已发送") : t("发送失败"), type: ok ? "success" : "error" });
		return ok;
	});
}

async function testReadBiometric(): Promise<void> {
	const cmd = "0x36";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		const beforeSeq = deviceStore.event.biometricInfoSeq.value;
		const sentAt = Date.now();
		ui.showToast({ message: t("0x36 发送..."), type: "warn" });
		const ok = await deviceStore.protocol.readBiometric();
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return false;
		}
		setCommandResponse(cmd, t("已发送，等待设备响应"));
		const b = await waitForBiometric(beforeSeq, sentAt, null, 2500);
		if (b != null) {
			setCommandResponse(cmd, formatBiometric(b));
			ui.showToast({ message: t("设备已响应"), type: "success" });
		} else {
			setCommandResponse(cmd, t("已发送，但未收到设备响应"));
			ui.showToast({ message: t("未收到设备响应"), type: "warn" });
		}
		return true;
	});
}

async function testSetTimestamp(): Promise<void> {
	const cmd = "0x33";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		const ok = await deviceStore.protocol.setTimestamp(Math.floor(Date.now() / 1000));
		setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("0x33 已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		return ok;
	});
}

/** 快速发送文档示例（不填表单，直接发 raw 帧） */
async function sendExample(ex: DocExample): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	const commandKey = cmd == "0x3A" ? "VITAL" : cmd == "0x3C" ? "EVENT" : cmd;
	await runQueuedGattCommand(commandKey, async (): Promise<boolean> => {
		ui.showToast({ message: `${t("发送示例")} ${ex.name}`, type: "warn" });
		const ok = await deviceStore.protocol.sendRawFrame(ex.request);
		setCommandResponse(commandKey, ok ? t("示例已发送，等待设备响应") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		if (ok) closeForm();
		return ok;
	});
}

async function testVibration(): Promise<void> {
	const cmd = "0x40";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		const before = deviceStore.event.lastVibration.value;
		// 对齐状态说明 1.4.4.12 示例: loops=1, count=2, 500ms震,1000ms静,800ms震
		const spec: VibrationSpec = {
			loops: 1,
			count: 2,
			onOffMs: [500, 1000, 800]
		};
		setCommandResponse(cmd, t("发送中: 500ms/1000ms/800ms"));
		const ok = await deviceStore.protocol.controlVibration(spec);
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return false;
		}
		setCommandResponse(cmd, t("已发送，等待 0x40 响应"));
		const v = await waitForVibration(before, 2500);
		if (v != null) {
			setCommandResponse(cmd, v.code == 0 ? t("code=0 (成功)") : `code=${v.code}`);
			ui.showToast({
				message: v.code == 0 ? t("震动命令成功") : t("震动命令失败"),
				type: v.code == 0 ? "success" : "error"
			});
		} else {
			setCommandResponse(cmd, t("已发送，但未收到 0x40 响应"));
			ui.showToast({ message: t("未收到震动响应"), type: "warn" });
		}
		return true;
	});
}

/* ===== v5 历史数据展示用 computed ===== */

function formatStatusByte(status: number): string {
	const s = decodeAdvStatus(status);
	const reserved = (status >> 6) & 0x03;
	return `0x${toByteHex(status)} high=${reserved} behavior=${s.behaviorLabel} activity=${s.activityLabel}`;
}

const vitalText = computed<VitalPopupText>(() => {
	const r = deviceStore.history.vitalDataResponse.value;
	if (r == null) {
		return {
			summary: "-",
			start: "-",
			directionMinutes: "-",
			valid: "-",
			ppi: "-",
			status: "-",
			rmssdSdnn: "-",
			vital: "-"
		};
	}
	const startTime =
		r.startSec > 0 ? new Date(r.startSec * 1000).toLocaleString() : t("无后续数据");
	const directionText =
		r.direction == 0
			? t("向前")
			: r.direction == 1
				? t("向后")
				: `${t("未知")}(${r.direction})`;
	const start = `${r.startSec} (${startTime})`;
	const directionMinutes = `${directionText} / ${r.n}min`;
	let validCount = 0;
	let ppiCount = 0;
	for (let i = 0; i < r.vitalData.length; i++) {
		if (r.vitalData[i].valid == true) validCount++;
		if (r.vitalData[i].ppi > 0) ppiCount++;
	}
	const expectedCount = r.n * 60;
	const valid = `${validCount}/${r.vitalData.length}`;
	const ppi = `${ppiCount}/${r.vitalData.length}`;
	const summary = `${validCount}/${expectedCount} ${t("有效")} · ${ppiCount} PPI`;
	let status = `${validCount}/${r.vitalData.length} ${t("心率有效")}，${ppiCount}/${r.vitalData.length} PPI，expected=${expectedCount}`;
	if (r.startSec == 0) {
		status = t("设备返回时间戳 0，后面没有数据，不需要续读");
	} else if (r.vitalData.length == 0) {
		status = t("本段无逐秒数据，可点击 0x3B 继续读下一段");
	} else if (r.vitalData.length < expectedCount) {
		status = `${status}；${t("设备返回短页（协议允许），自动读取仍会继续发送 0x3B；不代表数据错误或停止")}`;
	} else if (validCount == 0) {
		status = `${status}；${t("本段全为无效或空白数据")}`;
	}
	const rmssdSdnn = r.rmssdSdnn
		.slice(0, 10)
		.map((p, i) =>
			p.valid == true
				? `m${i + 1}:${p.rmssd.toFixed(1)}/${p.sdnn.toFixed(1)}`
				: `m${i + 1}:FF`
		)
		.join(",");
	const vital = r.vitalData
		.slice(0, 30)
		.map((d, i) => {
			if (d.valid == false) return `${i}s:FF`;
			const ppi = d.ppi > 0 ? `${d.ppi}ms` : "PPI-";
			return `${i}s hr=${d.hr} ppi=${ppi} pitch=${d.pitch} acc=${d.acc} ${formatStatusByte(d.status)}`;
		})
		.join(" ");
	return { summary, start, directionMinutes, valid, ppi, status, rmssdSdnn, vital };
});

const hasVitalData = computed<boolean>(() => {
	return deviceStore.history.vitalDataResponse.value != null;
});

const eventHeaderText = computed<string>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	if (h == null) return "-";
	return `type=${h.type} sn[${h.earliestSn}~${h.latestSn}] ts[${h.earliestSec}~${h.latestSec}] ${new Date(h.earliestSec * 1000).toLocaleString()} ~ ${new Date(h.latestSec * 1000).toLocaleString()}`;
});

const eventCountText = computed<string>(() => {
	return deviceStore.history.eventDataList.value.length.toString();
});

const eventItemsText = computed<string>(() => {
	return deviceStore.history.formatEventAutoBrief(deviceStore.history.eventDataList.value, 10);
});

const hasEventData = computed<boolean>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	const list = deviceStore.history.eventDataList.value;
	return h != null || list.length > 0;
});

/* ===== 设备控制 ===== */

function testDisconnect(): void {
	deviceStore.connection.disconnectDevice();
}

async function testRestoreBroadcast(): Promise<void> {
	ui.showToast({ message: t("正在恢复广播扫描..."), type: "warn" });
	const ok = await deviceStore.connection.switchToBroadcastMode();
	ui.showToast({
		message: ok ? t("已切回广播扫描") : t("恢复广播失败"),
		type: ok ? "success" : "error"
	});
}

function testClearError(): void {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}

/** UTS 按声明顺序解析：入口分发必须位于所有目标函数之后。 */
function runDeviceCommand(command: string): void {
	if (command == "disconnect") return testDisconnect();
	if (command == "restore") {
		testRestoreBroadcast();
		return;
	}
	if (command == "clear-error") return testClearError();
	if (command == "0x30") {
		testReadFirmware();
		return;
	}
	if (command == "0x32") {
		testReadDeviceNumber();
		return;
	}
	if (command == "0x34") {
		testReadTimestamp();
		return;
	}
	if (command == "0x36") {
		testReadBiometric();
		return;
	}
	if (command == "0x40") testVibration();
}
//#endif
</script>

