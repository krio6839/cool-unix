		const ok = await deviceStore.protocol.setTimestamp(Math.floor(Date.now() / 1000));
		setCommandResponse(cmd, ok ? t("已发送，等待设备确认") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("0x33 已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		return ok;
	});
}

/** 快速发送文档示例（不填表单，直接发 raw 帧） */
async function sendExample(ex: DocExample): Promise<void> {
	const cmd = activeForm.value;
	if (cmd == "") return;
	const commandKey = cmd == "0x3A" ? "VITAL" : cmd == "0x3C" ? "EVENT" : cmd;
	await runQueuedGattCommand(commandKey, async (): Promise<boolean> => {
		ui.showToast({ message: `${t("发送示例")} ${ex.name}`, type: "warn" });
		const ok = await deviceStore.protocol.sendRawFrame(ex.request);
		setCommandResponse(commandKey, ok ? t("示例已发送，等待设备响应") : t("发送失败，请重试"));
		ui.showToast({
			message: ok ? t("已发送") : t("发送失败"),
			type: ok ? "success" : "error"
		});
		if (ok) closeForm();
		return ok;
	});
}

async function testVibration(): Promise<void> {
	const cmd = "0x40";
	await runQueuedGattCommand(cmd, async (): Promise<boolean> => {
		const before = deviceStore.event.lastVibration.value;
		// 对齐状态说明 1.4.4.12 示例: loops=1, count=2, 500ms震,1000ms静,800ms震
		const spec: VibrationSpec = {
			loops: 1,
			count: 2,
			onOffMs: [500, 1000, 800]
		};
		setCommandResponse(cmd, t("发送中: 500ms/1000ms/800ms"));
		const ok = await deviceStore.protocol.controlVibration(spec);
		if (!ok) {
			setCommandResponse(cmd, t("发送失败，请重试"));
			ui.showToast({ message: t("发送失败"), type: "error" });
			return false;
		}
		setCommandResponse(cmd, t("已发送，等待 0x40 响应"));
		const v = await waitForVibration(before, 2500);
		if (v != null) {
			setCommandResponse(cmd, v.code == 0 ? t("code=0 (成功)") : `code=${v.code}`);
			ui.showToast({
				message: v.code == 0 ? t("震动命令成功") : t("震动命令失败"),
				type: v.code == 0 ? "success" : "error"
			});
		} else {
			setCommandResponse(cmd, t("已发送，但未收到 0x40 响应"));
			ui.showToast({ message: t("未收到震动响应"), type: "warn" });
		}
		return true;
	});
}

/* ===== v5 历史数据展示用 computed ===== */

type VitalText = {
	summary: string;
	start: string;
	directionMinutes: string;
	valid: string;
	ppi: string;
	status: string;
	rmssdSdnn: string;
	vital: string;
};
type EventText = {
	summary: string;
	header: string;
	count: string;
	items: string;
};

function formatStatusByte(status: number): string {
	const s = decodeAdvStatus(status);
	const reserved = (status >> 6) & 0x03;
	return `0x${toByteHex(status)} high=${reserved} behavior=${s.behaviorLabel} activity=${s.activityLabel}`;
}

const vitalText = computed<VitalText>(() => {
	const r = deviceStore.history.vitalDataResponse.value;
	if (r == null) {
		return {
			summary: "-",
			start: "-",
			directionMinutes: "-",
			valid: "-",
			ppi: "-",
			status: "-",
			rmssdSdnn: "-",
			vital: "-"
		};
	}
	const startTime =
		r.startSec > 0 ? new Date(r.startSec * 1000).toLocaleString() : t("无后续数据");
	const directionText =
		r.direction == 0
			? t("向前")
			: r.direction == 1
				? t("向后")
				: `${t("未知")}(${r.direction})`;
	const start = `${r.startSec} (${startTime})`;
	const directionMinutes = `${directionText} / ${r.n}min`;
	let validCount = 0;
	let ppiCount = 0;
	for (let i = 0; i < r.vitalData.length; i++) {
		if (r.vitalData[i].valid == true) validCount++;
		if (r.vitalData[i].ppi > 0) ppiCount++;
	}
	const expectedCount = r.n * 60;
	const valid = `${validCount}/${r.vitalData.length}`;
	const ppi = `${ppiCount}/${r.vitalData.length}`;
	const summary = `${validCount}/${expectedCount} ${t("有效")} · ${ppiCount} PPI`;
	let status = `${validCount}/${r.vitalData.length} ${t("心率有效")}，${ppiCount}/${r.vitalData.length} PPI，expected=${expectedCount}`;
	if (r.startSec == 0) {
		status = t("设备返回时间戳 0，后面没有数据，不需要续读");
	} else if (r.vitalData.length == 0) {
		status = t("本段无逐秒数据，可点击 0x3B 继续读下一段");
	} else if (r.vitalData.length < expectedCount) {
		status = `${status}；${t("本段数据长度不足，后半段无有效数据，可按需续读")}`;
	} else if (validCount == 0) {
		status = `${status}；${t("本段全为无效或空白数据")}`;
	}
	const rmssdSdnn = r.rmssdSdnn
		.slice(0, 10)
		.map((p, i) =>
			p.valid == true
				? `m${i + 1}:${p.rmssd.toFixed(1)}/${p.sdnn.toFixed(1)}`
				: `m${i + 1}:FF`
		)
		.join(",");
	const vital = r.vitalData
		.slice(0, 30)
		.map((d, i) => {
			if (d.valid == false) return `${i}s:FF`;
			const ppi = d.ppi > 0 ? `${d.ppi}ms` : "PPI-";
			return `${i}s hr=${d.hr} ppi=${ppi} pitch=${d.pitch} acc=${d.acc} ${formatStatusByte(d.status)}`;
		})
		.join(" ");
	return { summary, start, directionMinutes, valid, ppi, status, rmssdSdnn, vital };
});

const hasVitalData = computed<boolean>(() => {
	return deviceStore.history.vitalDataResponse.value != null;
});

const eventText = computed<EventText>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	const list = deviceStore.history.eventDataList.value;
	if (h == null && list.length == 0) {
		return { summary: "-", header: "-", count: "-", items: "-" };
	}
	const header =
		h == null
			? "-"
			: `type=${h.type} sn[${h.earliestSn}~${h.latestSn}] ts[${h.earliestSec}~${h.latestSec}] ${new Date(h.earliestSec * 1000).toLocaleString()} ~ ${new Date(h.latestSec * 1000).toLocaleString()}`;
	const count = list.length.toString();
	const summary = `${list.length} ${t("条事件")}`;
	const items = deviceStore.history.formatEventAutoBrief(list, 10);
	return { summary, header, count, items };
});

const hasEventData = computed<boolean>(() => {
	const h = deviceStore.history.eventDataHeader.value;
	const list = deviceStore.history.eventDataList.value;
	return h != null || list.length > 0;
});

/* ===== 设备控制 ===== */

function testDisconnect(): void {
	deviceStore.connection.disconnectDevice();
}

async function testRestoreBroadcast(): Promise<void> {
	ui.showToast({ message: t("正在恢复广播扫描..."), type: "warn" });
	const ok = await deviceStore.connection.switchToBroadcastMode(false);
	ui.showToast({
		message: ok ? t("已切回广播扫描") : t("恢复广播失败"),
		type: ok ? "success" : "error"
	});
}

function testClearError(): void {
	deviceStore.clearError();
	ui.showToast({ message: t("错误已清除"), type: "success" });
}
//#endif
