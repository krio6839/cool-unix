}

.test-popup-body {
	height: 100%;
	padding: 14px;
	background-color: #1f2320;
}

.panel {
	margin-bottom: 12px;
	padding: 12px;
	border-radius: 8px;
	background-color: #292f2c;
	border: 1px solid rgba(255, 255, 255, 0.08);
}

.panel-header,
.section-header {
	display: flex;
