<template>
	<cl-page class="device-detail">
		<cl-topbar safe-area-top background-color="transparent" :title="t('设备详情')"></cl-topbar>

		<view class="p-3">
			<!-- A. 基本信息 -->
			<cl-list :pt="{ className: 'mb-3' }">
				<cl-list-item :label="t('设备名称')">
					<cl-text>{{ deviceNameText }}</cl-text>
				</cl-list-item>
				<cl-list-item :label="t('设备ID')">
					<cl-text :pt="{ className: 'text-xs' }">{{ deviceIdText }}</cl-text>
				</cl-list-item>
				<cl-list-item :label="t('连接状态')">
					<cl-text>{{ statusText }}</cl-text>
				</cl-list-item>
				<cl-list-item :label="t('蓝牙状态')">
					<cl-text>{{ btStatusText }}</cl-text>
				</cl-list-item>
				<cl-list-item :label="t('信号强度')">
					<cl-text>{{ rssiText }}</cl-text>
				</cl-list-item>
			</cl-list>

			<!-- C. 佩戴位置:cl-select 弹窗触发 -->
			<!-- #ifndef H5 -->
			<cl-list :pt="{ className: 'mb-3' }">
				<cl-list-item :label="t('佩戴位置')" arrow hoverable @tap="openWearLocationPicker">
					<cl-text>{{ currentWearLocationLabel }}</cl-text>
				</cl-list-item>
			</cl-list>
			<!-- #endif -->

			<!-- D. 操作列表 -->
			<!-- #ifndef H5 -->
			<!-- D1. 常规操作:打开测试弹窗 -->
			<cl-list :pt="{ className: 'mb-3' }">
				<cl-list-item
					:label="t('打开测试弹窗')"
					icon="settings-line"
					arrow
					hoverable
					@tap="openTest"
				></cl-list-item>
			</cl-list>

			<!-- D2. 危险操作:删除设备 -->
			<cl-list :pt="{ className: 'mb-3' }" v-if="deviceStore.boundDeviceId != ''">
				<cl-list-item hoverable justify="center" @tap="onDelete">
					<cl-text color="error">{{ t("删除设备") }}</cl-text>
				</cl-list-item>
			</cl-list>
			<!-- #endif -->

			<!-- H5 平台提示 -->
			<!-- #ifdef H5 -->
			<view class="flex-1 flex flex-col items-center justify-center px-8 py-12">
				<cl-text color="gray-500" :size="16" :pt="{ className: 'text-center' }">
					{{ t("H5平台不支持蓝牙相关功能") }}
				</cl-text>
			</view>
			<!-- #endif -->
		</view>

		<!-- 佩戴位置 picker 弹窗 -->
		<!-- #ifndef H5 -->
		<cl-select
			ref="wearLocationSelectRef"
			v-model="wearLocation"
			:title="t('佩戴位置')"
			:options="wearLocationOptions"
			:show-trigger="false"
		></cl-select>
		<!-- #endif -->

		<!-- 测试弹窗 -->
		<!-- #ifndef H5 -->
		<TestPopup v-model="showTest"></TestPopup>
		<!-- #endif -->
	</cl-page>
</template>

<script lang="ts" setup>
import { ref, computed } from "vue";
import { router, t, useStore } from "@/.cool";
import { useUi, type ClSelectOption } from "@/uni_modules/cool-ui";
import { getWearLocationLabel, getWearLocationOptions } from "@/.cool/store/device";
import type { WearLocation, WearLocationOption } from "@/.cool/store/device";
// #ifndef H5
import type { BLEDeviceCharacteristic } from "@/.cool/bluetooth";
import TestPopup from "./components/TestPopup.uvue";
// #endif

const { device: deviceStore } = useStore();
const ui = useUi();

const showTest = ref(false);
const wearLocation = ref<WearLocation>(deviceStore.currentWearLocation);
const wearLocationSelectRef = ref<ClSelectComponentPublicInstance | null>(null);

// 佩戴位置选项
const wearLocationOptions: ClSelectOption[] = getWearLocationOptions().map(
	(item: WearLocationOption): ClSelectOption => ({
		label: t(item.label),
		value: item.value
	})
);

const currentWearLocationLabel = computed((): string => {
	deviceStore.stateVersion.value;
	return t(getWearLocationLabel(deviceStore.currentWearLocation));
});

const deviceNameText = computed((): string => {
	deviceStore.stateVersion.value;
	if (deviceStore.currentDeviceName != "") return deviceStore.currentDeviceName;
	if (deviceStore.currentDeviceId != "") return "BOOM";
	return "—";
});

const deviceIdText = computed((): string => {
	deviceStore.stateVersion.value;
	if (deviceStore.currentDeviceId != "") return deviceStore.currentDeviceId;
	if (deviceStore.boundDeviceId != "") return deviceStore.boundDeviceId;
	return "—";
});

// 基本信息 - 连接状态文案
const statusText = computed((): string => {
	const s = deviceStore.status.value;
	if (s == "CONNECTED") return t("已连接");
	if (s == "PAIRING" || s == "SEARCHING") return t("搜索中");
	return t("未配对");
});

// 基本信息 - 蓝牙适配器状态
const btStatusText = computed((): string => {
	deviceStore.stateVersion.value;
	return deviceStore.available ? t("已开启") : t("未开启");
});

// 基本信息 - 信号强度(查 devices 数组中绑定设备 RSSI;可能为空)
const rssiText = computed((): string => {
	// #ifndef H5
	deviceStore.stateVersion.value;
	const boundId = deviceStore.boundDeviceId;
	if (boundId == "") return "—";
	const found = deviceStore.devices.find((d) => d.deviceId == boundId);
	if (found == null) return "—";
	const rssi = found.RSSI;
	if (rssi == null) return "—";
	return rssi + " dBm";
	// #endif
	// #ifdef H5
	return "—";
	// #endif
});

function openTest() {
	showTest.value = true;
}

function openWearLocationPicker() {
	// 同步 store 中的最新值(避免 store 改了但本地 ref 还是旧的)
	wearLocation.value = deviceStore.currentWearLocation;
	// #ifndef H5
	wearLocationSelectRef.value?.open((value) => {
		const loc = value as WearLocation;
		deviceStore.saveWearLocation(loc);
		ui.showToast({ message: t("已切换至") + t(getWearLocationLabel(loc)), type: "success" });
	});
	// #endif
}

/**
 * 删除设备:confirm 二次确认 → 调 deviceStore.deleteDevice()
 * - 不跳转,清完数据后由详情页 onShow 保持可见
 */
function onDelete() {
	ui.showConfirm({
		title: t("删除设备"),
		message: t("此操作将清空本地存储的所有数据(心率/睡眠/PPI等),且不可恢复。确定继续吗?"),
		callback(action) {
			if (action == "confirm") {
				deviceStore.deleteDevice();
				router.back();
			}
		}
	});
}
</script>

<style lang="scss" scoped>
.device-detail {
	background-color: #000;
}
</style>
