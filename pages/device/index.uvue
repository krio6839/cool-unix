<template>
	<cl-page class="device-page">
		<cl-topbar
			safe-area-top
			background-color="transparent"
			left-icon="arrow-left"
			:backable="isPreparingPairing == false"
			:title="titleText"
		>
			<template #append>
				<cl-button text @tap="goDetail" v-if="deviceStore.boundDeviceId">
					{{ t("详情") }}
				</cl-button>
				<cl-button v-else text @tap="goDetail">
					{{ t("测试") }}
				</cl-button>
			</template>
		</cl-topbar>

		<!-- H5平台提示 -->
		<!-- #ifdef H5 -->
		<view class="flex-1 flex flex-col items-center justify-center px-8">
			<view class="mb-12">
				<cl-text color="white" :size="20" :pt="{ className: 'font-bold mb-6' }">
					{{ t("H5平台不支持蓝牙功能") }}
				</cl-text>
				<cl-text color="gray-400" :size="16">{{ t("请在APP端使用设备配对功能") }}</cl-text>
			</view>
			<cl-button @click="onSelect"> ceshi </cl-button>
		</view>
		<!-- #endif -->

		<!-- 已连接状态 -->
		<!-- #ifndef H5 -->
		<view v-show="isConnected" class="flex-1">
			<ConnectedState
				:connectedDeviceName="connectedDeviceName"
				@click="handleConfirmClick"
			></ConnectedState>
		</view>

		<!-- 配对状态和搜索状态 -->
		<view v-show="isPairingOrSearching" class="flex-1">
			<PairingState :searching="isSearching" @select="onSelect"></PairingState>
		</view>

		<!-- 错误提示 -->
		<view v-show="hasDeviceError" class="flex-1 flex flex-col items-center justify-center px-8">
			<cl-text color="red" :size="16" class="mb-4">
				{{ deviceStore.errorMessage.value }}
			</cl-text>
			<cl-button type="primary" color="#000" rounded @tap="retry">
				{{ t("重试") }}
			</cl-button>
		</view>

		<!-- 未配对状态 -->
		<view v-show="showUnpairedState" class="flex-1">
			<UnpairedState :loading="isPreparingPairing" @click="enterPairingMode"></UnpairedState>
		</view>

		<!-- 测试弹窗组件 已迁移到详情页,设备页不再使用 -->

		<!-- 共享 actionSheet(由 store 注入 ref 供 PairingState/测试页等使用) -->
		<cl-action-sheet ref="actionSheetRef"></cl-action-sheet>

		<!-- #endif -->
	</cl-page>
</template>

<script setup lang="ts">
import { ref, computed, watch } from "vue";
import { router, t, useStore } from "@/.cool";
import { normalizeWearLocation } from "@/.cool/store/device";
import { useUi } from "@/uni_modules/cool-ui";

import UnpairedState from "./components/UnpairedState.uvue";
import PairingState from "./components/PairingState.uvue";
import ConnectedState from "./components/ConnectedState.uvue";

const { device: deviceStore } = useStore();
const ui = useUi();

// 共享 cl-action-sheet 实例:通过 watch 同步到 store 供 PairingState/测试页等使用
const actionSheetRef = ref<ClActionSheetComponentPublicInstance | null>(null);
watch(
	actionSheetRef,
	(val: ClActionSheetComponentPublicInstance | null) => {
		deviceStore.actionSheetRef = val;
	},
	{ immediate: true }
);

const connectedDeviceName = ref<string>("Cool Unix 设备");
const isPreparingPairing = ref<boolean>(false);

onBackPress(() => {
	return isPreparingPairing.value == true;
});

const isConnected = computed<boolean>(() => {
	return deviceStore.status.value == "CONNECTED";
});

const isSearching = computed<boolean>(() => {
	return deviceStore.status.value == "SEARCHING";
});

const isPairingOrSearching = computed<boolean>(() => {
	return deviceStore.status.value == "PAIRING" || deviceStore.status.value == "SEARCHING";
});

const hasDeviceError = computed<boolean>(() => {
	return deviceStore.errorMessage.value != "";
});

const showUnpairedState = computed<boolean>(() => {
	return (
		isConnected.value == false &&
		isPairingOrSearching.value == false &&
		hasDeviceError.value == false
	);
});

const titleText = computed(() => {
	if (isConnected.value == true) {
		return t("设备详情");
	} else if (isPairingOrSearching.value == true) {
		return t("产品配对");
	} else {
		return t("未配对");
	}
});

function onSelect(location: string) {
	deviceStore.saveWearLocation(normalizeWearLocation(location));
}

async function enterPairingMode() {
	if (isPreparingPairing.value == true) return;
	isPreparingPairing.value = true;
	try {
		// UTS:显式比较 boolean,避免隐式布尔
		if (deviceStore.available == false) {
			await deviceStore.connection.initBluetooth();
		}
		if (deviceStore.boundDeviceId == "") {
			await deviceStore.connection.startPairingScan();
		} else {
			await deviceStore.connection.switchToBroadcastMode();
		}
	} catch (e) {
		console.warn("[DEVICE] 初始化蓝牙失败:", e);
		const message = t("蓝牙初始化失败,请检查蓝牙和位置权限");
		deviceStore.setUnpairedError(message);
		ui.showToast({ message, type: "error" });
	} finally {
		isPreparingPairing.value = false;
	}
}

function handleConfirmClick() {
	router.push({
		path: "/pages/index/home",
		mode: "reLaunch"
	});
}

/**
 * 跳转到设备详情页(顶栏"详情"按钮)
 */
function goDetail() {
	router.to("/pages/device/detail");
}

function retry() {
	deviceStore.connection.initBluetoothSafely();
}
</script>

<style lang="scss" scoped>
.device-page {
	background-color: #000;
	position: relative;
}
</style>
