<template>
	<cl-page class="device-page">
		<cl-topbar
			safe-area-top
			background-color="transparent"
			left-icon="arrow-left"
			:title="titleText"
			@tap="goBack"
		>
			<template #append>
				<cl-button text @tap="openTestPopup">
					{{ t("测试") }}
				</cl-button>
			</template>
		</cl-topbar>

		<!-- H5平台提示 -->
		<!-- #ifdef H5 -->
		<view class="flex-1 flex flex-col items-center justify-center px-8">
			<view class="mb-12">
				<cl-text color="white" :size="20" :pt="{ className: 'font-bold mb-6' }">
					{{ t("H5平台不支持蓝牙功能") }}
				</cl-text>
				<cl-text color="gray-400" :size="16">{{ t("请在APP端使用设备配对功能") }}</cl-text>
			</view>
			<cl-button @click="onSelect"> ceshi </cl-button>
		</view>
		<!-- #endif -->

		<!-- 已连接状态 -->
		<!-- #ifndef H5 -->
		<view v-if="deviceStore.status.value === 'CONNECTED'" class="flex-1">
			<ConnectedState
				:connectedDeviceName="connectedDeviceName"
				@click="handleConfirmClick"
			></ConnectedState>
		</view>

		<!-- 配对状态和搜索状态 -->
		<view
			v-else-if="
				deviceStore.status.value === 'PAIRING' || deviceStore.status.value === 'SEARCHING'
			"
			class="flex-1"
		>
			<PairingState
				:searching="deviceStore.status.value === 'SEARCHING'"
				@select="onSelect"
			></PairingState>
		</view>

		<!-- 重连状态 -->
		<view
			v-else-if="deviceStore.isReconnecting"
			class="flex-1 flex flex-col items-center justify-center"
		>
			<cl-loading type="spinner" :size="48"></cl-loading>
			<cl-text color="white" :size="16" class="mt-4">
				{{ t("正在尝试重连...") }}
			</cl-text>
			<cl-text color="gray-400" :size="14" class="mt-2">
				{{ t("第") }} {{ deviceStore.reconnectAttempts }} {{ t("次尝试") }}
			</cl-text>
		</view>

		<!-- 错误提示 -->
		<view
			v-else-if="deviceStore.errorMessage.value !== ''"
			class="flex-1 flex flex-col items-center justify-center px-8"
		>
			<cl-text color="red" :size="16" class="mb-4">
				{{ deviceStore.errorMessage.value }}
			</cl-text>
			<cl-button type="primary" color="#000" rounded @tap="retry">
				{{ t("重试") }}
			</cl-button>
		</view>

		<!-- 未配对状态 -->
		<view v-else class="flex-1">
			<UnpairedState @click="enterPairingMode"></UnpairedState>
		</view>

		<!-- 测试弹窗组件 -->
		<TestPopup v-model="showPopup"></TestPopup>

		<!-- 共享 actionSheet(由 store 注入 ref 供 PairingState/TestPopup 等使用) -->
		<cl-action-sheet ref="actionSheetRef"></cl-action-sheet>

		<!-- #endif -->
	</cl-page>
</template>

<script setup lang="ts">
import { ref, computed, watch } from "vue";
import { router, t, useStore } from "@/.cool";

import UnpairedState from "./components/UnpairedState.uvue";
import PairingState from "./components/PairingState.uvue";
import ConnectedState from "./components/ConnectedState.uvue";
import TestPopup from "./components/TestPopup.uvue";

const { device: deviceStore } = useStore();

const showPopup = ref(false);

// 共享 cl-action-sheet 实例:通过 watch 同步到 store 供 PairingState / TestPopup 等使用
const actionSheetRef = ref<ClActionSheetComponentPublicInstance | null>(null);
watch(
	actionSheetRef,
	(val: ClActionSheetComponentPublicInstance | null) => {
		deviceStore.actionSheetRef = val;
	},
	{ immediate: true }
);

const connectedDeviceName = ref<string>("Cool Unix 设备");

const titleText = computed(() => {
	if (deviceStore.status.value === "CONNECTED") {
		return t("设备详情");
	} else if (deviceStore.isReconnecting) {
		return t("重连中");
	} else if (deviceStore.status.value === "PAIRING" || deviceStore.status.value === "SEARCHING") {
		return t("产品配对");
	} else {
		return t("未配对");
	}
});

function openTestPopup() {
	showPopup.value = true;
}

function onSelect(location: string) {
	deviceStore.saveWearLocation(location as "大臂部" | "下胸部" | "腰部");
}

async function enterPairingMode() {
	if (!deviceStore.available) {
		await deviceStore.connection.initBluetooth();
	}
	deviceStore.status.value = "SEARCHING";
	const mode = deviceStore.boundDeviceId == "" ? "pairing" : "reconnect";
	deviceStore.connection.startBluetoothSearch(mode);
}

function handleConfirmClick() {
	router.push({
		path: "/pages/index/home",
		mode: "reLaunch"
	});
}

function goBack() {
	router.back();
}

function retry() {
	deviceStore.connection.initBluetooth();
}
</script>

<style lang="scss" scoped>
.device-page {
	background-color: #000;
	position: relative;
}
</style>
