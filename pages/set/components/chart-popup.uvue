<template>
	<cl-popup
		v-model="show"
		direction="center"
		:title="title"
		:show-header="true"
		:show-close="true"
		:show-mask="true"
		:mask-closable="true"
		:size="350"
		:pt="{
			className: 'chart-popup',
			inner: { className: '!bg-[#181814]' },
			header: { className: 'chart-popup-header' },
			container: { className: 'chart-popup-container' }
		}"
	>
		<view class="p-4">
			<!-- 图表区域 -->
			<view style="width: 100%; height: 300px" class="relative">
				<l-echart v-if="chartData.length > 0" ref="chart" @finished="initChart"></l-echart>
				<view v-else class="flex flex-col items-center justify-center h-full">
					<cl-icon name="file-warning-line" :size="40" color="#666"></cl-icon>
					<text class="text-gray-500 text-sm mt-2">当天暂无数据</text>
				</view>
			</view>

			<!-- 底部说明文字 -->
			<view class="mt-4">
				<text class="text-white text-sm">
					你的身体电量充足，训练准备度适中（优先使用睡眠期间）
				</text>
				<text class="text-white text-sm mt-2 block"> HRV... </text>
			</view>
		</view>
	</cl-popup>
</template>

<script setup lang="uts">
import { ref, computed, watch } from "vue";
import { request, useStore, formatDate, parse } from "@/.cool";
import type { TimeValuePair } from "@/.cool/types";

const { device } = useStore();

const props = defineProps({
	tab: {
		type: String,
		default: "energy"
	},
	date: {
		type: String,
		required: true
	}
});


// #ifdef MP
// 引入小程序依赖包
const echarts = require("../../../uni_modules/lime-echart/static/echarts.min.js");
// #endif
// #ifndef MP
// 非小程序不需要引入
const echarts = null;
// #endif

const show = defineModel<boolean>('show', {
	default: false
});
const chart = ref<LEchartComponentPublicInstance | null>(null);
const chartData = ref<TimeValuePair[]>([]);
const isLoading = ref<boolean>(false);

const title = computed(() => {
	return formatDate(props.date, "MM-DD");
});

async function initChart() {
	if (chart.value == null) return;

	const chartInstance = await chart.value.init(echarts);
	const times = chartData.value.map((item) => item.time);
	const values = chartData.value.map((item) => item.value);
	const maxValue = values.length > 0 ? Math.max(...values) : 0;

	chartInstance.setOption({
		backgroundColor: "transparent",
		tooltip: {
			trigger: "axis",
			formatter: "{b}<br/>{c}%"
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: times,
			axisLine: {
				lineStyle: {
					color: "#333"
				}
			},
			axisLabel: {
				color: "#666",
				fontSize: 12
			}
		},
		yAxis: {
			type: "value",
			min: 0,
			max: 100,
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				data: values,
				type: "line",
				smooth: true,
				itemStyle: {
					color: "#D2FF5C"
				},
				lineStyle: {
					width: 3
				},
				markPoint: {
					data: [
						{
							type: "max",
							name: "最高",
							itemStyle: {
								color: "#D2FF5C"
							},
							label: {
								color: "#fff",
								formatter: `${maxValue}%`
							}
						}
					]
				}
			}
		]
	});
}

// 获取图表数据
async function fetchChartData() {
	if (device.boundDeviceId != "") {
		isLoading.value = true;
		try {
			const data = await request({
				url: `/devices/${device.boundDeviceId}/calendar_tables`,
				method: "GET",
				data: {
					date: props.date,
					tab: props.tab
				} as UTSJSONObject
			});
			if (Array.isArray(data)) {
				chartData.value = data.map((item) => (parse<TimeValuePair>(item)!));
				console.log("解析后的数据:", chartData.value);
					initChart();
			}
		} catch (err) {
			console.error("获取图表数据失败:", err);
			chartData.value = [];
		} finally {
			isLoading.value = false;
		}
	}
}

watch(
	computed(() => show.value),
	(newValue: boolean) => {
		show.value = newValue;
		if (newValue) {
			fetchChartData();
		}
	}
);
</script>

<style lang="scss">
/* 图表区域样式 */
.chart-container {
	position: relative;
}

.chart-popup-header {
	.cl-icon {
		color: #000 !important;
	}
}

/* 自定义关闭按钮样式 */
.close-btn {
	position: absolute;
	top: 20rpx;
	right: 20rpx;
	z-index: 10;
}
</style>
