<template>
	<cl-page>
		<view class="diagnostics-page">
			<view class="diagnostics-header">
				<cl-text :size="18" :pt="{ className: 'font-bold mb-1' }">诊断日志</cl-text>
				<cl-text :size="12" :pt="{ className: 'opacity-60 leading-5' }">
					本机保留最近 {{ maxLogs }} 条，当前
					{{ logs.length }} 条。超过上限自动覆盖最旧日志。
				</cl-text>
			</view>

			<view class="summary-grid">
				<view class="summary-cell">
					<text class="summary-label">当前条数</text>
					<text class="summary-value">{{ logs.length }}</text>
				</view>
				<view class="summary-cell">
					<text class="summary-label">保留上限</text>
					<text class="summary-value">{{ maxLogs }}</text>
				</view>
				<view class="summary-cell">
					<text class="summary-label">复制范围</text>
					<text class="summary-value">{{ copyModeText }}</text>
				</view>
			</view>

			<view class="action-grid">
				<view class="action-item">
					<cl-button type="primary" size="small" @tap="copyAllLogs">复制全部</cl-button>
				</view>
				<view class="action-item">
					<cl-button type="primary" size="small" @tap="copyRecentLogs">
						复制最近200条
					</cl-button>
				</view>
				<view class="action-item">
					<cl-button size="small" @tap="refreshLogs">刷新</cl-button>
				</view>
				<view class="action-item">
					<cl-button size="small" @tap="clearLogs">清空</cl-button>
				</view>
			</view>

			<textarea class="log-textarea" :value="text" :maxlength="-1" disabled />
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { ref } from "vue";
import { diagnostics } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";

const ui = useUi();
const logs = ref<string[]>([]);
const text = ref("");
const maxLogs = diagnostics.getMaxLogs();
const copyModeText = ref("全部");

function refreshLogs(): void {
	logs.value = diagnostics.getLogs();
	text.value = diagnostics.toText();
	copyModeText.value = "全部";
}

function copyText(value: string, message: string): void {
	uni.setClipboardData({
		data: value,
		success() {
			ui.showToast({
				message,
				icon: "success"
			});
		}
	});
}

function copyAllLogs(): void {
	refreshLogs();
	copyText(text.value, "已复制全部日志");
}

function copyRecentLogs(): void {
	logs.value = diagnostics.getLogs();
	text.value = diagnostics.toText(200);
	copyModeText.value = "最近200条";
	copyText(text.value, "已复制最近200条");
}

function clearLogs(): void {
	diagnostics.clear();
	refreshLogs();
	ui.showToast({
		message: "诊断日志已清空",
		icon: "success"
	});
}

onShow(() => {
	refreshLogs();
});
</script>

