	flex: 1;
	min-height: 96rpx;
	padding: 16rpx;
	margin-right: 12rpx;
	border-radius: 8rpx;
	background-color: #111;
	box-sizing: border-box;
}

.summary-cell:last-child {
	margin-right: 0;
}

.summary-label {
	font-size: 22rpx;
	color: rgba(255, 255, 255, 0.55);
	margin-bottom: 8rpx;
}

.summary-value {
	font-size: 30rpx;
	color: #fff;
	font-weight: 600;
}

.action-grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 20rpx;
}

.action-item {
	width: 50%;
	padding-right: 12rpx;
	padding-bottom: 12rpx;
	box-sizing: border-box;
}

.action-item:nth-child(2n) {
	padding-right: 0;
}

.log-textarea {
	flex: 1;
	width: 100%;
	min-height: 720rpx;
	padding: 20rpx;
	border-radius: 8rpx;
	background-color: #080808;
	color: #fff;
