<template>
	<cl-page>
		<view class="diagnostics-page">
			<view class="diagnostics-header">
				<cl-text :size="18" :pt="{ className: 'font-bold mb-1' }">诊断日志</cl-text>
				<cl-text :size="12" :pt="{ className: 'opacity-60 leading-5' }">
					本机保留最近 {{ maxLogs }} 条，当前
					{{ totalLogs }} 条。超过上限自动覆盖最旧日志。
				</cl-text>
				<cl-text :size="12" :pt="{ className: 'opacity-60 leading-5 mt-1' }">
					完整日志按批自动存成 txt，不受 {{ maxLogs }} 条上限约束，路径
					Download/BOOM/logs/&lt;日期&gt;/。
				</cl-text>
			</view>

			<view class="summary-grid">
				<view class="summary-cell">
					<text class="summary-label">当前条数</text>
					<text class="summary-value">{{ totalLogs }}</text>
				</view>
				<view class="summary-cell">
					<text class="summary-label">保留上限</text>
					<text class="summary-value">{{ maxLogs }}</text>
				</view>
				<view class="summary-cell">
					<text class="summary-label">显示范围</text>
					<text class="summary-value">最近200条</text>
				</view>
			</view>

			<view class="action-grid">
				<view class="action-item">
					<cl-button type="primary" size="small" @tap="archiveNow">立即落盘</cl-button>
				</view>
				<view class="action-item">
					<cl-button size="small" @tap="refreshLogs">刷新</cl-button>
				</view>
				<view class="action-item">
					<cl-button size="small" @tap="clearLogs">清空</cl-button>
				</view>
			</view>

			<textarea class="log-textarea" :value="text" :maxlength="-1" disabled />
		</view>
	</cl-page>
</template>

<script setup lang="ts">
import { ref } from "vue";
import { diagnostics } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";

const ui = useUi();
const logs = ref<string[]>([]);
const text = ref("");
const totalLogs = ref(0);
const maxLogs = diagnostics.getMaxLogs();

async function refreshLogs(): Promise<void> {
	// 页面只显示最近 200 条；全量按批自动落盘，不在这里渲染。
	logs.value = await diagnostics.getLogsAsync(200);
	totalLogs.value = await diagnostics.getLogCountAsync();
	text.value = await diagnostics.toTextAsync(200);
}

/** 手动把还没攒够一批的日志写出去，不用等自动落盘。 */
function archiveNow(): void {
	diagnostics.flushArchiveNow();
	ui.showToast({ message: "已写入 Download/BOOM/logs/", icon: "success" });
}

async function clearLogs(): Promise<void> {
	await diagnostics.clear();
	await refreshLogs();
	ui.showToast({
		message: "诊断日志已清空",
		icon: "success"
	});
}

onShow(() => {
	void refreshLogs();
});
</script>

