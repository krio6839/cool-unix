<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">储能</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总储能 -->
			<Header
				:date="currentDate"
				:label="'总储能'"
				:value="currentState.totalEnergy"
				:progress="currentState.energyProgress"
				:config="{
					backgroundColor: '#282828',
					startColor: '#4CAF50',
					endColor: '#FF5C5C',
					dotColor: '#000'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<!-- 储能数据概览 -->
			<Status :items="currentState.energyItems"></Status>

			<!-- 当日能量曲线 -->
			<Chart
				:title="'当日能量曲线'"
				:option-data="energyChartOption"
				:height="200"
				:show-footer="false"
			></Chart>

			<!-- 身体储能趋势 -->
			<Chart
				:title="'身体储能趋势'"
				:option-data="bodyEnergyChartOption"
				:height="200"
				:show-footer="false"
				:show-tool="true"
			>
			</Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore, type StatusPageState } from "@/.cool";
import { ref, computed } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";

const { user } = useStore();

// 获取当前健康状态页面数据
const currentState = computed<StatusPageState>(() => user.getCurrentStatusPageState());

// 获取今天的日期
const currentDate = dayUts().format("YYYY-MM-DD");

const energyChartOption = computed(() => {
	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: [
				"00:00",
				"02:00",
				"04:00",
				"06:00",
				"08:00",
				"10:00",
				"12:00",
				"14:00",
				"16:00",
				"18:00",
				"20:00",
				"22:00"
			],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "能量",
				type: "line",
				data: currentState.value.energyChartData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#D2FF5C",
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(76, 175, 80, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(76, 175, 80, 0.1)"
							}
						]
					}
				}
			}
		]
	};
	return option;
});

const bodyEnergyChartOption = computed(() => {
	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "身体储能",
				type: "bar",
				data: currentState.value.bodyEnergyChartData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#d2ff5c"
							},
							{
								offset: 1,
								color: "#d2ff5c00"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};
	return option;
});

function goBack() {
	uni.navigateBack();
}

function goToDateSelect() {
	console.log("跳转到选择日期页面");
}
</script>

<style lang="scss" scoped></style>
