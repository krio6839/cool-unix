<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">储能</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总储能 -->
			<Header
				v-model:date="currentDate"
				:label="'总储能'"
				:value="energy.totalEnergy.value"
				:progress="energy.energyProgress.value"
				:config="{
					backgroundColor: '#282828',
					startColor: '#4CAF50',
					endColor: '#FF5C5C',
					dotColor: '#000'
				}"
			></Header>

			<!-- 储能数据概览 -->
			<Status :items="energyItems"></Status>

			<!-- 当日能量曲线 -->
			<Chart
				:title="'当日能量曲线'"
				:option-data="energyChartOption"
				:height="200"
				:show-footer="false"
			></Chart>

			<!-- 身体储能趋势 -->
			<Chart
				:title="'身体储能趋势'"
				:option-data="bodyEnergyChartOption"
				:height="200"
				:show-footer="false"
				:show-tool="true"
				@days-change="onTrendDaysChange"
			></Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import type { HealthItem, TimeValuePair, DateValuePair } from "@/.cool";
import { ref, computed, onMounted, watch } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";

const { device, energy } = useStore();
const currentDate = ref<string>(dayUts().format("YYYY-MM-DD"));
const trendDays = ref<string>("7d");

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "14d") {
		return 14;
	}
	if (option == "30d") {
		return 30;
	}
	return 7;
}

async function fetchEnergyStatus() {
	await energy.fetchStatus(device.currentDeviceId, currentDate.value);
}

async function fetchEnergyTrend(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await energy.fetchTrend(device.currentDeviceId, startDate, endDate);
}

function onTrendDaysChange(days: string) {
	trendDays.value = days;
	fetchEnergyTrend(days);
}

const energyItems = computed((): HealthItem[] => {
	return [
		{ label: "总充能", value: `${energy.totalCharge.value}` },
		{ label: "总耗能", value: `${energy.totalConsume.value}` }
	];
});

const energyChartOption = computed((): UTSJSONObject => {
	const chartData = energy.energyChartData.value ?? [];
	const timeData = chartData.map((item: TimeValuePair) => item.time);
	const valueData = chartData.map((item: TimeValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "能量",
				type: "line",
				data: valueData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#D2FF5C",
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(76, 175, 80, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(76, 175, 80, 0.1)"
							}
						]
					}
				}
			}
		]
	};
	return option;
});

const bodyEnergyChartOption = computed((): UTSJSONObject => {
	const chartData = energy.bodyEnergyChartData.value ?? [];
	const dateData = chartData.map((item: DateValuePair) => item.date);
	const valueData = chartData.map((item: DateValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dateData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "身体储能",
				type: "bar",
				data: valueData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#d2ff5c"
							},
							{
								offset: 1,
								color: "#d2ff5c00"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};
	return option;
});

function goBack() {
	uni.navigateBack();
}

watch(
	currentDate,
	() => {
		fetchEnergyStatus();
		fetchEnergyTrend(trendDays.value);
	},
	{ immediate: true }
);
</script>

<style lang="scss" scoped></style>
