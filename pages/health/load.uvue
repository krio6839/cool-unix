const defaultColors = ["#FF0040", "#00D9FF", "#0066FF", "#B700FF", "#FFE100", "#00FF80"];

// 当日实时负荷趋势图配置
const realtimeChartOption = computed(() => {
	const option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: [
				"00:00",
				"02:00",
				"04:00",
				"06:00",
				"08:00",
				"10:00",
				"12:00",
