<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">负荷</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总负荷 -->
			<Header
				:date="currentDate"
				:label="'总负荷'"
				:value="currentState.totalLoad"
				:progress="currentState.loadProgress"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#FF5C5C',
					dotColor: '#000'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="currentState.loadItems"></Status>

			<!-- 当日实时负荷趋势图 -->
			<Chart :title="'当日实时负荷'" :option="realtimeChartOption" :height="200"></Chart>

			<!-- 负荷区间分布图 -->
			<Chart :title="'负荷区间分布'" :option="loadZoneChartOption" :height="200"></Chart>

			<!-- 运动负荷趋势图 -->
			<Chart :title="'运动负荷趋势图'" :option="exerciseChartOption" :height="200"></Chart>

			<!-- 睡眠压力趋势图 -->
			<Chart :title="'睡眠压力趋势图'" :option="sleepChartOption" :height="200"></Chart>

			<!-- 心率区间趋势图 -->
			<Chart :title="'心率区间趋势图'" :option="heartRateChartOption" :height="200"></Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import { computed } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";

const { user } = useStore();

// 获取当前健康状态页面数据
const currentState = computed(() => user.getCurrentStatusPageState());

// 获取今天的日期
const currentDate = dayUts().format("YYYY-MM-DD");

// 当日实时负荷趋势图配置
const realtimeChartOption = computed(() => {
	const option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: [
				"00:00",
				"02:00",
				"04:00",
				"06:00",
				"08:00",
				"10:00",
				"12:00",
				"14:00",
				"16:00",
				"18:00",
				"20:00",
				"22:00"
			],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			min: 0,
			max: 20,
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: {
				show: true,
				lineStyle: {
					color: "rgba(255,255,255,0.1)",
					type: "dashed"
				},
				interval: 20
			}
		},
		series: [
			{
				name: "负荷",
				type: "line",
				data: currentState.value.realtimeLoadData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#D2FF5C",
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(210, 255, 92, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(210, 255, 92, 0.1)"
							}
						]
					}
				}
			}
		]
	};

	return JSON.stringify(option);
});

// 负荷区间分布数据
const loadZoneChartOption = computed(() => {
	const options: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: currentState.value.loadZones.map((item) => item.label),
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "负荷区间",
				type: "bar",
				data: currentState.value.loadZones.map((item) => {
					const valueStr = item.value as string;
					return parseInt(valueStr.split("%")[0]);
				}),
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#FFD700"
							},
							{
								offset: 1,
								color: "#FF8C00"
							}
						]
					},
					borderRadius: [4, 4, 4, 4]
				},
				barWidth: "60%"
			}
		]
	};
	return JSON.stringify(options);
});
const pressureChartOption = computed(() => {
	// 生成50个时间点（每30分钟一个）
	const timeData: string[] = [];
	for (let i = 0; i < 50; i++) {
		const hour = Math.floor((i * 30) / 60);
		const minute = (i * 30) % 60;
		timeData.push(`${hour.toString().padStart(2, "0")}:${minute.toString().padStart(2, "0")}`);
	}

	// 生成50个数据点，每个数据点包含起始值和结束值
	const startData: number[] = [];
	const barData: number[] = [];
	for (let i = 0; i < 50; i++) {
		const base = Math.floor(Math.random() * 20) + 25;
		const start = base - Math.floor(Math.random() * 20);
		const end = base + Math.floor(Math.random() * 20);
		startData.push(start);
		barData.push(end - start);
	}

	const options: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)",
				interval: 5 // 每5个点显示一个标签
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "起始位置",
				type: "bar",
				stack: "total",
				data: startData,
				itemStyle: {
					color: "transparent"
				},
				barWidth: "60%"
			},
			{
				name: "压力负荷",
				type: "bar",
				stack: "total",
				data: barData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#FFD700"
							},
							{
								offset: 1,
								color: "#FF8C00"
							}
						]
					},
					borderRadius: [4, 4, 4, 4]
				},
				barWidth: "60%"
			}
		]
	};
	return JSON.stringify(options);
});

// 运动负荷趋势图配置
const exerciseChartOption = computed(() => {
	const options: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "运动负荷",
				type: "line",
				data: currentState.value.exerciseLoadData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#9C27B0",
					width: 2
				}
			}
		]
	};

	return JSON.stringify(options);
});

// 睡眠压力趋势图配置
const sleepChartOption = computed(() => {
	const options: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "睡眠压力",
				type: "bar",
				data: currentState.value.sleepPressureData,
				itemStyle: {
					color: "#9C27B0"
				}
			}
		]
	};

	return JSON.stringify(options);
});

// 心率区间趋势图配置
const heartRateChartOption = computed(() => {
	const option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["00:00", "03:00", "06:00", "09:00", "12:00", "15:00", "18:00", "21:00"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "心率",
				type: "line",
				data: currentState.value.heartRateZoneData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#4CAF50",
					width: 2
				}
			}
		]
	};

	return JSON.stringify(option);
});

// 返回上一页
function goBack() {
	uni.navigateBack();
}

// 跳转到选择日期页面
function goToDateSelect() {
	// 这里可以添加跳转到日期选择页面的逻辑
	console.log("跳转到选择日期页面");
