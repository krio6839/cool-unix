<template>
	<cl-page :back-top="false">
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">负荷</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总负荷 -->
			<Header
				v-model:date="currentDate"
				:label="'总负荷'"
				:value="load.totalLoad.value"
				:progress="load.loadProgress.value"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#FF5C5C',
					dotColor: '#000'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<Status :items="loadStatusItems"></Status>

			<!-- 当日实时负荷趋势图 -->
			<Chart
				:title="'当日实时负荷'"
				:showFooter="false"
				:option-data="realtimeChartOption"
				:height="200"
			></Chart>

			<!-- 负荷区间状态 -->
			<view
				v-for="(item, index) in loadZoneItems"
				:key="index"
				class="relative w-full h-5 mb-0.5"
			>
				<cl-text
					:size="12"
					color="white"
					:class="'absolute z-20'"
					:style="{ left: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.name }}</cl-text
				>
				<cl-text
					:size="12"
					color="#666666"
					:class="'absolute z-20'"
					:style="{ right: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.rightText ?? (item.percentage ?? 0) + "%" }}</cl-text
				>
				<cl-progress
					:value="100"
					:color="item.color ?? defaultColors[index % defaultColors.length]"
					:show-text="false"
					:stroke-width="20"
					:pt="{
						className: 'opacity-15'
					}"
				></cl-progress>
			</view>

			<!-- 负荷趋势图 -->
			<Chart
				class="mt-4"
				:title="'负荷趋势'"
				:showTool="true"
				:option-data="loadZoneChartOption"
				:height="200"
				@days-change="onLoadTrendDaysChange"
			></Chart>

			<!-- 运动负荷趋势图 -->
			<Chart
				:title="'运动负荷'"
				:showTool="true"
				:option-data="exerciseChartOption"
				:height="200"
				@days-change="onSportLoadDaysChange"
			></Chart>

			<!-- 睡眠压力趋势图 -->
			<Chart
				:title="'睡眠压力趋势图'"
				:showTool="true"
				:option-data="sleepChartOption"
				:height="200"
				@days-change="onSleepPressureDaysChange"
			></Chart>

			<!-- 心率区间趋势图 -->
			<Chart
				:title="'心率区间趋势图'"
				:showFooter="false"
				:option-data="heartRateChartOption"
				:height="200"
			></Chart>

			<!-- 心率区间分布 -->
			<view
				v-for="(item, index) in heartRateZoneItems"
				:key="index"
				class="relative w-full h-5 mb-0.5"
			>
				<cl-text
					:size="12"
					color="white"
					:class="'absolute z-20'"
					:style="{ left: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.name }}</cl-text
				>
				<cl-text
					:size="12"
					color="#666666"
					:class="'absolute z-20'"
					:style="{ right: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.rightText ?? (item.percentage ?? 0) + "%" }}</cl-text
				>
				<cl-progress
					:value="100"
					:color="item.color ?? defaultColors[index % defaultColors.length]"
					:show-text="false"
					:stroke-width="20"
					:pt="{
						className: 'opacity-15'
					}"
				></cl-progress>
			</view>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import type { HealthItem, TimeValuePair, DateValuePair, ZoneItem } from "@/.cool";
import { ref, computed, onMounted, watch } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";

const { device, load, realtime } = useStore();
const currentDate = ref<string>(dayUts().format("YYYY-MM-DD"));
const loadTrendDays = ref<string>("7d");
const sportLoadDays = ref<string>("7d");
const sleepPressureDays = ref<string>("7d");

const defaultColors = ["#FF0040", "#00D9FF", "#0066FF", "#B700FF", "#FFE100", "#00FF80"];

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "14d") {
		return 14;
	}
	if (option == "30d") {
		return 30;
	}
	return 7;
}

async function fetchLoadStatus() {
	await load.fetchStatus(device.boundDeviceId, currentDate.value);
}

async function fetchLoadTrend(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await load.fetchTrend(device.boundDeviceId, startDate, endDate);
}

async function fetchSportLoad(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await load.fetchSportLoad(device.boundDeviceId, startDate, endDate);
}

async function fetchSleepPressure(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await load.fetchSleepPressure(device.boundDeviceId, startDate, endDate);
}

function onLoadTrendDaysChange(days: string) {
	loadTrendDays.value = days;
	fetchLoadTrend(days);
}

function onSportLoadDaysChange(days: string) {
	sportLoadDays.value = days;
	fetchSportLoad(days);
}

function onSleepPressureDaysChange(days: string) {
	sleepPressureDays.value = days;
	fetchSleepPressure(days);
}

const loadStatusItems = computed((): HealthItem[] => {
	const realtimeValues = realtime.healthCardValues.value;
	const restingHeartRate =
		realtimeValues.restingHeartRate == null ? "-" : realtimeValues.restingHeartRate.toString();
	const steps = realtime.steps.value == null ? "-" : realtime.steps.value.toString();
	const calories = realtime.calories.value == null ? "-" : realtime.calories.value.toFixed(1);
	return [
		{ label: "平均负荷", value: `${load.avgLoad.value}` },
		{ label: "静息心率", value: restingHeartRate },
		{ label: "步数", value: steps },
		{ label: "卡路里", value: calories }
	];
});

const loadZoneItems = computed((): ZoneItem[] => {
	const z = load.loadZones.value;
	if (z == null) {
		return [];
	}
	return [
		{
			name: "负荷过载",
			percentage: z.overload.percentage,
			rightText: `${z.overload.percentage}%｜${z.overload.hours}小时`
		},
		{
			name: "注意压力",
			percentage: z.warning.percentage,
			rightText: `${z.warning.percentage}%｜${z.warning.hours}小时`
		},
		{
			name: "状态正常",
			percentage: z.normal.percentage,
			rightText: `${z.normal.percentage}%｜${z.normal.hours}小时`
		},
		{
			name: "状态优秀",
			percentage: z.excellent.percentage,
			rightText: `${z.excellent.percentage}%｜${z.excellent.hours}小时`
		}
	];
});

const heartRateZoneItems = computed((): ZoneItem[] => {
	const h = load.heartRateZoneItems.value;
	if (h == null) {
		return [];
	}
	return [
		{ name: "Zone 0", percentage: h.zone0 },
		{ name: "Zone 1", percentage: h.zone1 },
		{ name: "Zone 2", percentage: h.zone2 },
		{ name: "Zone 3", percentage: h.zone3 },
		{ name: "Zone 4", percentage: h.zone4 },
		{ name: "Zone 5", percentage: h.zone5 }
	];
});

const realtimeChartOption = computed((): UTSJSONObject => {
	const chartData = load.realtimeLoadData.value ?? [];
	const timeData = chartData.map((item: TimeValuePair) => item.time);
	const valueData = chartData.map((item: TimeValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "负荷",
				type: "line",
				data: valueData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#D2FF5C",
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(210, 255, 92, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(210, 255, 92, 0.1)"
							}
						]
					}
				}
			}
		]
	};

	return option;
});

const loadZoneChartOption = computed((): UTSJSONObject => {
	const chartData = load.loadTrendData.value ?? [];
	const dateData = chartData.map((item: DateValuePair) => item.date);
	const valueData = chartData.map((item: DateValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dateData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "负荷",
				type: "bar",
				data: valueData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#d2ff5c"
							},
							{
								offset: 1,
								color: "#d2ff5c00"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};
	return option;
});

const exerciseChartOption = computed((): UTSJSONObject => {
	const chartData = load.sportLoadTrendData.value ?? [];
	const dateData = chartData.map((item: DateValuePair) => item.date);
	const valueData = chartData.map((item: DateValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dateData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "运动负荷",
				type: "bar",
				data: valueData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#9C27B0"
							},
							{
								offset: 1,
								color: "#9C27B000"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};

	return option;
});

const sleepChartOption = computed((): UTSJSONObject => {
	const chartData = load.sleepPressureTrendData.value ?? [];
	const dateData = chartData.map((item: DateValuePair) => item.date);
	const valueData = chartData.map((item: DateValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dateData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "睡眠压力",
				type: "bar",
				data: valueData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#9C27B0"
							},
							{
								offset: 1,
								color: "#9C27B000"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};

	return option;
});

const heartRateChartOption = computed((): UTSJSONObject => {
	const chartData = load.heartRateZoneData.value ?? [];
	const timeData = chartData.map((item: TimeValuePair) => item.time);
	const valueData = chartData.map((item: TimeValuePair) => item.value);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "心率",
				type: "line",
				data: valueData,
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#4CAF50",
					width: 2
				}
			}
		]
	};

	return option;
});

function goBack() {
	uni.navigateBack();
}

function goToDateSelect() {
	console.log("跳转到选择日期页面");
}

watch(
	currentDate,
	() => {
		fetchLoadStatus();
	},
	{ immediate: true }
);

onMounted(() => {
	fetchLoadStatus();
	fetchLoadTrend(loadTrendDays.value);
	fetchSportLoad(sportLoadDays.value);
	fetchSleepPressure(sleepPressureDays.value);
});
</script>

<style lang="scss" scoped></style>
