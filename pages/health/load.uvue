				:option="realtimeChartOption"
				:height="200"
			></Chart>

			<!-- 负荷区间状态 -->
			<view
				v-for="(item, index) in currentState.loadZones"
				:key="index"
				class="relative w-full h-5 mb-0.5"
			>
				<cl-text
					:size="12"
					color="white"
					:class="'absolute z-20'"
					:style="{ left: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.name }}</cl-text
				>
				<cl-text
					:size="12"
					color="#666666"
					:class="'absolute z-20'"
					:style="{ right: '12rpx', top: '50%', transform: 'translateY(-50%)' }"
					>{{ item.rightText ?? item.percentage + "%" }}</cl-text
				>
				<cl-progress
					:value="100"
					:color="item.color ?? defaultColors[index % defaultColors.length]"
					:show-text="false"
					:stroke-width="20"
					:pt="{
						className: 'opacity-15'
					}"
				></cl-progress>
			</view>

			<!-- 负荷趋势图 -->
			<Chart
				class="mt-4"
				:title="'负荷趋势'"
