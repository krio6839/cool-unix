<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">负荷</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总负荷 -->
			<Header
				:date="currentDate"
				:label="'总负荷'"
				:value="totalLoad"
				:progress="loadProgress"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#FF5C5C',
					dotColor: '#000'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="healthItems"></Status>

			<!-- 当日实时负荷趋势图 -->
			<Chart
				:title="'当日实时负荷趋势图'"
				:option="realtimeChartOption"
				:height="200"
			></Chart>

			<!-- 压力负荷趋势图 -->
			<Chart :title="'压力负荷趋势图'" :option="pressureChartOption" :height="200"></Chart>

			<!-- 运动负荷趋势图 -->
			<Chart :title="'运动负荷趋势图'" :option="exerciseChartOption" :height="200"></Chart>

			<!-- 睡眠压力趋势图 -->
			<Chart :title="'睡眠压力趋势图'" :option="sleepChartOption" :height="200"></Chart>

			<!-- 心率区间趋势图 -->
			<Chart :title="'心率区间趋势图'" :option="heartRateChartOption" :height="200"></Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp } from "@/.cool";
import { ref, computed } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
// @ts-ignore
import Chart from "./components/chart.uvue";
import type { HealthItem, ChartOption } from "./types";

// 组件数据
const currentDate = ref<string>("2025.10.14");
const totalLoad = ref<number>(7326);
const loadProgress = ref<number>(60);

// 健康数据
const healthItems = ref<HealthItem[]>([
	{
		label: "平均负荷",
		value: 36
	},
	{
		label: "静态心率",
		value: 78
	},
	{
		label: "步数",
		value: 9587
	},
	{
		label: "卡路里",
		value: 598
	}
]);

// 当日实时负荷趋势图配置
const realtimeChartOption = computed(() => {
	const option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["00:00", "02:00", "04:00", "06:00", "08:00", "10:00", "12:00", "14:00"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			min: 0,
			max: 20,
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: {
				show: true,
				lineStyle: {
					color: "rgba(255,255,255,0.1)",
					type: "dashed"
				},
				interval: 20
			}
		},
		series: [
			{
				name: "负荷",
				type: "line",
				data: [5, 8, 12, 8, 15, 12, 10, 8],
				smooth: true,
				symbol: "none",
				lineStyle: {
					color: "#D2FF5C",
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(210, 255, 92, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(210, 255, 92, 0.1)"
							}
						]
					}
				}
			}
		]
	};

	return JSON.stringify(option);
});

// 压力负荷趋势图配置
const pressureChartOption = computed(() => {
	// 生成50个时间点（每30分钟一个）
	const timeData: string[] = [];
	for (let i = 0; i < 50; i++) {
		const hour = Math.floor((i * 30) / 60);
		const minute = (i * 30) % 60;
		timeData.push(`${hour.toString().padStart(2, "0")}:${minute.toString().padStart(2, "0")}`);
	}

	// 生成50个数据点，每个数据点包含起始值和结束值
	const startData: number[] = [];
	const barData: number[] = [];
	for (let i = 0; i < 50; i++) {
		const base = Math.floor(Math.random() * 20) + 25;
		const start = base - Math.floor(Math.random() * 20);
		const end = base + Math.floor(Math.random() * 20);
		startData.push(start);
		barData.push(end - start);
	}

	const options: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			axisPointer: {
				type: "shadow"
			},
			backgroundColor: "rgba(0, 0, 0, 0.8)",
			borderColor: "#FFD700",
			borderWidth: 1,
			textStyle: {
				color: "#fff",
				fontSize: 12
			},
			padding: 10
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)",
				interval: 5 // 每5个点显示一个标签
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: { show: false },
			axisLabel: { show: false },
			splitLine: { show: false }
		},
		series: [
			{
				name: "起始位置",
				type: "bar",
				stack: "total",
				data: startData,
				itemStyle: {
					color: "transparent"
				},
				barWidth: "60%"
			},
			{
				name: "压力负荷",
				type: "bar",
				stack: "total",
				data: barData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#FFD700"
							},
							{
								offset: 1,
								color: "#FF8C00"
							}
						]
					},
					borderRadius: [4, 4, 4, 4]
				},
				barWidth: "60%"
			}
		]
	};
	return JSON.stringify(options);
});

