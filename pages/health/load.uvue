							},
							{
								offset: 1,
								color: "rgba(20, 120, 50, 0.3)"
							}
						]
					}
				},
				barWidth: "100%",
				barGap: "0%",
				barCategoryGap: "0%"
			},
			{
				name: "背景3",
				type: "bar",
				data: [0, 0, 0, 0, 0, 0, 100, 100],
				showTooltip: false,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(239, 112, 24, 0.01)"
							},
							{
								offset: 1,
								color: "rgba(180, 70, 10, 0.3)"
							}
						]
					}
				},
				barWidth: "100%",
				barGap: "0%",
				barCategoryGap: "0%"
			},
			{
				name: "运动负荷",
				type: "line",
				data: [20, 45, 60, 40, 50, 45, 40, 35],
				smooth: false,
				symbol: "none",
				lineStyle: {
					color: "#9C27B0",
					width: 2
				}
			}
		]
	};

	return JSON.stringify(options);
});

// 睡眠压力趋势图配置
