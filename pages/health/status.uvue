<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">状态</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和状态 -->
			<Header
				:date="today"
				:label="'状态'"
				:value="currentState.totalStatus"
				:progress="currentState.statusProgress"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#2FABCB',
					dotColor: '#000'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="currentState.healthItems"></Status>

			<!-- 当日HRV变化趋势图 -->
			<Chart :title="'当日HRV变化'" :option="hrvChartOption" :height="200"></Chart>

			<Chart
				:title="'训练准备度'"
				:option="readinessChartOption"
				:height="200"
				:showTool="true"
			>
			</Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, type StatusPageState } from "@/.cool";
import { computed, ref } from "vue";
import { useStore } from "@/.cool";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";
import type { ClTabsItem } from "@/uni_modules/cool-ui";

const { user } = useStore();

// 获取当前健康状态页面数据
const currentState = computed<StatusPageState>(() => user.getCurrentStatusPageState());

// 获取今天的日期
const today = dayUts().format("YYYY-MM-DD");

// 当日HRV变化趋势图配置
const hrvChartOption = computed(() => {
	// 计算HRV数据的平均值
	const hrvData = currentState.value.hrvData;
	const sum = hrvData.reduce((acc, val) => acc + val, 0);
	const average = hrvData.length > 0 ? sum / hrvData.length : 0;

	// 生成平均值数据（与xAxis数据长度相同）
	const averageData = hrvData.map(function (_val: number): number {
		return average;
	});

	// 正常范围的上下限（根据参考图设置）
	const normalRangeMin = 65;
	const normalRangeMax = 105;

	let option: UTSJSONObject = {
		tooltip: {
			show: false,
			trigger: "item",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 10,
			right: 10,
			top: "5%",
			bottom: 25,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: [
				"00:00",
				"02:00",
				"04:00",
				"06:00",
				"08:00",
				"10:00",
				"12:00",
				"14:00",
				"16:00",
				"18:00",
				"20:00",
				"22:00"
			],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			position: "right",
			min: 25,
			max: 150,
			axisLine: {
				show: true,
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			},
			axisLabel: {
				show: true,
				color: "rgba(255,255,255,0.6)"
			},
			splitLine: {
				show: false
			}
		},
		series: [
			// HRV散点（不显示线，只显示点）
			{
				name: "心率变异性",
				type: "scatter",
				data: hrvData,
				itemStyle: {
					color: "#FE8C04"
				},
				symbol: "circle",
				symbolSize: 8,
				z: 3
			},
			// 正常范围区域
			{
				name: "正常范围",
				type: "bar",
				data: hrvData.map(function (_val: number): number {
					return normalRangeMax;
				}),
				itemStyle: {
					color: "transparent"
				},
				markArea: {
					silent: true,
					itemStyle: {
						color: "rgba(210, 255, 92, 0.15)"
					},
					data: [
						[
							{
								yAxis: normalRangeMin
							},
							{
								yAxis: normalRangeMax
							}
						]
					]
				},
				z: 1
			},
			// 平均值横线
			{
				name: "平均",
				type: "line",
				data: averageData,
				itemStyle: {
					color: "#FFD700"
				},
				lineStyle: {
					color: "#FFD700",
					width: 2,
					type: "solid"
				},
				symbol: "none",
				z: 2
			}
		],
		legend: {
			data: [
				{
					name: "心率变异性",
					itemStyle: {
						color: "#FE8C04"
					}
				},
				{
					name: "正常范围",
					itemStyle: {
						color: "rgba(210, 255, 92, 0.15)"
					}
				},
				{
					name: "平均",
					itemStyle: {
						color: "#FFD700"
					}
				}
			],
			textStyle: {
				color: "rgba(255,255,255,0.8)"
			},
			bottom: 0,
			left: "left"
		}
	};
	return JSON.stringify(option);
});

// 训练准备度趋势图配置
const readinessChartOption = computed(() => {
	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "准备度",
				type: "bar",
				data: currentState.value.readinessData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#d2ff5c"
							},
							{
								offset: 1,
								color: "#d2ff5c00"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};
	return JSON.stringify(option);
});

// 返回上一页
function goBack() {
	uni.navigateBack();
}

// 跳转到选择日期页面
function goToDateSelect() {
	// 这里可以添加跳转到日期选择页面的逻辑
	console.log("跳转到选择日期页面");
	// 示例：uni.navigateTo({ url: '/pages/date-select/date-select' });
}
</script>

<style lang="scss" scoped></style>
