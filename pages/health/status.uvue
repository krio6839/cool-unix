<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">状态</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和状态 -->
			<Header
				v-model:date="selectedDate"
				:label="'状态'"
				:value="status.totalStatus.value"
				:progress="status.statusProgress.value"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#2FABCB',
					dotColor: '#000'
				}"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="healthItems"></Status>

			<!-- 当日HRV变化趋势图 -->
			<Chart
				:title="'当日HRV变化'"
				:option-data="hrvChartOption"
				:height="200"
				:show-footer="false"
			></Chart>

			<Chart
				:title="'训练准备度'"
				:option-data="readinessChartOption"
				:height="200"
				:show-tool="true"
				:show-footer="false"
				@days-change="onReadinessDaysChange"
			></Chart>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import type { TrendType, TimeValuePair, DateValuePair, HealthItem } from "@/.cool";
import { ref, computed, onMounted, watch } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import Chart from "./components/chart.uvue";

const { device, status, realtime } = useStore();
const selectedDate = ref<string>(dayUts().format("YYYY-MM-DD"));
const readinessDays = ref<string>("7d");

async function fetchStatusData() {
	await status.fetchStatus(device.boundDeviceId, selectedDate.value);
}

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "14d") {
		return 14;
	}
	if (option == "30d") {
		return 30;
	}
	return 7;
}

async function fetchReadinessData(days: string) {
	const endDate = selectedDate.value;
	const startDate = dayUts(endDate)
		.subtract(getDaysFromOption(days) - 1, "day")
		.format("YYYY-MM-DD");
	await status.fetchReadiness(device.boundDeviceId, startDate, endDate);
}

function getDateRange(endDate: string, days: number): string[] {
	const dates: string[] = [];
	for (let i = days - 1; i >= 0; i--) {
		dates.push(dayUts(endDate).subtract(i, "day").format("YYYY-MM-DD"));
	}
	return dates;
}

function onReadinessDaysChange(days: string) {
	readinessDays.value = days;
	fetchReadinessData(days);
}

const healthItems = computed((): HealthItem[] => {
	const realtimeValues = realtime.healthCardValues.value;
	const hrv = realtimeValues.hrv == null ? "-" : `${realtimeValues.hrv}ms`;
	const restingHeartRate =
		realtimeValues.restingHeartRate == null ? "-" : `${realtimeValues.restingHeartRate}bpm`;
	return [
		{ label: "心率变异性", value: hrv, trend: "up" as TrendType },
		{
			label: "静息心率",
			value: restingHeartRate,
			trend: "down" as TrendType
		}
	];
});

watch(
	selectedDate,
	() => {
		fetchStatusData();
		fetchReadinessData(readinessDays.value);
	},
	{ immediate: true }
);

// 当日HRV变化趋势图配置
const hrvChartOption = computed((): UTSJSONObject => {
	const hrvChartData = status.hrvData.value ?? [];
	const hrvValues = hrvChartData.map((item: TimeValuePair) => item.value);
	const timeData = hrvChartData.map((item: TimeValuePair) => item.time);

	const sum = hrvValues.reduce((acc, val) => acc + val, 0);
	const average = hrvValues.length > 0 ? sum / hrvValues.length : 0;

	const averageData = hrvValues.map(function (_val: number): number {
		return average;
	});

	const normalRangeMin = 65;
	const normalRangeMax = 105;

	let option: UTSJSONObject = {
		tooltip: {
			show: false,
			trigger: "item",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 10,
			right: 10,
			top: "5%",
			bottom: 25,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: timeData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			position: "right",
			min: 25,
			max: 150,
			axisLine: {
				show: true,
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			},
			axisLabel: {
				show: true,
				color: "rgba(255,255,255,0.6)"
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "心率变异性",
				type: "scatter",
				data: hrvValues,
				itemStyle: {
					color: "#FE8C04"
				},
				symbol: "circle",
				symbolSize: 8,
				z: 3
			},
			{
				name: "正常范围",
				type: "bar",
				data: hrvValues.map(function (_val: number): number {
					return normalRangeMax;
				}),
				itemStyle: {
					color: "transparent"
				},
				markArea: {
					silent: true,
					itemStyle: {
						color: "rgba(210, 255, 92, 0.15)"
					},
					data: [
						[
							{
								yAxis: normalRangeMin
							},
							{
								yAxis: normalRangeMax
							}
						]
					]
				},
				z: 1
			},
			{
				name: "平均",
				type: "line",
				data: averageData,
				itemStyle: {
					color: "#FFD700"
				},
				lineStyle: {
					color: "#FFD700",
					width: 2,
					type: "solid"
				},
				symbol: "none",
				z: 2
			}
		],
		legend: {
			data: [
				{
					name: "心率变异性",
					itemStyle: {
						color: "#FE8C04"
					}
				},
				{
					name: "正常范围",
					itemStyle: {
						color: "rgba(210, 255, 92, 0.15)"
					}
				},
				{
					name: "平均",
					itemStyle: {
						color: "#FFD700"
					}
				}
			],
			textStyle: {
				color: "rgba(255,255,255,0.8)"
			},
			bottom: 0,
			left: "left"
		}
	};
	return option;
});

// 训练准备度趋势图配置
const readinessChartOption = computed((): UTSJSONObject => {
	const chartData = status.readinessData.value ?? [];
	const fullDateData = getDateRange(selectedDate.value, getDaysFromOption(readinessDays.value));
	const dateData = fullDateData.map((date: string): string => date.slice(5));
	const valueByDate: { [key: string]: number } = {};
	chartData.forEach((item: DateValuePair) => {
		valueByDate[item.date] = item.value;
	});
	const valueData = fullDateData.map(
		(date: string): number | null => valueByDate[date] ?? null
	);

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 0,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dateData,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "准备度",
				type: "bar",
				data: valueData,
				itemStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "#d2ff5c"
							},
							{
								offset: 1,
								color: "#d2ff5c00"
							}
						]
					}
				},
				barWidth: "50%"
			}
		]
	};
	return option;
});

function goBack() {
	uni.navigateBack();
}

</script>

<style lang="scss" scoped></style>
