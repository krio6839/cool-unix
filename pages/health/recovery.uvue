<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">超量恢复黄金窗口</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部数据 -->
			<view class="flex flex-row justify-between mb-6">
				<view class="text-center">
					<cl-text :size="14" color="rgba(255,255,255,0.6)" :pt="{ className: 'mb-1' }"
						>TSB</cl-text
					>
					<cl-text :size="24" color="white" :pt="{ className: 'font-bold' }">
						{{ recovery.tsb.value }}
					</cl-text>
				</view>
				<view class="text-center">
					<cl-text :size="14" color="rgba(255,255,255,0.6)" :pt="{ className: 'mb-1' }"
						>短期负荷ATL</cl-text
					>
					<cl-text :size="24" color="white" :pt="{ className: 'font-bold' }">
						{{ recovery.atl.value }}
					</cl-text>
				</view>
				<view class="text-center">
					<cl-text :size="14" color="rgba(255,255,255,0.6)" :pt="{ className: 'mb-1' }"
						>长期负荷CTL</cl-text
					>
					<cl-text :size="24" color="white" :pt="{ className: 'font-bold' }">
						{{ recovery.ctl.value }}
					</cl-text>
				</view>
			</view>

			<!-- 指标标记 -->
			<view class="flex flex-row mb-4">
				<view class="flex flex-row items-center mr-4">
					<view class="w-3 h-3 rounded-full bg-green-400 mr-2"></view>
					<cl-text :size="14" color="rgba(255,255,255,0.6)">ATL</cl-text>
				</view>
				<view class="flex flex-row items-center">
					<view class="w-3 h-3 rounded-full bg-orange-400 mr-2"></view>
					<cl-text :size="14" color="rgba(255,255,255,0.6)">CTL</cl-text>
				</view>
			</view>

			<!-- 趋势图表 -->
			<Chart :option-data="chartOption" :height="200" :show-footer="false"></Chart>
			<cl-tabs
				v-model="currentTimeRange"
				:list="timeRanges"
				fill
				showSlider
				:pt="{
					className: 'mb-6 !bg-[#1C1C1E] rounded-lg',
					slider: { className: '!bg-[#49494B]' }
				}"
				@change="selectTimeRange"
			></cl-tabs>

			<!-- TSB训练疲劳度参考表 -->
			<view class="mb-6">
				<view class="flex flex-row justify-between items-center mb-3">
					<cl-text :size="16" color="white" :pt="{ className: 'font-bold' }">
						TSB训练疲劳度参考表
					</cl-text>
					<cl-icon name="chevron-down" color="white" :size="16"></cl-icon>
				</view>
				<view
					class="flex flex-row justify-between mb-2"
					v-for="(item, index) in tsbReference"
					:key="index"
				>
					<cl-text :size="14" color="rgba(255,255,255,0.8)">{{ item.range }}</cl-text>
					<cl-text :size="14" color="rgba(255,255,255,0.6)">{{ item.status }}</cl-text>
				</view>
			</view>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import { ref, computed, onMounted } from "vue";
import type { TsbReferenceItem } from "./types";
import type { ClTabsItem } from "@/uni_modules/cool-ui";

import Chart from "./components/chart.uvue";

const { device, recovery } = useStore();

// 时间范围选项
const timeRanges = ref<ClTabsItem[]>([
	{ label: "7天", value: "7d" },
	{ label: "30天", value: "30d" },
	{ label: "60天", value: "60d" }
]);
const currentTimeRange = ref<string>("7d");

// TSB训练疲劳度参考表
const tsbReference: TsbReferenceItem[] = [
	{ range: "TSB>=-25", status: "状态下滑" },
	{ range: "25>TSB>=-10", status: "恢复良好" },
	{ range: "10>TSB>=-0", status: "轻度疲劳" },
	{ range: "0>TSB>=-10", status: "稍高疲劳" },
	{ range: "-10>TSB>=-25", status: "高度疲劳" },
	{ range: "-25>TSB", status: "极度疲劳" }
];

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "30d") {
		return 30;
	}
	if (option == "60d") {
		return 60;
	}
	return 7;
}

async function fetchRecoveryStatus() {
	await recovery.fetchStatus(device.boundDeviceId);
}

async function fetchRecoveryTrend(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await recovery.fetchTrend(device.boundDeviceId, startDate, endDate);
}

function onTrendDaysChange(days: string) {
	currentTimeRange.value = days;
	fetchRecoveryTrend(days);
}

const chartOption = computed((): UTSJSONObject => {
	const atlData = recovery.atlTrendData.value ?? [];
	const ctlData = recovery.ctlTrendData.value ?? [];
	const dates = recovery.trendDates.value ?? [];

	let option: UTSJSONObject = {
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 30,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: dates,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "ATL",
				type: "line",
				data: atlData,
				itemStyle: {
					color: "#D2FF5C"
				},
				lineStyle: {
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(210, 255, 92, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(210, 255, 92, 0)"
							}
						]
					}
				}
			},
			{
				name: "CTL",
				type: "line",
				data: ctlData,
				itemStyle: {
					color: "#FF9800"
				},
				lineStyle: {
					width: 2
				}
			}
		]
	};
	return option;
});

// 选择时间范围
function selectTimeRange(value: string) {
	currentTimeRange.value = value;
	fetchRecoveryTrend(value);
}

// 返回上一页
function goBack() {
	uni.navigateBack();
}

onMounted(() => {
	fetchRecoveryStatus();
	fetchRecoveryTrend(currentTimeRange.value);
});
</script>

<style lang="scss" scoped></style>
