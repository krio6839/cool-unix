<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">睡眠</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总睡眠 -->
			<Header
				:date="currentDate"
				:label="'总睡眠'"
				:value="currentState.totalSleep"
				:progress="currentState.sleepProgress"
				type="linear"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#FF5C5C'
				}"
				@go-to-date-select="goToDateSelect"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="currentState.sleepItems"></Status>

			<!-- 睡眠进度和恢复性睡眠 -->
			<SleepProgress
				:suggestedSleepDuration="currentState.suggestedSleepDuration"
			></SleepProgress>

			<!-- 恢复性睡眠 -->
			<SleepRecovery
				:percentage="currentState.recoverySleep.percentage"
				:duration="currentState.recoverySleep.duration"
			></SleepRecovery>

			<!-- 睡眠期间数据 -->
			<SleepDuringStats
				v-model:activeMetric="sleepActiveMetric"
				:list="selectedSleepData"
			></SleepDuringStats>

			<!-- 趋势图表 - 睡眠时长 -->
			<SleepTrend
				:sleepDurationData="currentState.sleepDurationData"
				:sleepPattern="currentState.sleepPattern"
			></SleepTrend>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import type { TimeValueItem } from "@/.cool";
import { ref, computed } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import SleepProgress from "./components/sleep-progress.uvue";
import SleepRecovery from "./components/sleep-recovery.uvue";
import SleepDuringStats from "./components/sleep-during-stats.uvue";
import SleepTrend from "./components/sleep-trend.uvue";

const { user } = useStore();

// 获取当前健康状态页面数据
const currentState = computed(() => user.getCurrentStatusPageState());

// 获取今天的日期
const currentDate = ref<string>(dayUts().format("YYYY-MM-DD"));

// 睡眠期间数据 - 当前选中的指标
const sleepActiveMetric = ref<string>("heartRate");

// 选中的睡眠数据
const selectedSleepData = computed((): TimeValueItem[] => {
	const data = currentState.value;
	const metric = sleepActiveMetric.value;

	if (metric === "hrv" && data.sleepHrvData != null) {
		return data.sleepHrvData;
	} else if (metric === "oxygen" && data.sleepOxygenData != null) {
		return data.sleepOxygenData;
	} else if (metric === "heartRate" && data.sleepHeartRateData != null) {
		return data.sleepHeartRateData;
	} else {
		return [];
	}
});

// 返回上一页
function goBack() {
	uni.navigateBack();
}

// 跳转到选择日期页面
function goToDateSelect() {
	// 跳转到日期选择页面
	uni.navigateTo({
		url: "/pages/health/date-select/date-select"
	});
}

// 监听日期选择事件
uni.$on("dateSelected", (date: string) => {
	// 更新选中的日期
	currentDate.value = date;
	// 这里可以添加根据选择的日期获取对应数据的逻辑
	console.log("Selected date:", date);
});
</script>

<style lang="scss" scoped>
/* 原子化类已在模板中直接使用，此处仅保留必要的样式 */
</style>
