<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">睡眠</cl-text>
				<view class="w-5"></view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 顶部日期和总睡眠 -->
			<Header
				v-model:date="currentDate"
				:label="'总睡眠'"
				:value="sleep.totalSleep.value"
				:progress="sleep.sleepProgress.value"
				type="linear"
				:config="{
					backgroundColor: '#282828',
					startColor: '#D2FF5C',
					endColor: '#FF5C5C'
				}"
			></Header>

			<!-- 健康数据概览 -->
			<Status :items="sleepItems"></Status>

			<!-- 睡眠进度和恢复性睡眠 -->
			<SleepProgress></SleepProgress>

			<!-- 恢复性睡眠 -->
			<SleepRecovery></SleepRecovery>

			<!-- 睡眠期间数据 -->
			<SleepDuringStats v-model:activeMetric="sleepActiveMetric"></SleepDuringStats>

			<!-- 趋势图表 - 睡眠时长 -->
			<SleepTrend></SleepTrend>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore } from "@/.cool";
import type { HealthItem, TimeValuePair, DateValuePair } from "@/.cool";
import { ref, computed, onMounted, watch } from "vue";
import Header from "./components/header.uvue";
import Status from "./components/status.uvue";
import SleepProgress from "./components/sleep-progress.uvue";
import SleepRecovery from "./components/sleep-recovery.uvue";
import SleepDuringStats from "./components/sleep-during-stats.uvue";
import SleepTrend from "./components/sleep-trend.uvue";

const { device, sleep } = useStore();
const currentDate = ref<string>(dayUts().format("YYYY-MM-DD"));
const trendDays = ref<string>("7d");
const sleepActiveMetric = ref<string>("heartRate");

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "14d") {
		return 14;
	}
	if (option == "30d") {
		return 30;
	}
	return 7;
}

async function fetchSleepStatus() {
	await sleep.fetchStatus(device.currentDeviceId, currentDate.value);
}

async function fetchSleepMetric() {
	await sleep.fetchMetric(device.currentDeviceId, currentDate.value);
}

async function fetchSleepTrend(days: string) {
	const endDate = dayUts().format("YYYY-MM-DD");
	const startDate = dayUts().subtract(getDaysFromOption(days), "day").format("YYYY-MM-DD");
	await sleep.fetchTrend(device.currentDeviceId, startDate, endDate);
	await sleep.fetchSleepMode(device.currentDeviceId, startDate, endDate);
}

function onTrendDaysChange(days: string) {
	trendDays.value = days;
	fetchSleepTrend(days);
}

const sleepItems = computed((): HealthItem[] => {
	return [
		{ label: "睡眠时长", value: sleep.sleepDuration.value ?? "--" },
		{ label: "睡眠质量", value: `${sleep.sleepQuality.value ?? 0}` }
	];
});

const selectedSleepData = computed((): TimeValuePair[] => {
	const metric = sleepActiveMetric.value;

	if (metric === "hrv") {
		return sleep.sleepHrvData.value ?? [];
	} else if (metric === "oxygen") {
		return sleep.sleepOxygenData.value ?? [];
	} else {
		return sleep.sleepHeartRateData.value ?? [];
	}
});

// 返回上一页
function goBack() {
	uni.navigateBack();
}

watch(
	currentDate,
	() => {
		fetchSleepStatus();
		fetchSleepMetric();
		fetchSleepTrend(trendDays.value);
	},
	{ immediate: true }
);

onMounted(() => {
	fetchSleepStatus();
	fetchSleepMetric();
	fetchSleepTrend(trendDays.value);
});
</script>

<style lang="scss" scoped></style>
