<template>
	<cl-page>
		<cl-topbar
			fixed
			:show-back="true"
			safe-area-top
			:height="isMp() ? null : 50"
			background-color="transparent"
		>
			<view class="flex flex-row items-center justify-between w-full p-3">
				<cl-icon name="arrow-left-line" color="white" :size="20" @tap="goBack"></cl-icon>
				<cl-text :size="18" color="white">身体指标</cl-text>
				<cl-icon name="more-vertical" color="white" :size="20"></cl-icon>
			</view>
		</cl-topbar>

		<view class="p-3">
			<!-- 指标切换 -->
			<view class="mb-6">
				<cl-row :gutter="12">
					<cl-col :span="12" v-for="(item, index) in metricItems" :key="index">
						<view
							class="metric-card h-12 mb-3 rounded-lg flex flex-row items-center justify-between px-4"
							:class="{
								'metric-card--active': activeMetric == item.value,
								'metric-card--inactive': activeMetric != item.value
							}"
							@tap="selectMetric(item.value)"
						>
							<cl-text
								:size="14"
								:color="activeMetric == item.value ? 'primary' : 'white'"
							>
								{{ item.label }}
							</cl-text>
							<cl-svg
								v-if="activeMetric == item.value"
								:src="item.activeIconPath"
								class="w-6 h-6"
							></cl-svg>
							<cl-svg v-else :src="item.iconPath" class="w-6 h-6"></cl-svg>
						</view>
					</cl-col>
				</cl-row>
			</view>

			<!-- 当前数据和正常范围 -->
			<view class="flex flex-row justify-between mb-6">
				<view>
					<cl-text :size="14" color="rgba(255,255,255,0.6)" :pt="{ className: 'mb-1' }"
						>当前数据</cl-text
					>
					<cl-text :size="24" color="white" :pt="{ className: 'font-bold opacity-70' }">{{
						currentData
					}}</cl-text>
				</view>
				<view>
					<cl-text :size="14" color="rgba(255,255,255,0.6)" :pt="{ className: 'mb-1' }"
						>正常范围</cl-text
					>
					<cl-text :size="24" color="white" :pt="{ className: 'font-bold opacity-70' }">{{
						normalRange
					}}</cl-text>
				</view>
			</view>

			<!-- 趋势图表 -->
			<Chart :option="chartOption" :height="200" :showFooter="false"></Chart>

			<!-- 时间范围选择 -->
			<cl-tabs
				v-model="activeTimeRange"
				:list="timeRanges"
				fill
				showSlider
				:pt="{
					className: 'mb-6 !bg-[#1C1C1E] rounded-lg',
					slider: { className: '!bg-[#49494B]' }
				}"
				@change="selectTimeRange"
			></cl-tabs>

			<!-- 数据更新时间 -->
			<view class="mb-3">
				<cl-text :size="12" color="rgba(255,255,255,0.6)">
					数据更新于 {{ updateTime }}
				</cl-text>
			</view>

			<!-- 分析建议 -->
			<view class="p-3">
				<cl-text :size="14" color="rgba(255,255,255,0.75)">{{ analysisText }}</cl-text>
			</view>
		</view>
	</cl-page>
</template>

<script lang="ts" setup>
import { isMp, dayUts, useStore, getDateRange } from "@/.cool";
import { metrics } from "@/.cool/store/metrics";
import { ref, computed, onMounted, watch } from "vue";
import type { MetricItem } from "./types";
import type { ClTabsItem } from "@/uni_modules/cool-ui";
// @ts-ignore
import Chart from "./components/chart.uvue";

const { device, realtime } = useStore();

interface Props {
	metric: string;
}

const props = withDefaults(defineProps<Props>(), {
	metric: "heartRate"
});

const activeMetric = ref<string>(props.metric);

const metricItems: MetricItem[] = [
	{
		label: "心率",
		value: "heartRate",
		iconPath: "/static/icon/health/heart-rate.svg",
		activeIconPath: "/static/icon/health/heart-rate-active.svg"
	},
	{
		label: "静息心率",
		value: "restingHeartRate",
		iconPath: "/static/icon/health/heart-rate.svg",
		activeIconPath: "/static/icon/health/heart-rate-active.svg"
	},
	{
		label: "血氧",
		value: "bloodOxygen",
		iconPath: "/static/icon/health/spo2.svg",
		activeIconPath: "/static/icon/health/spo2-active.svg"
	},
	{
		label: "心率变异性",
		value: "hrv",
		iconPath: "/static/icon/health/hrv.svg",
		activeIconPath: "/static/icon/health/hrv-active.svg"
	}
];

const timeRanges = ref<ClTabsItem[]>([
	{ label: "7天", value: "7d" },
	{ label: "30天", value: "30d" },
	{ label: "60天", value: "60d" }
]);

const activeTimeRange = ref<string>("7d");

const currentData = computed(() => {
	const realtimeValues = realtime.healthCardValues.value;
	if (activeMetric.value == "heartRate" && realtimeValues.heartRate != null) {
		return `${realtimeValues.heartRate}bpm`;
	}
	if (activeMetric.value == "restingHeartRate" && realtimeValues.restingHeartRate != null) {
		return `${realtimeValues.restingHeartRate}bpm`;
	}
	if (activeMetric.value == "bloodOxygen" && realtimeValues.oxygen != null) {
		return `${realtimeValues.oxygen.toFixed(1)}%`;
	}
	if (activeMetric.value == "hrv" && realtimeValues.hrv != null) {
		return `${realtimeValues.hrv}ms`;
	}
	return "-";
});
const normalRange = computed(() => metrics.normalRange.value);
const updateTime = computed(() => metrics.updateTime.value);
const analysisText = computed(() => metrics.analysisText.value);
const trendDates = computed(() => metrics.trendDates.value ?? []);
const trendValues = computed(() => metrics.trendValues.value ?? []);

function getDaysFromOption(option: string): number {
	if (option == "7d") {
		return 7;
	}
	if (option == "30d") {
		return 30;
	}
	if (option == "60d") {
		return 60;
	}
	return 7;
}

async function fetchMetricsData() {
	const deviceId = device.boundDeviceId;
	if (deviceId == null || deviceId == "") {
		console.log("设备未连接，跳过获取身体指标数据");
		return;
	}
	const days = getDaysFromOption(activeTimeRange.value);
	const { startDate, endDate } = getDateRange(days);
	try {
		await metrics.fetchMetrics(deviceId, activeMetric.value, startDate, endDate);
	} catch (err) {
		console.error("获取身体指标失败:", err);
	}
}

const chartOption = computed(() => {
	let option: UTSJSONObject = {
		title: {
			show: false
		},
		tooltip: {
			trigger: "axis",
			textStyle: {
				color: "#fff"
			}
		},
		grid: {
			left: 0,
			right: 0,
			top: 0,
			bottom: 30,
			containLabel: true
		},
		xAxis: {
			type: "category",
			data: trendDates.value,
			axisLabel: {
				color: "rgba(255,255,255,0.6)"
			},
			axisLine: {
				lineStyle: {
					color: "rgba(255,255,255,0.2)"
				}
			}
		},
		yAxis: {
			type: "value",
			axisLine: {
				show: false
			},
			axisLabel: {
				show: false
			},
			splitLine: {
				show: false
			}
		},
		series: [
			{
				name: "当前值",
				type: "line",
				data: trendValues.value,
				itemStyle: {
					color: "#D2FF5C"
				},
				lineStyle: {
					width: 2
				},
				areaStyle: {
					color: {
						type: "linear",
						x: 0,
						y: 0,
						x2: 0,
						y2: 1,
						colorStops: [
							{
								offset: 0,
								color: "rgba(210, 255, 92, 0.3)"
							},
							{
								offset: 1,
								color: "rgba(210, 255, 92, 0)"
							}
						]
					}
				}
			}
		]
	};
	return JSON.stringify(option);
});

function selectMetric(value: string) {
	activeMetric.value = value;
}

function selectTimeRange(value: string) {
	activeTimeRange.value = value;
}

function goBack() {
	uni.navigateBack();
}

onMounted(() => {
	fetchMetricsData();
});

watch(
	activeMetric,
	() => {
		fetchMetricsData();
	},
	{ immediate: false }
);

watch(
	activeTimeRange,
	() => {
		fetchMetricsData();
	},
	{ immediate: false }
);
</script>

<style lang="scss" scoped>
.metric-card--active {
	background-color: rgba(210, 255, 92, 0.2);
}

.metric-card--inactive {
	background-color: rgba(255, 255, 255, 0.1);
}
</style>
