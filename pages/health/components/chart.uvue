<template>
	<view class="w-full mb-6">
		<view class="flex flex-row justify-between items-center">
			<cl-text v-if="title" :size="16" color="white" :pt="{ className: 'font-bold mb-3' }">
				{{ title }}
			</cl-text>
			<slot v-if="showTool" name="tool">
				<cl-tabs
					v-model="selectedDays"
					:list="timeRanges"
					fill
					showSlider
					:height="32"
					:pt="{
						className: 'w-1/2 min-w-40 !bg-[#1C1C1E] !rounded-full',
						text: { className: 'text-xs' },
						slider: { className: '!bg-[#49494B] !rounded-full' }
					}"
					@change="selectDays"
				></cl-tabs>
			</slot>
		</view>

		<view class="w-full" :style="{ height: (height ?? 0) + 'px' }">
			<l-echart ref="chartRef" @finished="initChart"></l-echart>
		</view>

		<view v-if="showFooter" class="flex flex-row justify-between mt-3 px-1">
			<view class="flex flex-col items-center flex-1">
				<cl-text :size="14" color="rgba(255,255,255,0.6)">平均</cl-text>
				<cl-text :size="20" color="white" :pt="{ className: 'font-bold opacity-70' }">
					{{ statsAverageText }}
				</cl-text>
			</view>
			<view class="flex flex-col items-center flex-1">
				<cl-text :size="14" color="rgba(255,255,255,0.6)">最高</cl-text>
				<cl-text :size="20" color="white" :pt="{ className: 'font-bold opacity-70' }">
					{{ statsMaxText }}
				</cl-text>
				<cl-text
					:size="12"
					color="rgba(255,255,255,0.4)"
					v-if="isValidIndex(statsMaxIndex)"
				>
					{{ xAxisData[statsMaxIndex] }}
				</cl-text>
			</view>
			<view class="flex flex-col items-center flex-1">
				<cl-text :size="14" color="rgba(255,255,255,0.6)">最低</cl-text>
				<cl-text :size="20" color="white" :pt="{ className: 'font-bold opacity-70' }">
					{{ statsMinText }}
				</cl-text>
				<cl-text
					:size="12"
					color="rgba(255,255,255,0.4)"
					v-if="isValidIndex(statsMinIndex)"
				>
					{{ xAxisData[statsMinIndex] }}
				</cl-text>
			</view>
		</view>
	</view>
</template>

<script lang="ts" setup>
import { ref, computed, watch } from "vue";
import { assign } from "@/.cool";
import type { ChartProps } from "../types/chart";
import type { ClTabsItem } from "@/uni_modules/cool-ui";

const props = withDefaults(defineProps<ChartProps>(), {
	showFooter: true,
	showTool: false
});

const emit = defineEmits(["days-change"]);

// 时间范围选项
const timeRanges = ref<ClTabsItem[]>([
	{ label: "7天", value: "7d" },
	{ label: "14天", value: "14d" },
	{ label: "30天", value: "30d" }
]);

// 选中的天数
const selectedDays = ref<string>("7d");

// 选择天数
function selectDays(value: string) {
	selectedDays.value = value;
	emit("days-change", value);
}

//@ts-ignore
const chartRef = ref<LEchartComponentPublicInstance | null>(null);

const echarts = null;

const optionObj = computed((): UTSJSONObject => {
	let option = {} as UTSJSONObject;
	const optionData = props.optionData;
	const optionString = props.option;
	if (optionData != null) {
		option = optionData;
	} else if (optionString != null && optionString !== "") {
		option = JSON.parse(optionString) as UTSJSONObject;
	}

	const tooltip = props.tooltip;
	if (tooltip != null) {
		const baseTooltip = (option["tooltip"] as UTSJSONObject | null) ?? ({} as UTSJSONObject);
		option["tooltip"] = assign(baseTooltip, tooltip);
	}

	const tooltipFormatter = props.tooltipFormatter;
	if (tooltipFormatter != null && tooltipFormatter !== "") {
		const baseTooltip = (option["tooltip"] as UTSJSONObject | null) ?? ({} as UTSJSONObject);
		baseTooltip["formatter"] = tooltipFormatter;
		option["tooltip"] = baseTooltip;
	}

	return option;
});

const xAxisData = computed((): string[] => {
	const opt = optionObj.value;
	const xAxis = opt["xAxis"] as UTSJSONObject | null;
	if (xAxis != null) {
		const data = xAxis["data"] as string[] | null;
		if (data != null) return data;
	}
	return [];
});

const primarySeriesData = computed((): any[] => {
	const opt = optionObj.value;
	const seriesArr = opt["series"] as UTSJSONObject[] | null;
	if (seriesArr == null || seriesArr.length == 0) {
		return [] as any[];
	}
	const series = seriesArr[0];
	const rawData = series["data"] as any[] | null;
	return rawData != null ? rawData : ([] as any[]);
});

function getNumberValue(item: any): number | null {
	if (typeof item == "number" && !isNaN(item)) {
		return item as number;
	}
	if (item != null && typeof item == "object") {
		const obj = item as UTSJSONObject;
		const value = obj["value"];
		if (typeof value == "number" && !isNaN(value)) {
			return value as number;
		}
	}
	return null;
}

const statsAverageText = computed((): string => {
	const data = primarySeriesData.value;
	let sum = 0;
	let count = 0;

	data.forEach((item: any) => {
		const value = getNumberValue(item);
		if (value != null) {
			sum += value;
			count++;
		}
	});

	if (count == 0) return "--";
	return (sum / count).toFixed(0);
});

const statsMaxIndex = computed((): number => {
	const data = primarySeriesData.value;
	let max = 0;
	let maxIndex = -1;

	data.forEach((item: any, index: number) => {
		const value = getNumberValue(item);
		if (value != null && (maxIndex < 0 || value > max)) {
			max = value;
			maxIndex = index;
		}
	});

	return maxIndex;
});

const statsMinIndex = computed((): number => {
	const data = primarySeriesData.value;
	let min = 0;
	let minIndex = -1;

	data.forEach((item: any, index: number) => {
		const value = getNumberValue(item);
		if (value != null && (minIndex < 0 || value < min)) {
			min = value;
			minIndex = index;
		}
	});

	return minIndex;
});

const statsMaxText = computed((): string => {
	if (statsMaxIndex.value < 0) return "--";
	const value = getNumberValue(primarySeriesData.value[statsMaxIndex.value]);
	return value == null ? "--" : value.toFixed(0);
});

const statsMinText = computed((): string => {
	if (statsMinIndex.value < 0) return "--";
	const value = getNumberValue(primarySeriesData.value[statsMinIndex.value]);
	return value == null ? "--" : value.toFixed(0);
});

function isValidIndex(index: number): boolean {
	return xAxisData.value.length > 0 && index >= 0 && index < xAxisData.value.length;
}

async function initChart() {
	if (chartRef.value == null) return;
	const chart = await chartRef.value!.init(echarts);
	chart.setOption(optionObj.value);
}

function updateChart() {
	if (chartRef.value == null) return;
	chartRef.value?.setOption(optionObj.value);
}

watch(optionObj, () => {
	updateChart();
});
</script>

<style lang="scss" scoped></style>
