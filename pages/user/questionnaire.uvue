<template>
	<cl-page>
		<view v-if="loading" class="flex items-center justify-center" style="height: 300px">
			<cl-text>加载中...</cl-text>
		</view>

		<template v-else>
			<view v-if="currentStep === 1" class="flex px-4">
				<view
					v-for="(item, index) in userTypes"
					:key="index"
					class="option-card mb-3"
					@click="selectUserType(item.value)"
				>
					<cl-text :size="16">{{ item.label }}</cl-text>
					<view v-if="selectedUserType === item.value">
						<cl-icon name="checkbox-circle-line" color="primary" :size="24"></cl-icon>
					</view>
				</view>
			</view>

			<view v-else-if="currentStep === 2" class="flex px-4">
				<view v-for="(question, qIndex) in questions" :key="qIndex" class="question-card">
					<cl-text class="question-text">{{ question.text }}</cl-text>
					<cl-radio
						v-for="(option, oIndex) in question.options"
						:key="oIndex"
						v-model="question.selected"
						:value="option.value"
						:pt="{
							className: 'my-2'
						}"
					>
						{{ option.label }}
					</cl-radio>
				</view>
			</view>
		</template>

		<cl-footer :pt="{}">
			<cl-button
				v-if="currentStep === 1"
				type="primary"
				size="large"
				rounded
				@click="nextStep"
				:disabled="selectedUserType === ''"
			>
				下一步
			</cl-button>
			<cl-button
				v-else-if="currentStep === 2"
				type="primary"
				size="large"
				rounded
				@click="submitQuestionnaire"
			>
				提交问卷
			</cl-button>
		</cl-footer>
	</cl-page>
</template>

<script lang="ts" setup>
import { getQuestionnaireApi, parse, submitQuestionnaireApi } from "@/.cool";
import { useUi } from "@/uni_modules/cool-ui";
import { ref, reactive } from "vue";

import type {
	QuestionOption,
	UserType,
	Answer,
	SubmitRequest,
	Questionnaire,
	Question
} from "@/.cool";

type QuestionSelect = {
	field: string;
	text: string;
	options: QuestionOption[];
	selected: string;
};

const ui = useUi();
const currentStep = ref(1);
const userTypes = ref<UserType[]>([]);
const selectedUserType = ref<string>("");
const questions = reactive<QuestionSelect[]>([]);
const loading = ref(false);
const submitting = ref(false);

function parseQuestionnaire(data: any): Questionnaire | null {
	if (data == null) {
		return null;
	}

	return parse<Questionnaire>(data);
}

function setUserTypes(list: UserType[]): void {
	const nextList: UserType[] = [];
	for (let i = 0; i < list.length; i++) {
		const item: UserType = {
			label: list[i].label,
			value: list[i].value
		};
		nextList.push(item);
	}
	userTypes.value = nextList;
}

/** 把题列表展开为 QuestionSelect（绑定 selected 默认值） */
function expandQuestions(list: Question[]): QuestionSelect[] {
	const out: QuestionSelect[] = [];
	for (let i = 0; i < list.length; i++) {
		const q = list[i];
		const firstOption = q.options.length > 0 ? q.options[0].value : "";
		const item: QuestionSelect = {
			field: q.field ?? "",
			text: q.text,
			options: q.options,
			selected: firstOption
		};
		out.push(item);
	}
	return out;
}

const loadQuestionnaire = function () {
	loading.value = true;

	getQuestionnaireApi()
		.then((data) => {
			if (data != null) {
				const typedData = parseQuestionnaire(data);
				if (typedData != null) {
					setUserTypes(typedData.userTypes);
					questions.splice(0, questions.length);
					const list = expandQuestions(typedData.questions);
					for (let i = 0; i < list.length; i++) {
						questions.push(list[i]);
					}
				}
			}
		})
		.catch((err) => {
			console.error("加载问卷失败:", err);
			ui.showToast({ message: "问卷加载失败" });
		})
		.finally(() => {
			loading.value = false;
		});
};

const selectUserType = function (value: string): void {
	selectedUserType.value = value;
};

const nextStep = function (): void {
	if (selectedUserType.value !== "") {
		currentStep.value = 2;
	}
};

const submitQuestionnaire = function (): void {
	submitting.value = true;

	const answers: Answer[] = [];
	for (let i = 0; i < questions.length; i++) {
		const q = questions[i];
		const answer: Answer = {
			question: q.text,
			selected: q.selected
		};
		answers.push(answer);
	}

	const data: SubmitRequest = {
		userType: selectedUserType.value,
		answers
	};

	submitQuestionnaireApi(data)
		.then(() => {
			uni.redirectTo({
				url: "/pages/device/index"
			});
		})
		.catch((err) => {
			console.error("提交问卷失败:", err);
			ui.showToast({ message: "问卷提交失败" });
		})
		.finally(() => {
			submitting.value = false;
		});
};

loadQuestionnaire();
</script>

<style lang="scss" scoped>
.header {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 20px 0;
	height: 60px;
}

.title {
	font-size: 18px;
	font-weight: bold;
	color: #fff;
}

.content {
	flex: 1;
	padding: 20px;
}

.option-card {
	background-color: #333;
	border-radius: 12px;
	padding: 20px;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	transition: all 0.3s ease;
}

.question-card {
	background-color: #333;
	border-radius: 12px;
	padding: 20px;
	margin-bottom: 16px;
}

.question-text {
	font-size: 14px;
	color: #fff;
	line-height: 1.4;
}
</style>
