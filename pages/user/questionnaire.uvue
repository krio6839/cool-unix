<template>
	<cl-page>
		<!-- 问卷内容 -->
		<!-- 第一页：用户类型选择 -->
		<view v-if="currentStep === 1" class="flex px-4">
			<view
				v-for="(item, index) in userTypes"
				:key="index"
				class="option-card mb-3"
				@click="selectUserType(item.value)"
			>
				<cl-text :size="16">{{ item.label }}</cl-text>
				<view v-if="selectedUserType === item.value">
					<cl-icon name="checkbox-circle-line" color="primary" :size="24"></cl-icon>
				</view>
			</view>
		</view>

		<!-- 第二页：详细问卷 -->
		<view v-else-if="currentStep === 2" class="flex px-4">
			<view v-for="(question, qIndex) in questions" :key="qIndex" class="question-card">
				<cl-text class="question-text">{{ question.text }}</cl-text>
				<cl-radio
					v-for="(option, oIndex) in question.options"
					:key="oIndex"
					v-model="question.selected"
					:value="option.value"
					:pt="{
						className: 'my-2'
					}"
				>
					{{ option.label }}
				</cl-radio>
			</view>
		</view>

		<!-- 底部按钮 -->
		<cl-footer :pt="{}">
			<cl-button
				v-if="currentStep === 1"
				type="primary"
				size="large"
				rounded
				@click="nextStep"
				:disabled="selectedUserType === ''"
			>
				下一步
			</cl-button>
			<cl-button
				v-else-if="currentStep === 2"
				type="primary"
				size="large"
				rounded
				@click="submitQuestionnaire"
			>
				提交问卷
			</cl-button>
		</cl-footer>
	</cl-page>
</template>

<script lang="ts" setup>
import { parseClass, router } from "@/.cool";
import { ref, reactive } from "vue";

// 类型定义
type UserType = {
	label: string;
	value: string;
};

type QuestionOption = {
	label: string;
	value: string;
};

type Question = {
	text: string;
	options: QuestionOption[];
	selected: string;
};

// 步骤控制
const currentStep = ref(1);

// 用户类型选项
const userTypes: UserType[] = [
	{ label: "新手爱好者", value: "beginner" },
	{ label: "严肃运动者", value: "serious" },
	{ label: "职业运动员", value: "professional" }
];

// 选中的用户类型
const selectedUserType = ref<string>("");

// 问卷问题
const questions = reactive<Question[]>([
	{
		text: "01.前几天连续训练负荷较大，HRV较低但储能情况良好",
		options: [
			{ label: "是", value: "yes" },
			{ label: "否", value: "no" }
		],
		selected: "yes"
	},
	{
		text: "01.前几天连续训练负荷较大，HRV较低但储能情况良好",
		options: [
			{ label: "预计明天HRV上升达到超量恢复黄金窗口", value: "window" },
			{ label: "超量恢复黄金窗口", value: "window2" },
			{ label: "建议降低训练量，注意恢复调整", value: "reduce" },
			{ label: "注意恢复调整", value: "adjust" }
		],
		selected: "window"
	},
	{
		text: "03.前几天连续训练负荷较大，HRV较低但储能情况良好",
		options: [
			{ label: "是", value: "yes" },
			{ label: "否", value: "no" }
		],
		selected: "yes"
	},
	{
		text: "04.前几天连续训练负荷较大，HRV较低但储能情况良好",
		options: [
			{ label: "是", value: "yes" },
			{ label: "否", value: "no" }
		],
		selected: "yes"
	}
]);

// 选择用户类型
const selectUserType = (value: string): void => {
	selectedUserType.value = value;
};

// 下一步
const nextStep = (): void => {
	if (selectedUserType.value !== "") {
		currentStep.value = 2;
	}
};

type Answer = {
	question: string;
	selected: string;
};

// 问卷结果类型
type QuestionnaireResult = {
	userType: string;
	answers: Answer[];
};

// 提交问卷
const submitQuestionnaire = (): void => {
	// 收集问卷数据
	const answers: Answer[] = questions.map(
		(q: Question): Answer => ({
			question: q.text,
			selected: q.selected
		})
	);
	const questionnaireData: QuestionnaireResult = {
		userType: selectedUserType.value,
		answers: answers
	};

	// 这里可以添加提交逻辑，比如调用API
	console.log("问卷数据:", questionnaireData);

	// 提交后跳转到其他页面
	uni.redirectTo({
		url: "/pages/device/index"
	});
};
</script>

<style lang="scss" scoped>
.header {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 20px 0;
	height: 60px;
}

.title {
	font-size: 18px;
	font-weight: bold;
	color: #fff;
}

.content {
	flex: 1;
	padding: 20px;
	overflow-y: auto;
}

.option-card {
	background-color: #333;
	border-radius: 12px;
	padding: 20px;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	transition: all 0.3s ease;
}

.question-card {
	background-color: #333;
	border-radius: 12px;
	padding: 20px;
	margin-bottom: 16px;
}

.question-text {
	font-size: 14px;
	color: #fff;
	margin-bottom: 16px;
	line-height: 1.4;
}
</style>
