<template>
	<view class="w-full max-w-[400px]">
		<view class="mb-4 w-full">
			<cl-input
				v-model="form.phone"
				:placeholder="t('输入手机号')"
				:border="false"
				:pt="{
					className: '!h-12 login-input'
				}"
			>
				<template #prepend>
					<cl-svg
						src="/static/icon/login/phone.svg"
						class="h-5 w-5"
						color="none"
					></cl-svg>
					<cl-text class="mx-2">手机号</cl-text>
				</template>
			</cl-input>
		</view>

		<view class="mb-6 relative w-full">
			<cl-input
				v-model="form.smsCode"
				:placeholder="t('输入验证码')"
				placeholderClass="text-white"
				:border="false"
				:pt="{
					className: '!h-12 login-input'
				}"
			>
				<template #prepend>
					<cl-svg src="/static/icon/login/code.svg" class="h-5 w-5"></cl-svg>
					<cl-text class="mx-2">验证码</cl-text>
				</template>
				<template #append>
					<cl-text color="primary" :pt="{ className: 'font-bold' }" @tap="getSmsCode">{{
						t("获取验证码")
					}}</cl-text>
				</template>
			</cl-input>
		</view>

		<cl-button
			:pt="{
				className: '!h-12'
			}"
			type="primary"
			color="#000"
			rounded
			:disabled="disabled"
			:loading="loading"
			@tap="handleLogin"
		>
			{{ t("确认") }}
		</cl-button>

		<cl-button
			:pt="{
				className: 'login-button-switch'
			}"
			rounded
			@tap="switchMode('password')"
		>
			{{ t("账号密码登录") }}
		</cl-button>
	</view>
</template>

<script setup lang="ts">
import { t, useRefs } from "@/.cool";
import { computed, inject, reactive, ref, type PropType } from "vue";
import type { LoginForm } from "../../types";
import { useUi } from "@/uni_modules/cool-ui";
import type { Token } from "@/.cool/store/user";

const props = defineProps({
	form: {
		type: Object as PropType<LoginForm>,
		default: () => ({})
	}
});

const emit = defineEmits(["success", "switch"]);

const ui = useUi();
const refs = useRefs();

// 是否同意
const isAgree = inject("isAgree") as () => boolean;

// 模拟登录数据
const mockToken: UTSJSONObject = {
	token: "mock_token_123456",
	expire: 3600,
	refreshToken: "mock_refresh_token_123456",
	refreshExpire: 86400
};

// 是否显示验证码
const showCode = ref(false);

// 是否加载中
const loading = ref(false);

// 是否禁用
const disabled = computed(() => {
	return props.form.phone == "" || props.form.smsCode == "";
});

async function handleLogin() {
	if (!isAgree()) {
		return;
	}

	const { phone, smsCode } = props.form;

	loading.value = true;

	// 使用模拟数据
	emit("success", mockToken);

	loading.value = false;
}

function switchMode(mode: "password") {
	emit("switch", mode);
}

function getSmsCode() {
	if (props.form.phone == "") {
		ui.showToast({ message: t("请输入手机号") });
		return;
	}
	// 模拟获取验证码
	ui.showToast({ message: t("验证码已发送") });
}
</script>
