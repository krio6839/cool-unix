import { Int } from 'Swift'
import { AndroidCompatBlueApi, BlueBroadcastInfo, BlueChannelBundle, BlueCharacteristic, BlueEnvelope, BlueFlags, BlueFleetApi, BluePacketPlan, BluePeerInfo, BlueServiceShape, BlueSweepNode, BlueSweepPlan, CompatApiPacket, CompatCharacteristic, CompatCharacteristicFlags, CompatScanFrame, CompatScanResult, CompatService, CompatSweepPlan, CompatUuidBundle, CompatWriteTask, buildBlueEnvelope, buildCompatPacket } from '../interface.uts'

class BlueFleetHost {
	private nativeDock = LQJBleHarbor.shared
	private adapterOn: boolean = false
	private connected: boolean = false
	private currentPeerIdValue: string = ''
	private pendingPeerIdValue: string = ''
	private activeServiceValue: string = ''
	private activeNotifyValue: string = ''
	private activeWriteValue: string = ''
	private attachTimeoutValue: number = 15000
	private retryGapValue: number = 12000
	private sweepTimerId: number = -1
	private debugEnabled: boolean = false
	private dispatchLabel: string = 'com.laoqianjunzi.blue.dispatch'
	private allowNameless: boolean = true
	private sweepKeyword: string = ''
	private bundleList: BlueChannelBundle[] = [] as BlueChannelBundle[]
	private sweepSeenMap: Map<string, boolean> = new Map<string, boolean>()
	private adapterWatcher: ((packet: BlueEnvelope) => void) | null = null
	private sweepNodeWatcher: ((packet: BlueEnvelope) => void) | null = null
	private sweepFrameWatcher: ((packet: BlueEnvelope) => void) | null = null
	private attachWatcher: ((packet: BlueEnvelope) => void) | null = null
	private streamWatcher: ((packet: BlueEnvelope) => void) | null = null

	constructor() {
		this.nativeDock.setDispatchLabel(this.dispatchLabel)
		this.nativeDock.prime((ready: boolean) => {
			this.adapterOn = ready
			if (this.adapterWatcher != null) {
				this.adapterWatcher(this.ok('蓝牙状态已刷新', ready))
			}
		})
		this.nativeDock.setStateFeed((ready: boolean) => {
			this.adapterOn = ready
			if (!ready) {
				this.connected = false
			}
			if (this.adapterWatcher != null) {
				this.adapterWatcher(this.ok('蓝牙状态变化', ready))
			}
		})
		this.nativeDock.setLinkFeed((online: boolean, peerId: string) => {
			this.connected = online
			this.currentPeerIdValue = online ? peerId : ''
			if (!online && this.attachWatcher != null) {
				this.attachWatcher(this.fail(10001, '蓝牙连接已断开', peerId))
			}
		})
		this.nativeDock.setValueFeed((hexText: string) => {
			if (this.streamWatcher != null) {
				this.streamWatcher(this.ok('收到蓝牙数据', this.hexToNumberList(hexText)))
			}
		})
	}

	private ok(detail: string, payload: any | null = null): BlueEnvelope {
		return buildBlueEnvelope(0, detail, payload)
	}

	private fail(code: number, detail: string, payload: any | null = null): BlueEnvelope {
		return buildBlueEnvelope(code, detail, payload)
	}

	private trace(message: string, payload: any | null = null): void {
		if (this.debugEnabled) {
			console.log('[laoqianjunzi-blue][ios]', message, payload)
		}
	}

	private stopSweepTimer(): void {
		if (this.sweepTimerId != -1) {
			clearTimeout(this.sweepTimerId)
			this.sweepTimerId = -1
		}
	}

	private parseJSON(raw: string): any {
		if (raw.length == 0) {
			return null
		}
		return JSON.parse(raw)
	}

	private toStringOrNull(value: any): string | null {
		if (value == null) {
			return null
		}
		const text = String(value)
		return text.length > 0 ? text : null
	}

	private toNumberOrNull(value: any): number | null {
		if (value == null) {
			return null
		}
		return Number(value)
	}

	private toBoolOrNull(value: any): boolean | null {
		if (value == null) {
			return null
		}
		return value === true
	}

	private hexToNumberList(hexPayload: string): number[] {
		let clean = hexPayload.replace(/\s/g, '').toUpperCase()
		if (clean.length % 2 != 0) {
			clean = '0' + clean
		}
		const result: number[] = [] as number[]
		for (let i = 0; i < clean.length; i += 2) {
			result.push(parseInt(clean.substring(i, i + 2), 16))
		}
		return result
	}

	private bytesToHex(bytes: number[]): string {
		let result = ''
		for (let i = 0; i < bytes.length; i++) {
			result += bytes[i].toString(16).padStart(2, '0').toUpperCase()
			if (i < bytes.length - 1) {
				result += ' '
			}
		}
		return result
	}

	private packetHexFromPlan(plan: BluePacketPlan): string {
		if (plan.hexPayload != null) {
			return plan.hexPayload
		}
		if (plan.bytePayload != null) {
			return this.bytesToHex(plan.bytePayload)
		}
		return ''
	}

	private buildAdvertiseInfo(raw: any): BlueBroadcastInfo {
		return {
			deviceName: this.toStringOrNull(raw != null ? raw.deviceName : null),
			txPowerLevel: this.toNumberOrNull(raw != null ? raw.txPowerLevel : null),
			bytes: this.toStringOrNull(raw != null ? raw.bytes : null),
			serviceData: this.toStringOrNull(raw != null ? raw.serviceData : null),
			serviceUuids: this.toStringOrNull(raw != null ? raw.serviceUuids : null),
			advertiseFlags: this.toNumberOrNull(raw != null ? raw.advertiseFlags : null),
			manufacturerSpecificData: this.toStringOrNull(raw != null ? raw.manufacturerSpecificData : null),
			serviceSolicitationUuids: this.toStringOrNull(raw != null ? raw.serviceSolicitationUuids : null)
		} as BlueBroadcastInfo
	}

	private buildPeerInfo(raw: any): BluePeerInfo {
		return {
			name: this.toStringOrNull(raw != null ? raw.name : null),
			alias: this.toStringOrNull(raw != null ? raw.alias : null),
			bondState: this.toNumberOrNull(raw != null ? raw.bondState : null),
			deviceKind: this.toNumberOrNull(raw != null ? raw.deviceKind : null),
			address: this.toStringOrNull(raw != null ? raw.address : null) ?? ''
		} as BluePeerInfo
	}

	private buildSweepNode(raw: any): BlueSweepNode {
		return {
			connectType: this.toNumberOrNull(raw != null ? raw.connectType : null),
			rssi: this.toNumberOrNull(raw != null ? raw.rssi : null),
			isLegacy: this.toBoolOrNull(raw != null ? raw.isLegacy : null),
			advertisingSid: this.toNumberOrNull(raw != null ? raw.advertisingSid : null),
			dataStatus: this.toNumberOrNull(raw != null ? raw.dataStatus : null),
			isConnectable: this.toBoolOrNull(raw != null ? raw.isConnectable : null),
			periodicAdvertisingInterval: this.toNumberOrNull(raw != null ? raw.periodicAdvertisingInterval : null),
			primaryPhy: this.toNumberOrNull(raw != null ? raw.primaryPhy : null),
			secondaryPhy: this.toNumberOrNull(raw != null ? raw.secondaryPhy : null),
			timestampNanos: this.toNumberOrNull(raw != null ? raw.timestampNanos : null),
			advertiseFrame: this.buildAdvertiseInfo(raw != null ? raw.advertiseFrame : null),
			peer: this.buildPeerInfo(raw != null ? raw.peer : null)
		} as BlueSweepNode
	}

	private buildCharacteristic(raw: any): BlueCharacteristic {
		const flags: BlueFlags = {
			canRead: raw != null && raw.flags != null ? raw.flags.canRead === true : false,
			canWrite: raw != null && raw.flags != null ? raw.flags.canWrite === true : false,
			canNotify: raw != null && raw.flags != null ? raw.flags.canNotify === true : false,
			canIndicate: raw != null && raw.flags != null ? raw.flags.canIndicate === true : false
		} as BlueFlags
		return {
			uuid: this.toStringOrNull(raw != null ? raw.uuid : null) ?? '',
			flagBits: this.toNumberOrNull(raw != null ? raw.flagBits : null) ?? 0,
			flags: flags
		} as BlueCharacteristic
	}

	private buildServiceShapes(rawList: any[]): BlueServiceShape[] {
		const list: BlueServiceShape[] = [] as BlueServiceShape[]
		for (let i = 0; i < rawList.length; i++) {
			const raw = rawList[i]
			const rawChars = raw != null && raw.characteristics != null ? raw.characteristics as any[] : [] as any[]
			const chars: BlueCharacteristic[] = [] as BlueCharacteristic[]
			for (let j = 0; j < rawChars.length; j++) {
				chars.push(this.buildCharacteristic(rawChars[j]))
			}
			list.push({
				index: this.toNumberOrNull(raw != null ? raw.index : null) ?? i,
				uuid: this.toStringOrNull(raw != null ? raw.uuid : null) ?? '',
				characteristics: chars
			} as BlueServiceShape)
		}
		return list
	}

	private rebuildBundles(rawList: any[]): void {
		const list: BlueChannelBundle[] = [] as BlueChannelBundle[]
		for (let i = 0; i < rawList.length; i++) {
			const raw = rawList[i]
			list.push({
				serviceId: this.toStringOrNull(raw != null ? raw.serviceId : null) ?? '',
				writeId: this.toStringOrNull(raw != null ? raw.writeId : null) ?? '',
				notifyId: this.toStringOrNull(raw != null ? raw.notifyId : null) ?? ''
			} as BlueChannelBundle)
		}
		this.bundleList = list
	}

	watchAdapterSwitch(callback: (packet: BlueEnvelope) => void): void {
		this.adapterWatcher = callback
		callback(this.ok('已返回当前蓝牙状态', this.adapterReady()))
	}

	requestAdapterWake(callback: (packet: BlueEnvelope) => void): void {
		this.adapterOn = this.nativeDock.bluetoothReady()
		callback(this.adapterOn ? this.ok('蓝牙已经开启', true) : this.fail(10002, 'iOS 不支持在应用内直接拉起蓝牙开关', false))
	}

	adapterReady(): boolean {
		this.adapterOn = this.nativeDock.bluetoothReady()
		return this.adapterOn
	}

	beginSweep(plan: BlueSweepPlan): void {
		this.stopSweep()
		this.sweepSeenMap.clear()
		this.sweepNodeWatcher = plan.onNode != null ? plan.onNode : null
		this.allowNameless = plan.includeNameless !== false
		this.sweepKeyword = plan.nameKeyword != null ? plan.nameKeyword : ''
		if (!this.adapterReady()) {
			if (plan.onNode != null) {
				plan.onNode(this.fail(10002, '蓝牙适配器不可用', null))
			}
			return
		}
		const opened = this.nativeDock.openSweep(this.sweepKeyword, this.allowNameless, (jsonText: string) => {
			const raw = this.parseJSON(jsonText)
			if (raw == null) {
				return
			}
			if (this.sweepFrameWatcher != null) {
				this.sweepFrameWatcher(this.ok('收到广播帧', {
					peerId: this.toStringOrNull(raw.peerId) ?? '',
					alias: this.toStringOrNull(raw.alias),
					rssi: this.toNumberOrNull(raw.rssi) ?? 0,
					packetHex: this.toStringOrNull(raw.packetHex) ?? '',
					vendorHex: this.toStringOrNull(raw.vendorHex)
				}))
			}
			if (this.sweepNodeWatcher == null) {
				return
			}
			const peerId = this.toStringOrNull(raw.peerId) ?? ''
			if (peerId.length == 0 || this.sweepSeenMap.has(peerId)) {
				return
			}
			this.sweepSeenMap.set(peerId, true)
			this.sweepNodeWatcher(this.ok('发现蓝牙设备', this.buildSweepNode(raw.node)))
		})
		if (!opened) {
			if (plan.onNode != null) {
				plan.onNode(this.fail(10000, '启动扫描失败', null))
			}
			return
		}
		const duration = plan.duration != null ? Number(plan.duration) : 10000
		if (duration >= 0) {
			this.sweepTimerId = setTimeout(() => {
				this.stopSweep()
				if (plan.onDone != null) {
					plan.onDone()
				}
			}, duration)
		}
	}

	legacySweep(duration: number, callback: (packet: BlueEnvelope) => void): void {
		this.beginSweep({
			nameKeyword: null,
			duration: duration,
			includeNameless: true,
			onNode: callback,
			onDone: () => {}
		} as BlueSweepPlan)
	}

	watchSweepFrames(callback: (packet: BlueEnvelope) => void): void {
		this.sweepFrameWatcher = callback
	}

	stopSweep(): void {
		this.stopSweepTimer()
		this.nativeDock.haltSweep()
	}

	attach(peerId: string, keepRetry: boolean, callback: (packet: BlueEnvelope) => void): void {
		this.attachWatcher = callback
		this.pendingPeerIdValue = peerId
		if (!this.adapterReady()) {
			callback(this.fail(10002, '蓝牙适配器不可用', null))
			return
		}
		this.nativeDock.link(peerId, keepRetry, this.attachTimeoutValue.toInt(), this.retryGapValue.toInt(), (code: Int, detail: string) => {
			const resultCode = Number.from(code)
			if (resultCode == 0) {
				this.connected = true
				this.currentPeerIdValue = peerId
				callback(this.ok(detail, peerId))
				return
			}
			this.connected = false
			callback(this.fail(resultCode == 10001 ? 10001 : 10000, detail, peerId))
		})
	}

	setAttachTimeout(duration: number): void {
		this.attachTimeoutValue = duration
	}

	setRetryGap(duration: number): void {
		this.retryGapValue = duration
	}

	stopRetry(): void {
		this.nativeDock.stopRetry()
	}

	attached(): boolean {
		this.connected = this.nativeDock.linked()
		return this.connected
	}

	currentPeerId(): string {
		this.currentPeerIdValue = this.nativeDock.linkedPeerId()
		return this.currentPeerIdValue
	}

	pullProfile(callback: (packet: BlueEnvelope) => void): void {
		if (!this.attached()) {
			callback(this.fail(10005, '当前没有已连接设备', null))
			return
		}
		this.nativeDock.inspectProfile((jsonText: string) => {
			const shapes = this.buildServiceShapes(this.parseJSON(jsonText) as any[])
			const bundles = this.parseJSON(this.nativeDock.channelJSON()) as any[]
			this.rebuildBundles(bundles)
			if (this.bundleList.length > 0) {
				this.pickProfile(0)
			}
			callback(this.ok('服务扫描完成', shapes))
		})
	}

	pickProfile(index: number): void {
		if (this.nativeDock.chooseChannel(index.toInt()) && index >= 0 && index < this.bundleList.length) {
			const selected = this.bundleList[index]
			this.activeServiceValue = selected.serviceId
			this.activeNotifyValue = selected.notifyId
			this.activeWriteValue = selected.writeId
		}
	}

	listProfiles(): BlueChannelBundle[] {
		return this.bundleList
	}

	activeServiceId(): string {
		return this.nativeDock.chosenServiceId()
	}

	activeNotifyId(): string {
		return this.nativeDock.chosenNotifyId()
	}

	activeWriteId(): string {
		return this.nativeDock.chosenWriteId()
	}

	pipeValue(serviceId: string, characteristicId: string, enabled: boolean, callback: (packet: BlueEnvelope) => void): void {
		if (!this.attached()) {
			callback(this.fail(10005, '当前没有已连接设备', null))
			return
		}
		if (enabled) {
			this.streamWatcher = callback
		}
		this.nativeDock.toggleNotify(serviceId, characteristicId, enabled, (code: Int, detail: string) => {
			const resultCode = Number.from(code)
			if (!enabled && resultCode == 0) {
				this.streamWatcher = null
			}
			callback(buildBlueEnvelope(resultCode, detail, [] as number[]))
		})
	}

	emitPacket(plan: BluePacketPlan, callback: (packet: BlueEnvelope) => void): void {
		if (!this.attached()) {
			callback(this.fail(10005, '当前没有已连接设备', null))
			return
		}
		const hexText = this.packetHexFromPlan(plan)
		if (hexText.replace(/\s/g, '').length == 0) {
			callback(this.fail(9011003, '待发送数据为空', null))
			return
		}
		const writeMode = plan.writeMode != null ? Number(plan.writeMode) : 0
		this.nativeDock.pushHex(plan.serviceId, plan.characteristicId, hexText, writeMode.toInt(), plan.splitPacket, (code: Int, detail: string) => {
			const resultCode = Number.from(code)
			callback(resultCode == 0 ? this.ok(detail, null) : this.fail(resultCode == 10001 ? 10001 : 10000, detail, null))
		})
	}

	emitBytes(serviceId: string, characteristicId: string, bytes: number[], callback: (packet: BlueEnvelope) => void): void {
		this.emitPacket({
			serviceId: serviceId,
			characteristicId: characteristicId,
			writeMode: 0,
			bytePayload: bytes,
			hexPayload: null,
			splitPacket: false
		} as BluePacketPlan, callback)
	}

	emitBytesWithMode(serviceId: string, characteristicId: string, bytes: number[], writeMode: number, callback: (packet: BlueEnvelope) => void): void {
		this.emitPacket({
			serviceId: serviceId,
			characteristicId: characteristicId,
			writeMode: writeMode,
			bytePayload: bytes,
			hexPayload: null,
			splitPacket: false
		} as BluePacketPlan, callback)
	}

	emitHex(serviceId: string, characteristicId: string, hexPayload: string, callback: (packet: BlueEnvelope) => void): void {
		this.emitPacket({
			serviceId: serviceId,
			characteristicId: characteristicId,
			writeMode: 0,
			bytePayload: null,
			hexPayload: hexPayload,
			splitPacket: false
		} as BluePacketPlan, callback)
	}

	emitHexWithMode(serviceId: string, characteristicId: string, hexPayload: string, writeMode: number, callback: (packet: BlueEnvelope) => void): void {
		this.emitPacket({
			serviceId: serviceId,
			characteristicId: characteristicId,
			writeMode: writeMode,
			bytePayload: null,
			hexPayload: hexPayload,
			splitPacket: false
		} as BluePacketPlan, callback)
	}

	probeSignal(callback: (packet: BlueEnvelope) => void): void {
		if (!this.attached()) {
			callback(this.fail(10005, '当前没有已连接设备', null))
			return
		}
		this.nativeDock.readSignal((code: Int, detail: string, rssi: Int) => {
			const resultCode = Number.from(code)
			callback(resultCode == 0 ? this.ok(detail, Number.from(rssi)) : this.fail(10000, detail, null))
		})
	}

	setTunnelSize(_size: number, callback: (packet: BlueEnvelope) => void): void {
		callback(this.fail(9011001, 'iOS 不支持主动调整 MTU，可通过 preferredPacketSpan 取得当前建议写入长度', this.nativeDock.preferredPacketSpan(0)))
	}

	readOnce(serviceId: string, characteristicId: string, callback: (packet: BlueEnvelope) => void): void {
		if (!this.attached()) {
			callback(this.fail(10005, '当前没有已连接设备', null))
			return
		}
		this.nativeDock.fetchValue(serviceId, characteristicId, (code: Int, detail: string, hexText: string) => {
			const resultCode = Number.from(code)
			callback(resultCode == 0 ? this.ok(detail, this.hexToNumberList(hexText)) : this.fail(10000, detail, null))
		})
	}

	closePipe(): void {
		this.streamWatcher = null
		this.connected = false
		this.currentPeerIdValue = ''
		this.nativeDock.unlink()
	}

	bytesToHexText(bytes: number[]): string {
		return this.bytesToHex(bytes)
	}

	textToHexSeed(text: string, charset: string): string {
		return this.nativeDock.encodeHex(text, charset)
	}

	hexSeedToText(hexPayload: string, charset: string): string {
		return this.nativeDock.decodeHex(hexPayload, charset)
	}

	hasAndroidPermission(_permissionName: string): boolean {
		return false
	}

	askAndroidPermission(_permissionName: string, callback: (granted: boolean) => void): void {
		callback(false)
	}

	askAndroidPermissions(_permissionNames: string[], callback: (granted: boolean) => void): void {
		callback(false)
	}

	verifyHarmonyPeerId(_peerId: string): boolean {
		return false
	}

	requestHarmonyBluetoothAccess(callback: (granted: boolean) => void): void {
		callback(false)
	}

	openAdapterPanel(): void {
		this.trace('iOS 不提供直接跳转蓝牙面板的公共能力', null)
	}

	setDebug(enabled: boolean): void {
		this.debugEnabled = enabled
		this.nativeDock.setVerbose(enabled)
	}

	setDispatchLabel(label: string): void {
		this.dispatchLabel = label
		this.nativeDock.setDispatchLabel(label)
	}
}

export const createBlueFleet = function (): BlueFleetApi {
	return new BlueFleetHost() as BlueFleetApi
}

class IOSCompatBlueHost {
	private fleet: BlueFleetHost = new BlueFleetHost()
	private latestPeerId: string = ''
	private latestServiceId: string = ''
	private latestNotifyId: string = ''
	private latestWriteId: string = ''
	private latestAutoGap: number = 12000
	private latestConnectTimeout: number = 15000
	private latestBundles: CompatUuidBundle[] = [] as CompatUuidBundle[]
	private adapterCallback: ((packet: CompatApiPacket) => void) | null = null
	private scanFrameCallback: ((packet: CompatApiPacket) => void) | null = null

	constructor() {
		this.fleet.watchSweepFrames((packet: BlueEnvelope) => {
			if (this.scanFrameCallback == null) {
				return
			}
			const data = packet.payload as UTSJSONObject | null
			if (data == null) {
				this.scanFrameCallback(buildCompatPacket(10000, packet.detail, ''))
				return
			}
			const frame: CompatScanFrame = {
				mac: data['peerId'] as string,
				rssi: data['rssi'] as number,
				data: data['packetHex'] as string,
				manufacturerData: data['vendorHex'] as string | null,
				name: data['alias'] as string | null
			} as CompatScanFrame
			this.scanFrameCallback(buildCompatPacket(0, '', frame))
		})
	}

	private packetFromBlue(packet: BlueEnvelope): CompatApiPacket {
		return buildCompatPacket(packet.code, packet.detail, packet.payload != null ? packet.payload as any : '')
	}

	private syncSelectedIds(): void {
		this.latestServiceId = this.fleet.activeServiceId()
		this.latestNotifyId = this.fleet.activeNotifyId()
		this.latestWriteId = this.fleet.activeWriteId()
	}

	private syncUuidBundles(): void {
		const rows = this.fleet.listProfiles()
		const list: CompatUuidBundle[] = [] as CompatUuidBundle[]
		for (let i = 0; i < rows.length; i++) {
			list.push({ serviceId: rows[i].serviceId, nuuid: rows[i].notifyId, wuuid: rows[i].writeId } as CompatUuidBundle)
		}
		this.latestBundles = list
		this.syncSelectedIds()
	}

	private normalizeScanNode(packet: BlueEnvelope): CompatApiPacket {
		if (packet.code != 0) {
			return this.packetFromBlue(packet)
		}
		const payload = packet.payload as UTSJSONObject
		const peer = payload['peer'] as UTSJSONObject
		const frame = payload['advertiseFrame'] as UTSJSONObject | null
		const scan: CompatScanResult = {
			connectType: payload['connectType'] as number | null,
			rssi: payload['rssi'] as number | null,
			isLegacy: payload['isLegacy'] as boolean | null,
			advertisingSid: payload['advertisingSid'] as number | null,
			dataStatus: payload['dataStatus'] as number | null,
			isConnectable: payload['isConnectable'] as boolean | null,
			periodicAdvertisingInterval: payload['periodicAdvertisingInterval'] as number | null,
			primaryPhy: payload['primaryPhy'] as number | null,
			secondaryPhy: payload['secondaryPhy'] as number | null,
			timestampNanos: payload['timestampNanos'] as number | null,
			scanRecord: frame == null ? null : {
				deviceName: frame['deviceName'] as string | null,
				txPowerLevel: frame['txPowerLevel'] as number | null,
				bytes: frame['bytes'] as string | null,
				serviceData: frame['serviceData'] as string | null,
				serviceUuids: frame['serviceUuids'] as string | null,
				advertiseFlags: frame['advertiseFlags'] as number | null,
				manufacturerSpecificData: frame['manufacturerSpecificData'] as string | null,
				serviceSolicitationUuids: frame['serviceSolicitationUuids'] as string | null
			},
			device: {
				name: peer['name'] as string | null,
				alias: peer['alias'] as string | null,
				bondState: peer['bondState'] as number | null,
				type: peer['deviceKind'] as number | null,
				address: peer['address'] as string
			} as any,
			deviceName: peer['name'] as string | null
		} as CompatScanResult
		return buildCompatPacket(0, packet.detail, scan)
	}

	private normalizeServices(packet: BlueEnvelope): CompatApiPacket {
		if (packet.code != 0) {
			return this.packetFromBlue(packet)
		}
		const rows = packet.payload as BlueServiceShape[]
		const list: CompatService[] = [] as CompatService[]
		for (let i = 0; i < rows.length; i++) {
			const chars: CompatCharacteristic[] = [] as CompatCharacteristic[]
			for (let j = 0; j < rows[i].characteristics.length; j++) {
				const flags: CompatCharacteristicFlags = {
					READ: rows[i].characteristics[j].flags.canRead,
					WRITE: rows[i].characteristics[j].flags.canWrite,
					NOTIFY: rows[i].characteristics[j].flags.canNotify,
					INDICATE: rows[i].characteristics[j].flags.canIndicate
				} as CompatCharacteristicFlags
				chars.push({ uuid: rows[i].characteristics[j].uuid, properties: flags, propertiesType: rows[i].characteristics[j].flagBits } as CompatCharacteristic)
			}
			list.push({ type: i, uuid: rows[i].uuid, characteristics: chars } as CompatService)
		}
		this.syncUuidBundles()
		return buildCompatPacket(0, packet.detail, list)
	}

	private normalizeReadPacket(packet: BlueEnvelope): CompatApiPacket {
		if (packet.code != 0) {
			return buildCompatPacket(packet.code, packet.detail, [] as number[])
		}
		return buildCompatPacket(0, packet.detail, packet.payload != null ? packet.payload as any : [] as number[])
	}

	private normalizeNotifyPacket(packet: BlueEnvelope, enabled: boolean): CompatApiPacket {
		const payload = packet.payload
		if (payload != null && payload instanceof Array && payload.length > 0) {
			return buildCompatPacket(0, packet.detail, payload)
		}
		if (enabled) {
			return buildCompatPacket(packet.code == 0 ? 1000 : 1001, packet.detail, [] as number[])
		}
		return buildCompatPacket(packet.code, packet.detail, [] as number[])
	}

	setBtConnectTimeout(time: number): void { this.latestConnectTimeout = time; this.fleet.setAttachTimeout(time) }
	setBtAutoConnectTime(time: number): void { this.latestAutoGap = time; this.fleet.setRetryGap(time) }
	setDebugMode(debug: boolean): void { this.fleet.setDebug(debug) }
	setThreadTypeName(name: string): void { this.fleet.setDispatchLabel(name) }
	onBtOpenStateListener(callback: (packet: CompatApiPacket) => void): void { this.adapterCallback = callback; this.fleet.watchAdapterSwitch((packet: BlueEnvelope) => { callback(buildCompatPacket(0, packet.detail, packet.payload != null ? packet.payload as any : false)) }) }
	btListener(): void { if (this.adapterCallback != null) { this.onBtOpenStateListener(this.adapterCallback) } }
	openBtBluetooth(callback: (packet: CompatApiPacket) => void): void { this.fleet.requestAdapterWake((packet: BlueEnvelope) => { callback(buildCompatPacket(packet.code == 0 ? 0 : 1, packet.detail, packet.payload != null ? packet.payload as any : '')) }) }
	readRssi(callback: (packet: CompatApiPacket) => void): void { this.fleet.probeSignal((packet: BlueEnvelope) => { callback(buildCompatPacket(packet.code, 'rssi', packet.payload != null ? packet.payload as any : 0)) }) }
	openBluetooth(on: boolean): void { if (on) { this.fleet.requestAdapterWake((_packet: BlueEnvelope) => {}) } }
	openBluetoothSettings(): void {}
	getSericUUID(): string { return this.latestServiceId }
	getServiceUUID(): string { return this.latestServiceId }
	getNotityUUID(): string { return this.latestNotifyId }
	getWriteUUID(): string { return this.latestWriteId }
	getwriteUUID(): string { return this.latestWriteId }
	onScanDataListener(callback: (packet: CompatApiPacket) => void): void { this.scanFrameCallback = callback }
	isHavePermision(_pername: string): boolean { return true }
	requestPermison(_pername: string, callback: (granted: boolean) => void): void { callback(true) }
	requesMoretPermison(_pername: string[], callback: (granted: boolean) => void): void { callback(true) }
	isEnabled(): boolean { return this.fleet.adapterReady() }
	onStartScanBle(para: CompatSweepPlan): void { this.onScanBle(para) }
	onScanBle(para: CompatSweepPlan): void { this.fleet.beginSweep({ nameKeyword: para.btNameFilter != null ? para.btNameFilter : null, duration: para.scantime != null ? para.scantime : 10000, includeNameless: para.showEmptyName != 0, onNode: (packet: BlueEnvelope) => { if (para.onScanResult != null) { para.onScanResult(this.normalizeScanNode(packet)) } }, onDone: () => { if (para.scanComplate != null) { para.scanComplate() } } } as BlueSweepPlan) }
	startScanBleDevice(time: number, callback: (packet: CompatApiPacket) => void): void { this.scanBle(time, callback) }
	scanBle(time: number, callback: (packet: CompatApiPacket) => void): void { this.fleet.legacySweep(time, (packet: BlueEnvelope) => { callback(this.normalizeScanNode(packet)) }) }
	stopScanBle(): void { this.fleet.stopSweep() }
	connect(mac: string, auto: boolean, callback: (packet: CompatApiPacket) => void): void { this.latestPeerId = mac; this.fleet.setAttachTimeout(this.latestConnectTimeout); this.fleet.setRetryGap(this.latestAutoGap); this.fleet.attach(mac, auto, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	connectDevices(mac: string, auto: boolean, callback: (packet: CompatApiPacket) => void): void { this.connect(mac, auto, callback) }
	startAutoConnectBt(time: number, callback: (packet: CompatApiPacket) => void): void { this.latestAutoGap = time; this.fleet.setRetryGap(time); if (this.latestPeerId.length > 0) { this.fleet.attach(this.latestPeerId, true, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) } }
	cancelAutoConnectBt(): void { this.fleet.stopRetry() }
	scanServices(callback: (packet: CompatApiPacket) => void): void { this.fleet.pullProfile((packet: BlueEnvelope) => { callback(this.normalizeServices(packet)) }) }
	getUUIDs(): CompatUuidBundle[] { return this.latestBundles }
	setSelectUUID(id: number): void { this.fleet.pickProfile(id); this.syncSelectedIds() }
	listenerBleMessage(_callback: (packet: CompatApiPacket) => void): void {}
	disListenerBleMessage(): void {}
	isConnected(): boolean { return this.fleet.attached() }
	getConnectMac(): string { return this.fleet.currentPeerId() }
	byte2HexString(data: number[]): string { return this.fleet.bytesToHexText(data) }
	writeDataToBle(service: string, chars: string, data: number[], callback: (packet: CompatApiPacket) => void): void { if (!this.fleet.attached()) { callback(buildCompatPacket(10005, 'bluetooth is not connected', '')); return } this.fleet.emitBytes(service, chars, data, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	writeDataToBleWithType(service: string, chars: string, data: number[], writeType: number, callback: (packet: CompatApiPacket) => void): void { if (!this.fleet.attached()) { callback(buildCompatPacket(10005, 'bluetooth is not connected', '')); return } this.fleet.emitBytesWithMode(service, chars, data, writeType, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	writeStringDataToBle(service: string, chars: string, data: string, callback: (packet: CompatApiPacket) => void): void { if (!this.fleet.attached()) { callback(buildCompatPacket(10005, 'bluetooth is not connected', '')); return } this.fleet.emitHex(service, chars, data, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	writeStringDataToBleWithType(service: string, chars: string, data: string, writeType: number, callback: (packet: CompatApiPacket) => void): void { if (!this.fleet.attached()) { callback(buildCompatPacket(10005, 'bluetooth is not connected', '')); return } this.fleet.emitHexWithMode(service, chars, data, writeType, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	sendData(data: CompatWriteTask, callback: (packet: CompatApiPacket) => void): void { if (!this.fleet.attached()) { callback(buildCompatPacket(10005, 'bluetooth is not connected', '')); return } this.fleet.emitPacket({ serviceId: data.serviceId, characteristicId: data.characteristicId, writeMode: data.writeType, bytePayload: data.data != null ? data.data : null, hexPayload: data.hexStrData != null ? data.hexStrData : null, splitPacket: data.fenbao } as BluePacketPlan, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	onNotityReadBleData(service: string, chars: string, state: boolean, callback: (packet: CompatApiPacket) => void): void { this.fleet.pipeValue(service, chars, state, (packet: BlueEnvelope) => { callback(this.normalizeNotifyPacket(packet, state)) }) }
	onNotityReadBleDataMore(service: string, chars: string, state: boolean, callback: (packet: CompatApiPacket) => void): void { this.onNotityReadBleData(service, chars, state, callback) }
	close(): void { this.fleet.closePipe() }
	setMtu(num: number, callback: (packet: CompatApiPacket) => void): void { this.fleet.setTunnelSize(num, (packet: BlueEnvelope) => { callback(this.packetFromBlue(packet)) }) }
	string2ByteStrWithCharset(data: string, code: string): string { return this.fleet.textToHexSeed(data, code).split(' ').join('') }
	byte2StringWithCharset(data: string, code: string): string { return this.fleet.hexSeedToText(data, code) }
	onReadData(service: string, chars: string, callback: (packet: CompatApiPacket) => void): void { this.fleet.readOnce(service, chars, (packet: BlueEnvelope) => { callback(this.normalizeReadPacket(packet)) }) }
	onIndicate(service: string, chars: string, callback: (packet: CompatApiPacket) => void): void { this.onNotityReadBleDataMore(service, chars, true, callback) }
}

export const createAndroidCompatBlue = function (): AndroidCompatBlueApi {
	return new IOSCompatBlueHost() as AndroidCompatBlueApi
}
