import { ref } from "vue";
import { storage } from "../utils";
import { t } from "../locale";
import { useUi } from "@/uni_modules/cool-ui";
import { createBlueFleet } from "@/uni_modules/laoqianjunzi-blue";
import type { BlueSweepPlan, BlueEnvelope } from "@/uni_modules/laoqianjunzi-blue";

export type WearLocation = "大臂部" | "下胸部" | "腰部";

type DeviceInfo = {
	deviceId: string;
	name: string | null;
};

const KEY_WEAR_LOCATION = "device_wear_location";
const KEY_LAST_DEVICE_ID = "last_device_id";

const TARGET_DEVICE_NAME = "BOOM1";

export enum DeviceStatusEnum {
	UNPAIRED = "unpaired",
	PAIRING = "pairing",
	SEARCHING = "searching",
	CONNECTED = "connected"
}

export type DeviceStatus = keyof typeof DeviceStatusEnum;

const ui = useUi();

const HEART_RATE_SERVICE_UUID = "0000180d-0000-1000-8000-00805f9b34fb";
const BLOOD_OXYGEN_SERVICE_UUID = "00001523-1212-efde-1523-785feabcd123";
const BATTERY_SERVICE_UUID = "0000180f-0000-1000-8000-00805f9b34fb";
const UART_SERVICE_UUID = "6e400001-b5a3-f393-e0a9-e50e24dcca9e";
const LED_BUTTON_SERVICE_UUID = "00001523-1212-efde-1523-785feabcd123";
const LED_BUTTON_CHARACTERISTIC_UUID = "00001525-1212-efde-1523-785feabcd123";

const blueFleet = createBlueFleet();

export class Device {
	inited = false;
	status = ref<DeviceStatus>("UNPAIRED");
	devices: DeviceInfo[] = [];
	currentDeviceId = "";
	lastConnectedDeviceId = "";

	currentWearLocation: WearLocation = "大臂部";

	_isCharging = false;

	uartWriteCharacteristicId = "";

	heartRate = ref(0);
	bloodOxygen = ref(0);
	battery = ref(0);
	ppi = ref(0);

	constructor() {
		this.loadSavedData();
	}

	loadSavedData(): void {
		const savedLocation = storage.get(KEY_WEAR_LOCATION) as WearLocation | null;
		if (savedLocation != null) {
			this.currentWearLocation = savedLocation;
		}

		const savedDeviceId = storage.get(KEY_LAST_DEVICE_ID) as string | null;
		if (savedDeviceId != null && savedDeviceId != "") {
			this.lastConnectedDeviceId = savedDeviceId;
		}
	}

	saveWearLocation(location: WearLocation): void {
		this.currentWearLocation = location;
		storage.set(KEY_WEAR_LOCATION, location, 0);
	}

	saveLastConnectedDevice(deviceId: string): void {
		this.lastConnectedDeviceId = deviceId;
		storage.set(KEY_LAST_DEVICE_ID, deviceId, 0);
	}

	setCharging(charging: boolean): void {
		this._isCharging = charging;
	}

	getPaired(): boolean {
		return this.currentDeviceId != "";
	}

	async initBluetooth(): Promise<void> {
		return new Promise<void>((resolve) => {
			blueFleet.watchAdapterSwitch((packet) => {
				console.log("adapterState changed:", packet);
				if (packet.code != 0) {
					ui.showToast({ message: t("蓝牙未开启"), type: "error" });
					this.status.value = "UNPAIRED";
				}
			});

			blueFleet.requestAdapterWake((packet) => {
				console.log("requestAdapterWake:", packet);
				if (packet.code == 0) {
					this.inited = true;
					console.log("初始化蓝牙成功");
					if (this.lastConnectedDeviceId != "") {
						this.startBluetoothSearch();
					}
					resolve();
				} else {
					ui.showToast({ message: t("蓝牙初始化失败"), type: "error" });
					resolve();
				}
			});
		});
	}

	startBluetoothSearch(): void {
		this.devices = [];
		this.stopBluetoothSearch();
		this.status.value = "SEARCHING";

		blueFleet.beginSweep({
			nameKeyword: TARGET_DEVICE_NAME,
			duration: 10000,
			includeNameless: false,
			onNode: (packet: BlueEnvelope) => {
				console.log("scan node:", packet);
				if (packet.code == 0 && packet.payload != null) {
					const payload = packet.payload as UTSJSONObject;
					const peerId = payload["peerId"] as string;
					const alias = payload["alias"] as string | null;

					console.log("发现目标设备:", peerId, alias);

					if (!this.devices.some((d) => d.deviceId == peerId)) {
						this.devices.push({
							deviceId: peerId,
							name: alias
						});
					}

					console.log("当前设备列表:", this.devices);
					console.log("lastConnectedDeviceId:", this.lastConnectedDeviceId);
					this.connectToDevice(peerId);
				}
			},
			onDone: () => {
				console.log("扫描完成");
				if (this.status.value == "SEARCHING") {
					this.status.value = "UNPAIRED";
				}
			}
		} as BlueSweepPlan);
	}

	stopBluetoothSearch(): void {
		blueFleet.stopSweep();
	}

	connectToDevice(deviceId: string): void {
		this.stopBluetoothSearch();
		this.status.value = "PAIRING";

		blueFleet.attach(deviceId, false, (packet) => {
			console.log("attach result:", packet);
			if (packet.code == 0) {
				this.currentDeviceId = deviceId;
				this.status.value = "CONNECTED";
				this.saveLastConnectedDevice(deviceId);
				ui.showToast({ message: t("连接成功"), type: "success" });
				this.getDeviceServicesAndCharacteristics();
			} else {
				ui.showToast({ message: t("连接失败"), type: "error" });
				this.status.value = "UNPAIRED";
			}
		});
	}

	async getDeviceServicesAndCharacteristics(): Promise<void> {
		return new Promise<void>((resolve, reject) => {
			blueFleet.pullProfile((packet) => {
				console.log("pullProfile result:", packet);
				if (packet.code == 0 && packet.payload != null) {
					const payload = packet.payload as UTSJSONObject;
					const servicesData = payload["services"] as UTSJSONObject[];

					if (servicesData != null) {
						console.log("获取设备服务成功:", servicesData);

						servicesData.forEach((service: UTSJSONObject) => {
							const serviceUuid = service["uuid"] as string;

							if (serviceUuid.toLowerCase() == UART_SERVICE_UUID) {
								const chars = service["characteristics"] as UTSJSONObject[];
								chars.forEach((char: UTSJSONObject) => {
									const flags = char["flags"] as UTSJSONObject;
									if (flags != null && (flags["canWrite"] as boolean)) {
										this.uartWriteCharacteristicId = char["uuid"] as string;
										console.log(
											"保存 UART 可写特征值:",
											this.uartWriteCharacteristicId
										);
									}
								});
							}

							const chars = service["characteristics"] as UTSJSONObject[];
							chars.forEach((char: UTSJSONObject) => {
								const flags = char["flags"] as UTSJSONObject;
								if (
									flags != null &&
									((flags["canNotify"] as boolean) ||
										(flags["canIndicate"] as boolean))
								) {
									this.enableNotify(serviceUuid, char["uuid"] as string);
								}
							});

							if (serviceUuid.toLowerCase() == LED_BUTTON_SERVICE_UUID) {
								this.readCharacteristic(
									serviceUuid,
									LED_BUTTON_CHARACTERISTIC_UUID
								).then(() => {
									setTimeout(() => {
										console.log("写入开启命令 0x01");
										this.writeCharacteristic(
											serviceUuid,
											LED_BUTTON_CHARACTERISTIC_UUID,
											[1],
											"write"
										);
									}, 500);
								});
							}
						});

						this.onCharacteristicValueChange();
						resolve();
					} else {
						reject(new Error("服务数据为空"));
					}
				} else {
					reject(new Error("获取服务失败: " + packet.detail));
				}
			});
		});
	}

	onCharacteristicValueChange(): void {
		blueFleet.pullProfile((packet) => {
			if (packet.code == 0 && packet.payload != null) {
				const payload = packet.payload as UTSJSONObject;
				const bytes = payload["bytes"] as number[];
				if (bytes != null && bytes.length > 0) {
					const hexString = this.bytesToHexString(bytes);
					const serviceUuid = blueFleet.activeServiceId().toLowerCase();
					this.handleCharacteristicNotify(serviceUuid, "", hexString);
				}
			}
		});
	}

	handleCharacteristicNotify(serviceId: string, characteristicId: string, hexData: string): void {
		console.log("特征值变化: 服务=" + serviceId + ", 数据=" + hexData);

		if (serviceId == HEART_RATE_SERVICE_UUID) {
			const result = this.parseHeartRateData(hexData);
			this.heartRate.value = result[0];
			this.ppi.value = result[1];
			console.log("心率: " + this.heartRate.value + " BPM, PPI: " + this.ppi.value);
		} else if (serviceId == BLOOD_OXYGEN_SERVICE_UUID) {
			this.bloodOxygen.value = this.parseBloodOxygenData(hexData);
			console.log("血氧: " + this.bloodOxygen.value + "%");
		} else if (serviceId == BATTERY_SERVICE_UUID) {
			this.battery.value = this.parseBatteryData(hexData);
			console.log("电池: " + this.battery.value + "%");
		}
	}

	bytesToHexString(bytes: number[]): string {
		let hexStr = "";
		for (let i = 0; i < bytes.length; i++) {
			const bit = bytes[i];
			hexStr += ("00" + bit.toString(16)).slice(-2);
		}
		return hexStr;
	}

	parseHeartRateData(hexData: string): number[] {
		const hexStr = hexData.replace(/\s/g, "").toUpperCase();
		if (hexStr.length < 4) {
			return [0, 0];
		}

		const bytes: number[] = [];
		for (let i = 0; i < hexStr.length; i += 2) {
			bytes.push(parseInt(hexStr.substring(i, i + 2), 16));
		}

		const heartRate = bytes[1];
		const ppi = bytes[2] + (bytes[3] << 8);

		return [heartRate, ppi];
	}

	parseBloodOxygenData(hexData: string): number {
		const hexStr = hexData.replace(/\s/g, "").toUpperCase();
		if (hexStr.length < 2) {
			return 0;
		}

		return parseInt(hexStr.substring(0, 2), 16);
	}

	parseBatteryData(hexData: string): number {
		const hexStr = hexData.replace(/\s/g, "").toUpperCase();
		if (hexStr.length < 2) {
			return 0;
		}

		return parseInt(hexStr.substring(0, 2), 16);
	}

	enableNotify(serviceId: string, characteristicId: string): Promise<boolean> {
		return new Promise<boolean>((resolve) => {
			blueFleet.pipeValue(serviceId, characteristicId, true, (packet): void => {
				console.log("enableNotify result:", packet);
				if (packet.code == 0) {
					resolve(true);
				} else {
					resolve(false);
				}
			});
		});
	}

	disableNotify(serviceId: string, characteristicId: string): void {
		blueFleet.pipeValue(serviceId, characteristicId, false, (packet): void => {
			console.log("disableNotify:", packet);
		});
	}

	readCharacteristic(serviceId: string, characteristicId: string): Promise<boolean> {
		return new Promise<boolean>((resolve, reject) => {
			blueFleet.readOnce(serviceId, characteristicId, (packet): void => {
				console.log("readCharacteristic result:", packet);
				if (packet.code == 0) {
					resolve(true);
				} else {
					reject(new Error(packet.detail));
				}
			});
		});
	}

	writeCharacteristic(
		serviceId: string,
		characteristicId: string,
		value: number | number[],
		writeType: "write" | "writeNoResponse" = "write"
	): Promise<boolean> {
		return new Promise<boolean>((resolve, reject) => {
			let data: number[];

			if (Array.isArray(value)) {
				data = value;
			} else {
				data = [value];
			}

			console.log("写入特征值:", value, data, "writeType:", writeType);

			const mode = writeType == "writeNoResponse" ? 0 : 1;

			blueFleet.emitBytesWithMode(serviceId, characteristicId, data, mode, (packet): void => {
				console.log("writeCharacteristic result:", packet);
				if (packet.code == 0) {
					resolve(true);
				} else {
					reject(new Error(packet.detail));
				}
			});
		});
	}

	sendCommand(command: number | number[]): Promise<boolean> {
		if (this.uartWriteCharacteristicId == "") {
			console.error("UART 特征值未设置");
			return Promise.resolve(false);
		}

		return this.writeCharacteristic(UART_SERVICE_UUID, this.uartWriteCharacteristicId, command);
	}

	disconnectDevice(): void {
		if (this.currentDeviceId != "") {
			blueFleet.closePipe();
			this.status.value = "UNPAIRED";
			this.currentDeviceId = "";
			ui.showToast({ message: t("已断开连接"), type: "warn" });
		} else {
			this.status.value = "UNPAIRED";
			ui.showToast({ message: t("已断开连接"), type: "warn" });
		}
	}

	destroy(): void {
		this.stopBluetoothSearch();
		if (this.currentDeviceId != "") {
			blueFleet.closePipe();
		}
	}

	clearLastConnectedDevice(): void {
		this.lastConnectedDeviceId = "";
		storage.remove(KEY_LAST_DEVICE_ID);
	}

	clear(): void {}
}

export const device = new Device();
